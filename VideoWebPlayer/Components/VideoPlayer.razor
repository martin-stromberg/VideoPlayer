@using Microsoft.JSInterop

@inject IJSRuntime JS

@* Wiederverwendbarer Video-Player mit Overlay *@
@if (Show)
{
    <div class="player-overlay">
        <div class="player-content">
            <video @ref="_videoRef"
                   src="@StreamUrl"
                   controls
                   autoplay="@AutoPlay"
                   style="max-width:900px;"></video>
            <button class="close-player" @onclick="OnClose">&#10006;</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string StreamUrl { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    // Neu:
    [Parameter] public string MediaType { get; set; } = ""; // "movie" | "episode"
    [Parameter] public long MediaId { get; set; }
    [Parameter] public string? AuthToken { get; set; } // Bearer-Token
    [Parameter] public double? StartPositionSeconds { get; set; }  // Startposition
    [Parameter] public bool AutoPlay { get; set; } = true;

    // Neues Event (optional für Parent)
    [Parameter] public EventCallback<double> PositionChanged { get; set; }

    // Öffentliche auslesbare Eigenschaft (gecachte aktuelle Position)
    public double CurrentPositionSeconds { get; private set; }

    private ElementReference _videoRef;
    private bool _attached;
    private bool _startApplied;
    private DotNetObjectReference<VideoPlayer>? _dotNetRef;
    private bool _timeUpdateRegistered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && !_attached && _videoRef.Context != null && !string.IsNullOrWhiteSpace(MediaType) && MediaId > 0)
        {
            await JS.InvokeVoidAsync("continueWatching.attach", _videoRef, MediaType, MediaId, "", AuthToken ?? "");
            _attached = true;
        }

        if (Show && !_timeUpdateRegistered && _videoRef.Context != null)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("videoPlayer.registerTimeUpdate", _videoRef, _dotNetRef);
            _timeUpdateRegistered = true;
        }

        if (Show && !_startApplied && StartPositionSeconds.HasValue && StartPositionSeconds > 0 && _videoRef.Context != null)
        {
            await JS.InvokeVoidAsync("videoPlayer.setStartPosition", _videoRef, StartPositionSeconds.Value);
            _startApplied = true;
        }

        if (!Show)
            await CleanupAsync();
    }

    private async Task CleanupAsync()
    {
        if (_timeUpdateRegistered && _videoRef.Context != null)
        {
            try { await JS.InvokeVoidAsync("videoPlayer.unregisterTimeUpdate", _videoRef); } catch { }
        }
        _timeUpdateRegistered = false;
        _attached = false;
        _startApplied = false;
        CurrentPositionSeconds = 0;
    }

    [JSInvokable]
    public async Task UpdatePosition(double seconds)
    {
        // Minimieren unnötiger Renders
        if (Math.Abs(CurrentPositionSeconds - seconds) >= 0.25)
        {
            CurrentPositionSeconds = seconds;
            if (PositionChanged.HasDelegate)
                await PositionChanged.InvokeAsync(seconds);
            // Kein StateHasChanged() nötig, außer UI zeigt Wert an.
        }
    }

    // Optional: direkter Abruf (falls Parent aktiv pullen will)
    public async ValueTask<double> GetCurrentPositionSecondsAsync()
    {
        if (_videoRef.Context == null) return CurrentPositionSeconds;
        try
        {
            var v = await JS.InvokeAsync<double>("videoPlayer.getCurrentPosition", _videoRef);
            CurrentPositionSeconds = v;
            return v;
        }
        catch { return CurrentPositionSeconds; }
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupAsync();
        _dotNetRef?.Dispose();
    }
}
<script>
window.videoPlayer = window.videoPlayer || {
    setStartPosition: function (videoEl, seconds) {
        if (!videoEl || !seconds || seconds <= 0) return;
        const apply = () => {
            try {
                if (videoEl.duration && seconds > videoEl.duration - 1)
                    seconds = Math.max(0, videoEl.duration - 1);
                videoEl.currentTime = seconds;
                if (videoEl.paused) {
                    const p = videoEl.play();
                    if (p && p.catch) p.catch(() => {});
                }
            } catch {}
        };
        if (videoEl.readyState >= 1) {
            apply();
        } else {
            const handler = () => {
                videoEl.removeEventListener('loadedmetadata', handler);
                apply();
            };
            videoEl.addEventListener('loadedmetadata', handler);
        }
    },
    registerTimeUpdate: function(videoEl, dotNetRef) {
        if (!videoEl || !dotNetRef) return;
        const handler = () => {
            try {
                dotNetRef.invokeMethodAsync('UpdatePosition', videoEl.currentTime || 0);
            } catch {}
        };
        videoEl._timeUpdateHandler = handler;
        videoEl.addEventListener('timeupdate', handler);
    },
    unregisterTimeUpdate: function(videoEl) {
        if (videoEl && videoEl._timeUpdateHandler) {
            videoEl.removeEventListener('timeupdate', videoEl._timeUpdateHandler);
            delete videoEl._timeUpdateHandler;
        }
    },
    getCurrentPosition: function(videoEl) {
        if (!videoEl) return 0;
        return videoEl.currentTime || 0;
    }
};
</script>