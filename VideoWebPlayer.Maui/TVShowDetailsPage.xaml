<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             xmlns:components="clr-namespace:VideoWebPlayer.Maui.Components"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VideoWebPlayer.Maui.TVShowDetailsPage"
             x:DataType="viewmodels:TVShowDetailsViewModel"
             BackgroundColor="#000000">
    <Grid BackgroundColor="#181820" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="47" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Source="background_header_left.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="1" Source="background_header_middle.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="2" Source="background_header_right.png" Aspect="Fill" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="28" FontAttributes="Bold" TextColor="#FFDDAA" Padding="20,20,20,15" FontFamily="OpenSansSemibold">
            <Label.Shadow>
                <Shadow Brush="#000000" Offset="5,5" Radius="6" />
            </Label.Shadow>
        </Label>
        <Image Grid.Row="1" Grid.Column="0" Source="background_content_left.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.Column="1" Source="background_content_middle.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.Column="2" Source="background_content_right.png" Aspect="Fill" />
        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Spacing="20" Padding="20,10,20,20">
                <!-- MediaBannerPlayer Component -->
                <components:MediaBannerPlayer />
                
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="{Binding ReleaseYear}" FontSize="14" TextColor="#333333" FontAttributes="Bold" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="|" FontSize="14" TextColor="#333333" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding GenreNames}" FontSize="14" TextColor="#333333" FontAttributes="Bold" />
                    <Label Text="|" FontSize="14" TextColor="#333333" IsVisible="{Binding SelectedEpisodeName, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding SelectedEpisodeName}" FontSize="14" TextColor="#333333" FontAttributes="Bold" IsVisible="{Binding SelectedEpisodeName, Converter={StaticResource IsNotNullConverter}}" />
                </StackLayout>
                <Label Text="{Binding Plot}" FontSize="14" TextColor="#555555" LineBreakMode="WordWrap" />
                <Picker Title="Staffel wählen" ItemsSource="{Binding Seasons}" ItemDisplayBinding="{Binding Name}" SelectedIndex="{Binding SelectedSeasonIndex}" TitleColor="#000000" TextColor="#FFDDAA" BackgroundColor="#23232a" />
                <CollectionView ItemsSource="{Binding Episodes}" 
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedEpisode}"
                                SelectionChanged="OnEpisodeSelectionChanged">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TVShowEpisodeViewModel">
                            <Border StrokeThickness="0" BackgroundColor="#23232a" Padding="10" Margin="0,0,0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="80" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#FFDDAA" />
                                        <Label Text="{Binding Plot}" FontSize="12" TextColor="#CCCCCC" LineBreakMode="WordWrap" MaxLines="3" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Download Button -->
                                    <Border Grid.Column="2" 
                                            BackgroundColor="#4CAF50"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDownloadEpisodeTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="⬇"
                                               FontSize="24"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Image Grid.Row="2" Grid.Column="0" Source="background_footer_left.png" Aspect="Fill" />
        <Image Grid.Row="2" Grid.Column="1" Source="background_footer_middle.png" Aspect="Fill" />
        <Image Grid.Row="2" Grid.Column="2" Source="background_footer_right.png" Aspect="Fill" />
        
        <!-- NotificationTicker -->
        <components:NotificationTicker Grid.Row="2" Grid.Column="1" 
                                       Margin="20,0" />
    </Grid>
</ContentPage>
