<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.Service.Device"
             x:DataType="vm:MemoryInformation"
             x:Class="VideoPlayer.Views.Common.MemoryInfoView">
    <Frame BindingContext="{Binding Info}" x:DataType="vm:MemoryInfo">
        <Label 
            Text="{Binding TotalMemory}"
            VerticalOptions="End" 
            HorizontalOptions="End" />
    </Frame>
</ContentView>
