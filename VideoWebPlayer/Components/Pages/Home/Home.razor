@page "/"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Components.Account.Pages.Shared
@using VideoWebPlayer.Data
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject RecentEntryService RecentEntryService
@inject ApplicationDbContext DbContext
@inject HttpClient Http

<PageTitle>Home</PageTitle>

@code {
    private bool? isAuthenticated = null;
    private List<DtoRecentEntry> recentEntries = new();
    private List<FavoriteEntry> favorites = new();

    // Für die Anzeige: Titel, Bild und Link
    private Dictionary<long, string> movieTitles = new();
    private Dictionary<long, string> moviePosters = new();
    private Dictionary<long, string> movieLinks = new();
    private Dictionary<long, string> collectionTitles = new();
    private Dictionary<long, string> collectionPosters = new();
    private Dictionary<long, string> collectionLinks = new();
    private Dictionary<long, string> showTitles = new();
    private Dictionary<long, string> showBanners = new();
    private Dictionary<long, string> showLinks = new();
    private Dictionary<long, string> seasonTitles = new();
    private Dictionary<long, string> seasonBanners = new();
    private Dictionary<long, string> seasonLinks = new();
    private Dictionary<long, string> episodeTitles = new();
    private Dictionary<long, string> episodePosters = new();
    private Dictionary<long, string> episodeLinks = new();

    private const string SystemUserNormalizedName = "SYSTEM";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user?.Identity?.IsAuthenticated == true;

        if (isAuthenticated != true)
        {
            var anyUser = await DbContext.Users.AnyAsync(u => u.NormalizedUserName != SystemUserNormalizedName);
            if (!anyUser)
            {
                var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (string.IsNullOrEmpty(returnUrl))
                    returnUrl = "/";
                Navigation.NavigateTo($"Account/Register?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            }
        }
    }
}

@if (isAuthenticated == false)
{
    <LoginForm/>
}

@if (isAuthenticated == true)
{
    <div class="home-shell">
        <section class="home-hero" aria-labelledby="home-title">
            <div class="home-hero-content">
                <span class="hero-kicker">Private Media Library</span>
                <h1 id="home-title">Martins Videosammlung</h1>
                <p>Filme, Serien, Favoriten und angefangene Wiedergaben in einer dunklen, medienzentrierten Oberfläche.</p>
            </div>
        </section>

        <ContinueWatchingList />

        <FavoritesList />

        <SeasonalGenreList />

        <RecentEntriesList />
    </div>
}
