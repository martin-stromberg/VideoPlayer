@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@inject ApplicationDbContext DbContext
@inject IGenreService GenreService
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject AuthenticationStateProvider AuthStateProvider;

<div>
    @if (activeGenres.Any())
    {
        @foreach (var genre in activeGenres)
        {
            var entries = new List<MediaBaseEntry>();
            if (mediaEntriesByGenre.TryGetValue(genre.Id, out var list))
                entries = list;

            if (entries.Any())
            {
                <section class="media-section" aria-labelledby="@($"genre-{genre.Id}")">
                    <h3 id="@($"genre-{genre.Id}")">@genre.Name</h3>
                    <MediaBaseEntryList Entries="entries" AuthorizationToken="@authToken" />
                </section>
            }
        }
    }
</div>

@code {
    private string? userId;
    private string? authToken;
    private List<Genre> activeGenres = new();
    private Dictionary<long, List<MediaBaseEntry>> mediaEntriesByGenre = new();

    protected override async Task OnInitializedAsync()
    {
        activeGenres = await GenreService.GetSeasonalGenresAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        authToken = Client.AuthorizationToken;

        // Für jedes Genre die zugehörigen Filme und Serien laden
        foreach (var genre in activeGenres)
        {
            var entries = new List<MediaBaseEntry>();

            // Filme laden
            var movieIds = await DbContext.MovieGenres
                .Where(mg => mg.GenreId == genre.Id)
                .Select(mg => mg.MovieId)
                .ToListAsync();

            var movies = await DbContext.Movies
                .Where(m => movieIds.Contains(m.Id) &&
                            DbContext.MediaSourceUsers.Any(msu => msu.MediaSourceId == m.MediaSourceId && msu.UserId == userId))
                .Include(m => m.MovieCollection)
                .ToListAsync();

            // Sammlungen nur einmal aufnehmen
            var collectionIds = movies
                .Where(m => m.MovieCollectionId != null)
                .Select(m => m.MovieCollectionId.Value)
                .Distinct()
                .ToList();

            var collections = await DbContext.MovieCollections.Include(c => c.Movies)
                .Where(mc => collectionIds.Contains(mc.Id) &&
                             DbContext.MediaSourceUsers.Any(msu => msu.MediaSourceId == mc.MediaSourceId && msu.UserId == userId))
                .ToListAsync();

            entries.AddRange(collections.Select(c =>
            {
                if (c.Movies.Count == 1)
                    return c.Movies.First() as MediaBaseEntry;
                return c;
            }));

            // Einzelne Filme ohne Sammlung
            var singleMovies = movies
                .Where(m => m.MovieCollectionId == null)
                .ToList();

            entries.AddRange(singleMovies);

            // Serien wie gehabt
            var showIds = await DbContext.TVShowGenres
                .Where(tg => tg.GenreId == genre.Id)
                .Select(tg => tg.TVShowId)
                .ToListAsync();

            var shows = await DbContext.TVShows
                .Where(s => showIds.Contains(s.Id) &&
                            DbContext.MediaSourceUsers.Any(msu => msu.MediaSourceId == s.MediaSourceId && msu.UserId == userId))
                .ToListAsync();

            entries.AddRange(shows);

            mediaEntriesByGenre[genre.Id] = entries
                .OrderByDescending(e => e.EndedAt)
                .ThenByDescending(e => e.ReleaseDate)
                .ThenByDescending(e => e.PremieredAt)
                .ThenByDescending(e => e.CreatedAt)
                .ThenBy(e => e.Name)
                .ToList();
        }
    }
}
