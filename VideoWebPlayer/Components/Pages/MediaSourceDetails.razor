@page "/mediasource/{Id:long}"
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Controllers.Models
@using VideoWebPlayer.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@rendermode InteractiveServer

<style>
    .search-bar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.2rem;
        align-items: center;
    }
    .search-bar input[type="text"] {
        flex: 1 1 auto;
        min-width: 0;
    }
    .search-bar button {
        flex: 0 0 auto;
    }
    .genre-scrollbar {
        display: flex;
        flex-direction: row;
        gap: 0.7rem;
        overflow-x: auto;
        padding: 0.5rem 0 1.2rem 0;
        margin-bottom: 0.5rem;
        scrollbar-width: thin;
        scrollbar-color: #23232a #181820;
    }
    .genre-scrollbar::-webkit-scrollbar {
        height: 8px;
        background: #181820;
    }
    .genre-scrollbar::-webkit-scrollbar-thumb {
        background: #23232a;
        border-radius: 4px;
    }
    .genre-btn {
        background: #23232a;
        color: #ffe066;
        border: none;
        border-radius: 18px;
        padding: 0.5rem 1.2rem;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
        white-space: nowrap;
    }
    .genre-btn.selected, .genre-btn:hover {
        background: #ffe066;
        color: #23232a;
        font-weight: bold;
    }
</style>

<script>
    window.saveScrollPosition = function (selector) {
        var el = document.querySelector(selector);
        if (el) {
            sessionStorage.setItem("scrollPos_" + selector, el.scrollLeft);
        }
    };

    window.restoreScrollPosition = function (selector) {
        var el = document.querySelector(selector);
        var pos = sessionStorage.getItem("scrollPos_" + selector);
        if (el && pos) {
            el.scrollLeft = parseInt(pos, 10);
        }
    };

    window.setSelectedMediaItem = function(mediaItemid) {
        sessionStorage.setItem("selectedMediaItem", mediaItemid);
    }

    window.getSelectedMediaItem = function() {
        var id = sessionStorage.getItem("selectedMediaItem");
        return id ? id : "";
    }
</script>

@code {
    [Parameter]
    public long Id { get; set; }

    private DtoMediaSource? mediaSource;
    private bool isLoading = true;
    private List<MediaEntryDto> Entries = new();
    private int Page = 0;
    private const int PageSize = 30;
    private ElementReference BottomMarker;
    private bool? isAuthenticated = null;
    private string searchText = "";
    private SourceGenresDto sourceGenres = new();
    private long? selectedGenreId = null;

    [JSInvokable]
    public async Task OnBottomVisible()
    {
        if (!isLoading && isAuthenticated == true)
            await LoadNextPageAsync();
    }

    private async Task LoadNextPageAsync()
    {
        if (isLoading) return;
        isLoading = true;        
        var newEntries = await Client.RequestSourceItems(Id, Page, PageSize, searchText, selectedGenreId.HasValue ? selectedGenreId.Value : 0);
        if (newEntries?.Any() == true)
        {
            Entries.AddRange(newEntries);
            Page++;
        }
        isLoading = false;

        if (!int.TryParse(await JS.InvokeAsync<string>("getSelectedMediaItem"), out var selectedId))
            selectedId = 0;

        if (selectedId != 0 && !newEntries.Any(e => e.Id == selectedId))
            await LoadNextPageAsync();
        else
        {
            await JS.InvokeVoidAsync("setSelectedMediaItem", "0");
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user?.Identity?.IsAuthenticated == true;

        mediaSource = await Client.RequestSourceAsync(Id);
        sourceGenres = await Client.RequestSourceGenresAsync(mediaSource.Id);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isAuthenticated == true)
        {
            try
            {
                while (isLoading)
                    await Task.Delay(10);
                await LoadNextPageAsync();
                await JS.InvokeVoidAsync("observeBottom", BottomMarker, DotNetObjectReference.Create(this));
            }
            catch(Exception ex)
            {
                Console.WriteLine($"Fehler beim Initialisieren des JavaScript-Observers: {ex.Message}");
            }
        }

        // Scrollposition der Medienliste wiederherstellen
        await JS.InvokeVoidAsync("restoreScrollPosition", ".media-grid");
    }

    private string GetPosterUrl(MediaEntryDto entry)
        => entry.PictureId.HasValue
            ? $"/api/pictures/{entry.PictureId}?access_token={Client.AuthorizationToken}"
            : "/images/placeholder.png";

    private async Task OnMovieSelected(MediaEntryDto movie)
    {
        // Scrollposition speichern
        await JS.InvokeVoidAsync("setSelectedMediaItem", movie.Id.ToString());
        await JS.InvokeVoidAsync("saveScrollPosition", ".media-grid");
        if (!string.IsNullOrEmpty(movie.Url))
            Navigation.NavigateTo(movie.Url);
    }

    private async Task SearchEntries()
    {
        Page = 0;
        Entries.Clear();
        await LoadNextPageAsync();
        await JS.InvokeVoidAsync("observeBottom", BottomMarker, DotNetObjectReference.Create(this));
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchEntries();
        }
    }

    private async Task OnGenreSelected(long? genreId)
    {
        selectedGenreId = genreId;
        Page = 0;
        Entries.Clear();
        await LoadNextPageAsync();
        await JS.InvokeVoidAsync("observeBottom", BottomMarker, DotNetObjectReference.Create(this));
    }
}

@if (isLoading)
{
    <p>Lade Daten...</p>
}
else if (isAuthenticated != true)
{
    <PageTitle>Zugriff verweigert</PageTitle>
    <div class="alert alert-warning">Bitte melden Sie sich an, um die Inhalte zu sehen.</div>
}
else if (mediaSource == null)
{
    <PageTitle>Unbekannte Quelle</PageTitle>
    <div class="alert alert-danger">Quelle nicht gefunden.</div>
}
else
{
    <PageTitle>@mediaSource.Name</PageTitle>    

    <div class="search-bar">
        <input type="text"
               class="form-control"
               placeholder="Suche..."
               @bind="searchText"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown" />
        <button class="btn btn-primary" @onclick="SearchEntries">Suchen</button>
    </div>

    <div class="genre-scrollbar">
        <button class="genre-btn @(selectedGenreId == null ? "selected" : "")"
                @onclick="() => OnGenreSelected(null)">
            Alle
        </button>
        @foreach (var genre in sourceGenres.Genres)
        {
            <button class="genre-btn @(selectedGenreId == genre.Id ? "selected" : "")"
                    @onclick="() => OnGenreSelected(genre.Id)">
                @genre.Name
            </button>
        }
    </div>

    <div class="media-grid">
        @foreach (var entry in Entries)
        {
            <a class="media-box-link" href="@entry.Url">
                <div class="media-box" @onclick="async () => await OnMovieSelected(entry)">
                    @if (entry.ItemCount > 1)
                    {
                        <span class="collection-indicator" title="Enthält mehrere Filme">
                            ⧉
                        </span>
                    }
                    <img class="media-poster"
                         src="@GetPosterUrl(entry)"
                         alt="@entry.Title"
                         onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                    <div class="media-title">
                        @entry.Title
                    </div>
                </div>
            </a>
        }
        <div @ref="BottomMarker"></div>
    </div>
}

