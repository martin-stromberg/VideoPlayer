@using VideoWebPlayer.Client.Models
@rendermode InteractiveServer
@implements IDisposable
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject AuthenticationStateProvider AuthStateProvider
@inject TimeProvider Clock
@inject ILogger<SeasonalGenreList> Logger

<div>
    @foreach (var genre in sections)
    {
        <section class="media-section" aria-labelledby="@($"genre-{genre.GenreId}")" @key="genre.GenreId">
            <h3 id="@($"genre-{genre.GenreId}")">@genre.Name</h3>
            <div class="seasonal-genre-list">
                @foreach (var entry in genre.Entries)
                {
                    <MediaBox Title="@entry.Name" ImageUrl="@GetImageUrl(entry)"
                              LinkUrl="@GetLinkUrl(entry)" WatchedAt="@entry.WatchedAt" />
                }
            </div>
        </section>
    }
</div>

@code {
    private List<DtoSeasonalGenre> sections = [];
    private string? authToken;
    private ITimer? expiryTimer;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenAsync(authState.User);
        try
        {
            sections = await Client.GetSeasonalGenresAsync();
            authToken = Client.AuthorizationToken;
            RemoveExpiredAndSchedule();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Could not load seasonal home sections.");
        }
    }

    private void RemoveExpiredAndSchedule()
    {
        expiryTimer?.Dispose();
        expiryTimer = null;
        var now = Clock.GetUtcNow().UtcDateTime;
        sections.RemoveAll(x => x.ExpiresAt <= now || x.Entries.Count == 0);
        if (!disposed && sections.Count > 0)
        {
            var delay = sections.Min(x => x.ExpiresAt) - now;
            // System timers support at most about 49 days; longer seasons are rechecked daily.
            if (delay > TimeSpan.FromDays(1)) delay = TimeSpan.FromDays(1);
            expiryTimer = Clock.CreateTimer(_ => _ = ExpireAsync(), null, delay, Timeout.InfiniteTimeSpan);
        }
    }

    private async Task ExpireAsync()
    {
        if (disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (disposed) return;
                RemoveExpiredAndSchedule();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (disposed) { }
    }

    private string GetImageUrl(DtoMediaEntry entry)
    {
        var picture = entry.PosterPictureId ?? entry.BannerPictureId ?? entry.FanartPictureId;
        return picture.HasValue ? $"/api/pictures/{picture}?access_token={authToken}" : "/images/placeholder.png";
    }

    private static string GetLinkUrl(DtoMediaEntry entry) => entry switch
    {
        DtoMovie => $"/movie/{entry.Id}",
        DtoMovieCollection => $"/moviecollection/{entry.Id}",
        DtoTVShow => $"/tvshow/{entry.Id}",
        _ => throw new InvalidOperationException("Unsupported seasonal media type.")
    };

    public void Dispose()
    {
        disposed = true;
        expiryTimer?.Dispose();
    }
}
