@page "/Play"
@using Microsoft.AspNetCore.Authorization
@using WebPlayerApi.Models
@attribute [Authorize]
@inject NavigationManager Navigation
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string ParentId { get; set; }
    private HttpClient? Http;

    private string Title = "🎬 Video Player";

    private string VideoUrl => $"{Http?.BaseAddress}api/MediaItems/stream/{Uri.EscapeDataString(Id)}";
    private string GetDownloadUrl(string childId, string parentId) => $"{Http.BaseAddress}api/MediaItems/download/{Uri.EscapeDataString(childId)}";

    protected override void OnInitialized()
    {
        Http = HttpClientFactory.CreateClient("My.ServerAPI");
    }
    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetFromJsonAsync<MediaItemDetailsDto>($"/api/MediaItems/details/{Id}");
        var mediaItem = response?.Children?.FirstOrDefault(i => i.Id == Id);
        Title = $"🎬 {mediaItem?.Title ?? "Video Player"}";
        await base.OnInitializedAsync();
    }
}
<h3>@Title</h3>
<div>
<a class="download-button" href="@GetDownloadUrl(Id, ParentId)">💾 Download</a>
</div>

@if (!string.IsNullOrEmpty(Id))
{
    <video id="videoPlayer" controls width="100%" style="max-width: 800px;">
        <source src="@VideoUrl" type="video/mp4" />
        Dein Browser unterstützt das Video-Tag nicht.
    </video>
}
else
{
    <p>Fehlende Parameter. Bitte wähle ein Video aus der Übersicht.</p>
}