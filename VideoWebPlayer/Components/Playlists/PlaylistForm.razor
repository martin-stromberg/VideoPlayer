@using Microsoft.AspNetCore.Components.Forms
@using VideoWebPlayer.Client.Models
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client

<div class="admin-dialog-overlay" @onclick="Cancel">
    <div class="admin-dialog" @onclick:stopPropagation>
        <header class="admin-card-header">
            <h2>@(PlaylistId.HasValue ? "Playlist bearbeiten" : "Neue Playlist")</h2>
            <button class="btn btn-sm btn-outline-light" @onclick="Cancel">Schliessen</button>
        </header>

        @if (isLoading)
        {
            <p>Lade Daten...</p>
        }
        else
        {
            <EditForm Model="playlist" OnValidSubmit="SaveAsync">
                <div class="mb-3">
                    <label class="form-label" for="playlist-name-input">Playlist-Name</label>
                    <InputText id="playlist-name-input" class="form-control" @bind-Value="playlist.Name" />
                    @if (!string.IsNullOrWhiteSpace(nameError))
                    {
                        <div class="form-text text-warning">@nameError</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label" for="playlist-description-input">Beschreibung</label>
                    <InputTextArea id="playlist-description-input" class="form-control" @bind-Value="playlist.Description" />
                    @if (!string.IsNullOrWhiteSpace(descriptionError))
                    {
                        <div class="form-text text-warning">@descriptionError</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label" for="playlist-sortmode-select">Sortierung</label>
                    <InputSelect id="playlist-sortmode-select" class="form-control" @bind-Value="playlist.SortMode">
                        <option value="@PlaylistSortModeValues.ByReleaseDate">Nach Erscheinungsdatum</option>
                        <option value="@PlaylistSortModeValues.Manual">Manuell</option>
                    </InputSelect>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" id="playlist-form-error">@errorMessage</div>
                }

                <div class="admin-actions">
                    <button type="submit" class="btn btn-primary" id="playlist-save-button" disabled="@isSaving">Speichern</button>
                    <button type="button" class="btn btn-ghost" @onclick="Cancel">Abbrechen</button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public long? PlaylistId { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private DtoPlaylist playlist = new() { SortMode = PlaylistSortModeValues.ByReleaseDate };
    private bool isLoading;
    private bool isSaving;
    private string? nameError;
    private string? descriptionError;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (PlaylistId.HasValue)
        {
            isLoading = true;
            try
            {
                var loaded = await Client.RequestPlaylistAsync(PlaylistId.Value);
                if (loaded is not null)
                    playlist = loaded;
                else
                    errorMessage = "Playlist konnte nicht geladen werden.";
            }
            catch (Exception)
            {
                errorMessage = "Playlist konnte nicht geladen werden.";
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private bool Validate()
    {
        nameError = null;
        descriptionError = null;

        if (string.IsNullOrWhiteSpace(playlist.Name))
            nameError = "Playlist-Name ist erforderlich.";
        else if (playlist.Name.Length > 255)
            nameError = "Name darf maximal 255 Zeichen lang sein.";

        if (playlist.Description?.Length > 2000)
            descriptionError = "Beschreibung darf maximal 2000 Zeichen lang sein.";

        return nameError is null && descriptionError is null;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        if (!Validate())
            return;

        isSaving = true;
        try
        {
            if (PlaylistId.HasValue)
            {
                await Client.UpdatePlaylistAsync(PlaylistId.Value, new DtoUpdatePlaylistRequest
                {
                    Name = playlist.Name,
                    Description = playlist.Description,
                    SortMode = playlist.SortMode
                });
            }
            else
            {
                await Client.CreatePlaylistAsync(new DtoCreatePlaylistRequest
                {
                    Name = playlist.Name,
                    Description = playlist.Description,
                    SortMode = playlist.SortMode
                });
            }

            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("existiert bereits", StringComparison.OrdinalIgnoreCase)
                ? "Ein Playlist mit diesem Namen existiert bereits."
                : "Beim Speichern ist ein Fehler aufgetreten.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
