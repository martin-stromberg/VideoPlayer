@page "/admin/program-settings"
@using System.ComponentModel.DataAnnotations
@using VideoWebPlayer.Services
@inject ProgramSettingsService SettingsService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Allgemein</PageTitle>

@if (!isAdmin)
{
    <div class="alert alert-danger">Nicht autorisiert.</div>
}
else if (model is null)
{
    <div class="alert alert-info">Lade…</div>
}
else
{
    <section class="admin-console admin-form-page">
        <header class="admin-page-header">
            <div>
                <span class="admin-kicker">Einrichtung</span>
                <h1>Allgemein</h1>
                <p>Anwendungstitel und Scan-Verhalten konfigurieren.</p>
            </div>
            <a class="btn btn-outline-light" href="/admin">Zurueck</a>
        </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="admin-card admin-card-wide">
                <h2>Anwendung</h2>
                <div class="mb-3">
                    <label class="form-label">Anwendungstitel</label>
                    <InputText class="form-control" @bind-Value="model.ApplicationTitle" />
                    <div class="form-text">Dieser Titel erscheint in der Navigation und auf der Startseite.</div>
                </div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>Scan-Einstellungen</h2>
                <div class="admin-settings-grid">
                    <div>
                        <label class="form-label">Scanprozess-Intervall</label>
                        <div class="admin-input-with-unit">
                            <InputNumber class="form-control" @bind-Value="model.ScanProcessIntervalMinutes" />
                            <span>Min.</span>
                        </div>
                        <div class="form-text">Standard: 60 Minuten</div>
                    </div>

                    <div>
                        <label class="form-label">Sammlungs-Scan</label>
                        <div class="admin-input-with-unit">
                            <InputNumber class="form-control" @bind-Value="model.MediaCollectionScanIntervalDays" />
                            <span>Tage</span>
                        </div>
                        <div class="form-text">Standard: 7 Tage</div>
                    </div>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">Speichern</button>
            </div>
        </EditForm>
    </section>
}

@code {
    private bool isAdmin;
    private bool isSaving;
    private string? statusMessage;
    private SettingsModel? model;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.HasClaim("IsAdmin", "True");

        if (!isAdmin)
            return;

        var setup = await SettingsService.GetOrCreateSetupAsync();
        model = new SettingsModel
        {
            ApplicationTitle = setup.ApplicationTitle,
            ScanProcessIntervalMinutes = setup.ScanProcessIntervalMinutes,
            MediaCollectionScanIntervalDays = setup.MediaCollectionScanIntervalDays,
        };
    }

    private async Task SaveAsync()
    {
        if (model is null)
            return;

        isSaving = true;
        statusMessage = null;
        try
        {
            await SettingsService.UpdateGeneralSettingsAsync(
                model.ApplicationTitle,
                model.ScanProcessIntervalMinutes,
                model.MediaCollectionScanIntervalDays);
            statusMessage = "Gespeichert.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class SettingsModel
    {
        [Required]
        [MaxLength(120)]
        public string ApplicationTitle { get; set; } = "Martins Videosammlung";

        [Range(1, 24 * 60)]
        public int ScanProcessIntervalMinutes { get; set; } = 60;

        [Range(1, 365)]
        public int MediaCollectionScanIntervalDays { get; set; } = 7;
    }
}
