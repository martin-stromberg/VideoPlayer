@page "/actors"
@using Microsoft.JSInterop
@using VideoWebPlayer.Client
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Components.Shared.Media
@inject VideoWebPlayerClient Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Schauspieler</PageTitle>

<h3>Schauspieler</h3>

<div class="mb-3">
    <input type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" placeholder="Schauspieler suchen..." />
</div>

<div class="mb-3 btn-group" role="group" aria-label="Sortierung">
    <button class="btn btn-sm @(sortMode == "alphabetical" ? "btn-primary" : "btn-outline-primary")" @onclick="SortByAlphabetical">Alphabetisch</button>
    <button class="btn btn-sm @(sortMode == "count" ? "btn-primary" : "btn-outline-primary")" @onclick="SortByCount">Anzahl Videos</button>
</div>

<div class="mb-3">
    @foreach (var option in filterOptions)
    {
        <button class="btn btn-sm @(selectedFilter == option ? "btn-primary" : "btn-outline-primary") me-1 mb-1" @onclick="() => SelectFilter(option)">
            @option
        </button>
    }
    @if (!string.IsNullOrEmpty(selectedFilter))
    {
        <button class="btn btn-sm btn-outline-secondary me-1 mb-1" @onclick="ClearFilter">Alle</button>
    }
</div>

@if (isLoading && !actors.Any())
{
    <p>Lade Schauspieler...</p>
}
else if (!actors.Any())
{
    <p>Keine Schauspieler gefunden.</p>
}
else
{
    <div class="media-grid">
        @foreach (var actor in actors)
        {
            <MediaBox Title="@GetActorTitle(actor)"
                      ImageUrl="@GetActorPictureUrl(actor.PictureUrl)"
                      LinkUrl="@($"/actors/{actor.Id}")" />
        }
    </div>
    @if (isLoading)
    {
        <p class="text-center mt-2">Weitere Schauspieler werden geladen...</p>
    }
    <div @ref="sentinel" id="actors-sentinel" style="height: 1px; width: 1px; margin-top: 20px;"></div>
}

@code {
    private const string SortKey = "actors.sort";
    private const int PageSize = 50;
    private string searchTerm = string.Empty;
    private string sortMode = "alphabetical";
    private string selectedFilter = string.Empty;
    private List<string> filterOptions = new();
    private List<ActorDto> actors = new();
    private int offset;
    private bool isLoading;
    private bool hasMore = true;
    private bool hasConnectedObserver;
    private ElementReference sentinel;
    private DotNetObjectReference<Actors>? dotNetHelper;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hasConnectedObserver)
        {
            try
            {
                sortMode = await JS.InvokeAsync<string?>("localStorage.getItem", SortKey) ?? "alphabetical";
                await LoadFiltersAsync();
                await ResetAndLoadAsync();
                dotNetHelper = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("observeBottom", sentinel, dotNetHelper);
                hasConnectedObserver = true;
            }
            catch (InvalidOperationException)
            {
                // Still pre-rendering; the next interactive render will retry.
            }
        }
    }

    [JSInvokable]
    public async Task OnBottomVisible()
    {
        if (isLoading || !hasMore)
            return;

        await LoadActorsAsync(append: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetHelper is not null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        if (hasConnectedObserver)
        {
            try
            {
                await JS.InvokeVoidAsync("disconnectMediaSourceBottomObserver");
            }
            catch (InvalidOperationException)
            {
                // JS runtime is no longer available.
            }
            hasConnectedObserver = false;
        }
    }

    private async Task LoadFiltersAsync()
    {
        filterOptions = (await Client.RequestActorFiltersAsync(sortMode)).ToList();
    }

    private async Task ResetAndLoadAsync()
    {
        offset = 0;
        actors = new List<ActorDto>();
        hasMore = true;
        await LoadActorsAsync();
    }

    private async Task LoadActorsAsync(bool append = false)
    {
        if (isLoading)
            return;

        isLoading = true;
        try
        {
            var newActors = (await Client.RequestActorsAsync(
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                sortMode,
                string.IsNullOrWhiteSpace(selectedFilter) ? null : selectedFilter,
                offset,
                PageSize)).ToList();

            if (!append)
                actors = newActors;
            else
                actors.AddRange(newActors);

            offset += newActors.Count;
            hasMore = newActors.Count == PageSize;
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    private async Task SetSortModeAsync(string mode)
    {
        if (mode == sortMode)
            return;

        sortMode = mode;
        selectedFilter = string.Empty;
        await JS.InvokeVoidAsync("localStorage.setItem", SortKey, sortMode);
        await LoadFiltersAsync();
        await ResetAndLoadAsync();
    }

    private Task SortByAlphabetical() => SetSortModeAsync("alphabetical");
    private Task SortByCount() => SetSortModeAsync("count");

    private string GetActorTitle(ActorDto actor)
        => sortMode == "count" ? $"{actor.Name} ({actor.VideoCount})" : actor.Name;

    private async Task OnSearchChanged(KeyboardEventArgs e)
    {
        await ResetAndLoadAsync();
    }

    private async Task SelectFilter(string option)
    {
        selectedFilter = option;
        await ResetAndLoadAsync();
    }

    private async Task ClearFilter()
    {
        selectedFilter = string.Empty;
        await ResetAndLoadAsync();
    }

    private string GetActorPictureUrl(string? pictureUrl)
        => !string.IsNullOrWhiteSpace(pictureUrl) && !string.IsNullOrWhiteSpace(Client.AuthorizationToken)
            ? $"{pictureUrl}?access_token={Client.AuthorizationToken}"
            : "/images/placeholder.png";
}
