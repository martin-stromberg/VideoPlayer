<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             x:Class="VideoWebPlayer.Maui.Components.MediaCarousel"
             x:DataType="viewmodels:MediaCarouselViewModel"
             IsVisible="{Binding HasItems}">
    <VerticalStackLayout Spacing="12">
        <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" TextColor="Black" Padding="20,0,20,0" FontFamily="OpenSansSemibold"/>
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="15" Padding="20,0,20,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MediaItemViewModel">
                        <Border WidthRequest="180" HeightRequest="270" StrokeThickness="0" Padding="0" Margin="0" BackgroundColor="#23232a">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Image Source="{Binding ImageSource}" Aspect="AspectFill" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
