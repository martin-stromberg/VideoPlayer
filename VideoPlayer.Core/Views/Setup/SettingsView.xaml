<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Setup"
             x:Class="VideoPlayer.Views.Setup.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <HorizontalStackLayout Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="0">
            <Switch IsToggled="{Binding ScansEnabled}"/>
            <Label Text="Quellen scannen"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="1">
            <Switch IsToggled="{Binding ClassificationsEnabled}"/>
            <Label Text="Erfasste Medien klassifieren"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="2">
            <Switch IsToggled="{Binding ImageScrapsEnabled}"/>
            <Label Text="Bilder laden &amp; aufbereiten"/>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
