    .tvshow-content-flex {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 420px); /* 320px = Höhe des Kopfbereichs, ggf. anpassen */
        min-height: 0;
    }

    .play-button {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: rgba(40,40,60,0.5);
        border: none;
        border-radius: 50%;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #fff;
        cursor: pointer;
        z-index: 11;
        transition: background 0.2s;
        box-shadow: 0 2px 16px rgba(0,0,0,0.7);
    }
    .play-button:hover {
        background: rgba(60,60,80,0.7);
    }

    .player-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(10,10,20,0.97);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .player-content {
        position: relative;
        background: #222;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.9);
        padding: 2rem;
        max-width: 900px;
        width: 80vw;
        box-sizing: border-box;
    }

    .close-player {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255,255,255,0.2);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    }

    .close-player:hover {
        background: rgba(255,255,255,0.3);
    }

    .player-content video {
        width: 100%;
        max-width: 100%;
        display: block;
        border-radius: 8px;
    }

    .episode-box {
        position: relative;
        display: flex;
        align-items: stretch;
        background: #23232a;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.7);
        cursor: pointer;
        width: 100%;
        min-height: 140px;
        transition: box-shadow 0.2s;
    }

    .episode-poster-left {
        width: 120px;
        height: 100%;
        object-fit: cover;
        border-radius: 10px 0 0 10px;
        background: #444;
        flex-shrink: 0;
        display: block;
        margin-right: 0.5rem;
    }

    .episode-download-btn {
        position: absolute;
        top: 12px;
        right: 16px;
        background: rgba(40,40,60,0.85);
        border: none;
        border-radius: 50%;
        padding: 4px 7px;
        z-index: 3;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

        .episode-download-btn:hover {
            background: #ffe066;
        }

        .episode-download-btn svg {
            display: block;
        }

    .favorite-btn {
        position: absolute;
        top: 1.2rem;
        right: 1.2rem;
        background: none;
        border: none;
        font-size: 2.2rem;
        color: #ffe066;
        cursor: pointer;
        z-index: 20;
        transition: color 0.2s;
        text-shadow: 0 2px 8px #000;
    }
    .favorite-btn:hover {
        color: #ffd700;
    }
</style>