@using Microsoft.AspNetCore.Authentication
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@using VideoWebPlayer.Utils

@inject ILogger<LoginForm> Logger

<section>
    <form action="Account/LoginProcess" method="post">
        <h2>Use a local account to log in.</h2>
        <hr />
        <div class="form-floating mb-3">
            <input type="email" id="email" name="email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" required />
            <label for="email" class="form-label">Email</label>
        </div>
        <div class="form-floating mb-3">
            <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" required />
            <label for="password" class="form-label">Password</label>
        </div>
        <div class="checkbox mb-3">
            <label class="form-label">
                <input type="checkbox" name="rememberMe" class="darker-border-checkbox form-check-input" value="true" />
                Remember me
            </label>
        </div>
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </div>
        @if (IsLocalNetwork)
        {
            <div>
                <p>
                    <a data-interception="off" href="@RegisterLink">Register as a new user</a>
                </p>
            </div>
        }
    </form>
</section>

@code {
    private bool IsLocalNetwork = false;

    [Parameter]
    public string? ReturnUrl { get; set; }

    private string? RegisterLink => $"Account/Register{(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}")}";

    protected override async Task OnInitializedAsync()
    {
        // No need to check HttpContext here since this is just a plain HTML form
        // The IsLocalNetwork check will be done on the server endpoint
        await Task.CompletedTask;
    }

    public class LoginResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? RedirectUrl { get; set; }
        public Dictionary<string, string>? QueryParameters { get; set; }
    }
}
