<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Default is 30000000 (~28.6 MB), which rejects the 128-MiB upload
             chunks before they reach Kestrel — also in OutOfProcess mode. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!-- processPath/arguments/hostingModel are set by the publish transform. -->
    <aspNetCore processPath="dotnet" arguments=".\VideoWebPlayer.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" requestTimeout="02:00:00" />
  </system.webServer>
</configuration>
