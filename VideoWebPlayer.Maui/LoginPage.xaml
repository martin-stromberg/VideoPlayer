<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoWebPlayer.Maui.LoginPage"
             Title="Anmeldung">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Benutzername" />
        <Entry x:Name="UserEntry" Placeholder="Benutzer" />
        <Label Text="Passwort" />
        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Passwort" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Login" Clicked="OnLoginClicked" />
            <Button Text="Abbrechen" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
        <Label x:Name="StatusLabel" TextColor="Gray" />
    </VerticalStackLayout>

</ContentPage>
