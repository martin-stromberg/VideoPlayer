{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/WebVideoPlayer.db"
  },
  "Backups": {
    "Path": "Data/Backups",
    "AutomaticBackupsEnabled": false,
    "MaxUploadSizeBytes": 5368709120,
    "Retention": {
      "SonCount": 7,
      "FatherCount": 4,
      "GrandfatherCount": 12
    }
  },
  "EpisodeBackgroundImage": {
    "MaxWidth": 1920,
    "MaxHeight": 1080,
    "TintColor": "#000000",
    "TintOpacity": 0.4,
    "CacheDurationMinutes": 60,
    "JpegQuality": 85,
    "EnableLogging": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "VideoWebPlayer.Services": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/web-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "VideoWebPlayer.Services": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AutoUpdate": {
    "Enabled": true,
    "EnableAutomaticDownload": true,
    "EnableAutomaticInstallation": true,
    "AllowPrereleaseUpdates": false,
    "StopHostAfterScriptStart": true,
    "DownloadPath": "Updates",
    "SourceCheck": {
      "Interval": 360
    },
    "Backup": {
      "Enabled": true,
      "Path": "Backups",
      "RetainedBackupCount": 5,
      "CancelInstallationOnFailure": true
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5002"
      }
    }
  }
}
