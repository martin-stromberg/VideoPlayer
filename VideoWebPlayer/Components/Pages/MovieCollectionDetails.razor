@page "/moviecollection/{Id:long}"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VideoWebPlayer.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@rendermode InteractiveServer

@if (!isAuthenticated)
{
    <div class="alert alert-warning">
        Bitte melden Sie sich an, um Filme abzuspielen oder herunterzuladen.
    </div>
}
else if (collection == null)
{
    <div class="alert alert-danger">Sammlung nicht gefunden.</div>
}
else if (selectedMovie != null)
{
    <!-- Einzelne Film-Ansicht -->
    <div class="movie-header" style="background-image: url('@GetBannerUrl(selectedMovie)'); position: relative;">
        <button class="favorite-btn" @onclick="() => ToggleFavorite(selectedMovie)" title="Film als Favorit markieren">
            @((IsMovieFavorite) ? "★" : "☆")
        </button>
        <div class="collection-header-overlay">
            @if (collection?.Movies?.Count > 1)
            {
                <button class="back-arrow" @onclick="ShowCollection" title="Zurück zur Sammlung">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                        <path d="M15 6l-6 6 6 6" stroke="#ffe066" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            <div class="collection-header-content">
                <h1>@selectedMovie.Name</h1>
                <div class="collection-meta">
                    <span class="collection-year">@GetYear(selectedMovie)</span>
                    <span class="collection-genres">@GetGenres(selectedMovie)</span>
                </div>
                <div class="collection-plot">@selectedMovie.Plot</div>
            </div>
            <button class="play-button" @onclick="ShowPlayer">
                <span>&#9654;</span>
            </button>
        </div>
    </div>
    <div style="text-align:start; margin-bottom:1.5rem;">
        <a class="btn btn-primary"
           href="@GetDownloadUrl(selectedMovie)"
           download>
            Video herunterladen
        </a>
    </div>
    @if (showPlayer)
    {
        <div class="player-overlay">
            <video src="@GetMovieStreamUrl(selectedMovie)" controls autoplay style="width:80vw;max-width:900px;"></video>
            <button class="close-player" @onclick="HidePlayer">×</button>
        </div>
    }
}
else
{
    <!-- Sammlungs-Ansicht -->
    <div class="collection-header" style="background-image: url('@GetBannerUrl(collection)'); position: relative;">
        <button class="favorite-btn" @onclick="() => ToggleFavorite(null)" title="Sammlung als Favorit markieren">
            @((IsCollectionFavorite) ? "★" : "☆")
        </button>
        <div class="collection-header-overlay">
            <div class="collection-header-content">
                <h1>@collection.Name</h1>
                <div class="collection-meta">
                    <span class="collection-year">@GetYear(collection)</span>
                    <span class="collection-genres">@GetGenres(collection)</span>
                </div>
                <div class="collection-plot"></div>
            </div>
            <button class="play-button" @onclick="ShowFirstMovie">
                <span>&#9654;</span>
            </button>
        </div>
    </div>
    <div class="movie-list-horizontal" id="movieListHorizontal">
        @foreach (var movie in collection.Movies.OrderBy(m => m.ReleaseDate).ThenBy(m => m.PremieredAt).ThenBy(m => m.Name))
        {
            var name = movie.Name;
            if (name.StartsWith(collection.Name))
                name = name.Remove(0, collection.Name.Length).TrimStart(' ', ':', '-');
            if (string.IsNullOrWhiteSpace(name) || (name.Length <= 3)) name = movie.Name;
            <div class="media-box" @onclick="() => SelectMovieAsync(movie)">
                <img class="media-poster"
                     src="@GetPosterUrl(movie)"
                     alt="@movie.Name"
                     onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                <div class="media-title" title="@movie.Name">@name</div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "movie")]
    public long? MovieId { get; set; }

    private MovieCollection? collection;
    private Movie? selectedMovie;
    private bool showPlayer = false;
    private bool isAuthenticated;
    private bool IsCollectionFavorite;
    private bool IsMovieFavorite;

    private ElementReference movieListRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        collection = await DbContext.MovieCollections
            .Include(mc => mc.Movies)
                .ThenInclude(m => m.MovieMediaItems)
                    .ThenInclude(mmi => mmi.MediaItem)
            .FirstOrDefaultAsync(mc => mc.Id == Id);

        IsCollectionFavorite = await CheckIfFavorite(collectionId: collection, movieId: null);

        if (MovieId.HasValue && collection?.Movies != null)
        {
            var movie = collection.Movies.FirstOrDefault(m => m.Id == MovieId.Value);
            if (movie != null)
                await SelectMovieAsync(movie);
        }
        else if (collection?.Movies?.Count == 1)
        {
            await SelectMovieAsync(collection.Movies.First());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (collection != null && selectedMovie == null)
        {
            await JS.InvokeVoidAsync("enableHorizontalWheelScroll", "#movieListHorizontal");
        }
    }

    private string GetBannerUrl(MovieCollection col)
        => col.BannerPictureId.HasValue ? $"/api/pictures/{col.BannerPictureId}" : col.FanartPictureId.HasValue ? $"/api/pictures/{col.FanartPictureId}" : "/images/placeholder.png";

    private string GetBannerUrl(Movie movie)
        => movie.BannerPictureId.HasValue ? $"/api/pictures/{movie.BannerPictureId}" : movie.FanartPictureId.HasValue ? $"/api/pictures/{movie.FanartPictureId}": "/images/placeholder.png";

    private string GetPosterUrl(Movie movie)
        => movie.PosterPictureId.HasValue ? $"/api/pictures/{movie.PosterPictureId}" : movie.FanartPictureId.HasValue ? $"/api/pictures/{movie.FanartPictureId}" : "/images/placeholder.png";

    private string GetYear(MovieCollection col)
        => col.Movies?.Where(mbox => mbox.ReleaseDate != DateTime.MinValue)?.OrderBy(m => m.ReleaseDate)?.FirstOrDefault()?.ReleaseDate?.Year.ToString() ?? "";

    private string GetYear(Movie movie)
        => movie.ReleaseDate?.Year.ToString() ?? "";

    private string GetGenres(MovieCollection col)
        => string.Join(", ", col.Movies?.SelectMany(m => (m.Genres ?? "").Split(',')).Distinct() ?? Array.Empty<string>());

    private string GetGenres(Movie movie)
        => movie.Genres ?? "";

    private void ShowPlayer() => showPlayer = true;
    private void HidePlayer() => showPlayer = false;

    private string GetMovieStreamUrl(Movie movie)
    {
        var movieMediaItem = DbContext.MovieMediaItems.Where(mmi => mmi.MovieId == movie.Id).FirstOrDefault();
        var mediaItem = DbContext.MediaItems.FirstOrDefault(mi => mi.Id == movieMediaItem.MediaItemId);
        var mediaItemId = mediaItem?.Id;
        if (mediaItemId is null)
            HidePlayer();
        return mediaItemId != null ? $"/api/mediaitems/{mediaItemId}/stream" : "";
    }

    private async Task SelectMovieAsync(Movie movie)
    {
        selectedMovie = movie;
        showPlayer = false;
        IsMovieFavorite = await CheckIfFavorite(collectionId: null, movieId: selectedMovie);
    }

    private void ShowCollection()
    {
        selectedMovie = null;
        showPlayer = false;
    }

    private async Task ShowFirstMovie()
    {
        if (collection?.Movies?.Any() == true)
            await SelectMovieAsync(collection.Movies.First());
    }

    private string GetDownloadUrl(Movie movie)
    {
        // Hole die MediaItemId für den Download
        var movieMediaItem = DbContext.MovieMediaItems.FirstOrDefault(mmi => mmi.MovieId == movie.Id);
        var mediaItemId = movieMediaItem?.MediaItemId;
        return mediaItemId != null ? $"/api/mediaitems/{mediaItemId}/download" : "#";
    }

    private async Task ToggleFavorite(Movie? movie)
    {
        var userId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (movie != null)
        {
            IsMovieFavorite = await DbContext.ToggleFavoriteAsync(userId, movie);
        }
        else
        {
            IsCollectionFavorite = await DbContext.ToggleFavoriteAsync(userId, collection);
        }
        await DbContext.SaveChangesAsync();
    }

    private async Task<bool> CheckIfFavorite(MediaBaseEntry collectionId, MediaBaseEntry movieId)
    {
        var userId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (movieId is not null)
            return DbContext.IsFavorite(userId, movieId);
        if (collectionId is not null)
            return DbContext.IsFavorite(userId, collectionId);
        return false;
    }
}
<script src="scroll-horizontal.js"></script>
<style>
.btn-primary {
    /* ...deine bestehenden Styles... */
    margin-top: 1rem;
}
.favorite-btn {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: none;
    border: none;
    font-size: 2.2rem;
    color: #ffe066;
    cursor: pointer;
    z-index: 20;
    transition: color 0.2s;
    text-shadow: 0 2px 8px #000;
}
.favorite-btn:hover {
    color: #ffd700;
}
</style>