    private async Task ReloadScheduleAsync()
    {
        if (channel is null)
            return;

        schedule = await ProgramScheduleService.GetScheduleAsync(channel.Id, DateTimeOffset.UtcNow.AddHours(-2), 200);
        var ruleIds = schedule.Where(s => s.ProgramRuleId is not null).Select(s => s.ProgramRuleId!.Value).Distinct().ToList();
        slotRuleNames = await DbContext.ProgramRules
            .Where(r => ruleIds.Contains(r.Id))
            .ToDictionaryAsync(r => r.Id, r => r.Name);
        var movieIds = schedule.Where(s => s.MovieId is not null).Select(s => s.MovieId!.Value).Distinct().ToList();
        var movies = await DbContext.Movies
            .Where(m => movieIds.Contains(m.Id))
            .ToDictionaryAsync(m => m.Id, m => new MovieCardData(m.Name, m.Plot, m.PosterPictureId, m.GenreNames));
        var episodeIds = schedule.Where(s => s.TVShowEpisodeId is not null).Select(s => s.TVShowEpisodeId!.Value).Distinct().ToList();
        var episodes = await DbContext.TVShowEpisodes
            .Where(e => episodeIds.Contains(e.Id))
            .Select(e => new EpisodeCardData(
                e.Id, e.Name, e.Number, e.Plot, e.PosterPictureId,
                e.TVShowSeason.Name, e.TVShowSeason.PosterPictureId,
                e.TVShowSeason.TVShow.Name, e.TVShowSeason.TVShow.Plot,
                e.TVShowSeason.TVShow.PosterPictureId, e.TVShowSeason.TVShow.GenreNames))
            .ToDictionaryAsync(e => e.Id);
        var bareItemIds = schedule.Where(s => s.MovieId is null && s.TVShowEpisodeId is null).Select(s => s.MediaItemId).Distinct().ToList();
        var itemNames = await DbContext.MediaItems
            .Where(i => bareItemIds.Contains(i.Id))
            .ToDictionaryAsync(i => i.Id, i => i.Name);

        // Die Karten brauchen dieselben Inhalte wie die Programmauskunft (Poster, Beschreibung,
        // Genre, Episoden-Info) — hier direkt per EF, weil der Admin-Plan auch verdrängte Slots
        // zeigt, die api/program-guide bewusst nicht liefert.
        slotCards = new Dictionary<long, ScheduleCardContent>();
        foreach (var slot in schedule)
        {
            var title = "(Inhalt nicht gefunden)";
            string? showName = null, subtitle = null, description = null, genreName = null;
            long? posterId = null;

            if (slot.TVShowEpisodeId is { } epId && episodes.TryGetValue(epId, out var ep))
            {
                title = $"{ep.ShowName} — {ep.SeasonName}, E{ep.Number}: {ep.EpisodeName}";
                showName = ep.ShowName;
                subtitle = ProgramGuideEntryText.Subtitle(ep.SeasonName, ep.Number, ep.EpisodeName);
                description = ep.Plot ?? ep.ShowPlot;
                genreName = ProgramGuideEntryText.FirstGenre(ep.ShowGenreNames);
                posterId = ep.PosterPictureId ?? ep.SeasonPosterPictureId ?? ep.ShowPosterPictureId;
            }
            else if (slot.MovieId is { } mvId && movies.TryGetValue(mvId, out var mv))
            {
                title = mv.Name;
                description = mv.Plot;
                genreName = ProgramGuideEntryText.FirstGenre(mv.GenreNames);
                posterId = mv.PosterPictureId;
            }
            else if (slot.MovieId is null && slot.TVShowEpisodeId is null
                     && itemNames.TryGetValue(slot.MediaItemId, out var itemName)
                     && !string.IsNullOrWhiteSpace(itemName))
            {
                title = itemName;
            }

            slotCards[slot.Id] = new ScheduleCardContent(title, showName, subtitle, description, genreName, posterId);
        }
    }

