@* Generischer Platzhalter-Grafik fuer eine Playlist-Kachel bzw. den Kopfbereich-Hintergrund der
   Detailansicht. Wird als Fallback angezeigt, wenn die Playlist kein Cover besitzt (weder hochgeladen
   noch automatisch erzeugt, siehe Entwicklungsschritt 10 "Abbildungen fuer Playlists") oder das Bild
   nicht ladbar ist. Zeigt einen aus der Playlist-Id abgeleiteten Farbverlauf (bewusst OHNE Symbol - Kundenrueckmeldung:
   das Listensymbol wirkt amateurhaft), damit Playlists in der Kachel-UI trotzdem optisch unterscheidbar sind, statt dass jede
   Kachel identisch aussieht. *@

<div class="playlist-cover-placeholder @CssClass" style="--playlist-hue: @Hue" aria-hidden="true">
</div>

@code {
    /// <summary>
    /// The id of the playlist the placeholder is shown for, used to derive a deterministic (but
    /// arbitrary) hue so different playlists get visually distinct gradients.
    /// </summary>
    [Parameter, EditorRequired]
    public long PlaylistId { get; set; }

    /// <summary>
    /// Additional CSS class(es) applied to the placeholder's root element, e.g. to size/position it
    /// differently between the overview tile and the detail page header background.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private int Hue => (int)((PlaylistId * 47) % 360);
}
