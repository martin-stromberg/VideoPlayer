@page "/admin/mediasources"
@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject VideoWebPlayer.Services.MediaSourceScanner MediaSourceScanner
@inject VideoWebPlayer.Services.MediaSourceClassifier MediaSourceClassifier
@inject ILogger<MediaSourceAdmin> Logger
@inject VideoWebPlayer.Services.Backups.IBackgroundProcessingGate BackgroundGate
@rendermode InteractiveServer

<PageTitle>Quellen verwalten</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!isAdmin)
        {
            <div class="alert alert-danger">Zugriff verweigert: Nur Administratoren dürfen diese Seite sehen.</div>
        }
        else
        {
            <section class="admin-console admin-sources-page">
            <header class="admin-page-header">
                <div>
                    <span class="admin-kicker">Einrichtung</span>
                    <h1>Quellen</h1>
                    <p>Speicherorte, Zugangsdaten und Scanstatus verwalten.</p>
                </div>
                <a class="btn btn-outline-light" href="/admin">Zurueck</a>
            </header>

            <div class="mb-3">
                <button class="btn btn-success me-2" @onclick="CreateNew">Neu</button>
                <button class="btn btn-warning" @onclick="RunFullScan" disabled="@isFullScanRunning">Komplettscan aller Quellen</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(fullScanStatus))
            {
                <div class="alert alert-info" role="alert">
                    @fullScanStatus
                    @if (isFullScanRunning)
                    {
                        <span class="ms-2">(gescannte Collections: @fullScanScannedCollections)</span>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            @if (mediaSources.Count == 0)
            {
                <div class="alert alert-secondary">Noch keine Quellen vorhanden.</div>
            }
            else
            {
                <table class="table table-dark table-striped">
                    <thead>
                        <tr>
                            <th>Icon</th>
                            <th>Name</th>
                            <th>Host</th>
                            <th>Port</th>
                            <th>Pfad</th>
                            <th>Benutzername</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var source in mediaSources)
                        {
                            <tr style="cursor:pointer" @onclick="() => OpenDetails(source.Id)">
                                <td>
                                    @if (source.IconPictureId.HasValue)
                                    {
                                        <img class="source-icon"
                                             src="@GetIconUrl(source.IconPictureId.Value)"
                                             alt="Icon"
                                             onerror="this.onerror=null;this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <span class="bi bi-folder-video" title="Standard-Icon"></span>
                                    }
                                </td>
                                <td>@source.Name</td>
                                <td>@source.Host</td>
                                <td>@source.Port</td>
                                <td>@source.Path</td>
                                <td>@source.Username</td>
                                <td>
                                    @if (deletionStates.TryGetValue(source.Id, out var state) && state.IsDeleting)
                                    {
                                        <div class="progress" style="width: 120px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: @($"{Math.Max(state.Progress, 0.05) * 100:F0}")%" aria-valuenow="@(state.Progress * 100)" aria-valuemin="0" aria-valuemax="100">
                                                @((state.Progress * 100).ToString("F0"))%
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-danger me-1" @onclick:stopPropagation="true" @onclick="() => DeleteSource(source)">Löschen</button>
                                        <button class="btn btn-sm btn-warning" @onclick:stopPropagation="true" @onclick="() => ResetScan(source)">Scan zurücksetzen</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </section>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Bitte melden Sie sich an.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<MediaSource> mediaSources = new();
    private bool isAdmin;
    private string? errorMessage;

    private record DeletionState(bool IsDeleting, double Progress);
    private readonly Dictionary<long, DeletionState> deletionStates = new();

    private bool isFullScanRunning;
    private string? fullScanStatus;
    private int fullScanScannedCollections;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAdmin = user.Identity?.IsAuthenticated == true && user.HasClaim("IsAdmin", "True");

        if (isAdmin)
        {
            await LoadSources();
        }
    }

    private async Task LoadSources()
    {
        mediaSources = await DbContext.MediaSources
            .Include(x => x.MediaSourceUsers)
            .OrderBy(x => x.Name)
            .ToListAsync();
        StateHasChanged();
    }

    private void OpenDetails(long id)
    {
        Navigation.NavigateTo($"/admin/mediasources/{id}");
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/admin/mediasources/new");
    }

    private string GetIconUrl(long iconPictureId)
        => $"/api/sourceicons/{iconPictureId}?access_token={Client.AuthorizationToken}";

    private async Task DeleteSource(MediaSource source)
    {
        errorMessage = null;
        deletionStates[source.Id] = new DeletionState(true, 0);
        await InvokeAsync(StateHasChanged);

        var progress = new Progress<double>(p =>
        {
            if (deletionStates.TryGetValue(source.Id, out var state))
            {
                deletionStates[source.Id] = state with { Progress = p };
                InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            await DbContext.DeleteMediaSourceAsync(source, progress, CancellationToken.None);
            deletionStates.Remove(source.Id);
            await LoadSources();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Löschen der Quelle (Id={Id}).", source.Id);
            errorMessage = "Die Quelle konnte nicht gelöscht werden.";
            deletionStates[source.Id] = new DeletionState(false, 0);
        }
    }

    private async Task ResetScan(MediaSource source)
    {
        source.LastScannedAt = DateTime.MinValue;
        await DbContext.UpdateMediaSourceAsync(source);
        await LoadSources();
    }

    private async Task RunFullScan()
    {
        if (isFullScanRunning)
            return;

        if (BackgroundGate.IsPausedForRestore)
        {
            fullScanStatus = "Restore laeuft. Der Komplettscan ist derzeit gesperrt.";
            return;
        }

        isFullScanRunning = true;
        fullScanScannedCollections = 0;
        fullScanStatus = "Starte Komplettscan: ScanAllSourcesAsync...";
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var processingLease = await BackgroundGate.EnterOperationAsync("Manueller Komplettscan", CancellationToken.None);
            await MediaSourceScanner.ScanAllSourcesAsync(CancellationToken.None);

            fullScanStatus = "Komplettscan: ScanNextMediaCollection...";
            await InvokeAsync(StateHasChanged);

            while (await MediaSourceScanner.ScanNextMediaCollection(CancellationToken.None))
            {
                fullScanScannedCollections++;
                fullScanStatus = "Komplettscan: Scanne Collections...";
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
            }

            fullScanStatus = "Komplettscan: Klassifizierung...";
            await InvokeAsync(StateHasChanged);
            await MediaSourceClassifier.ClassifyAllAsync(CancellationToken.None);

            fullScanStatus = "Komplettscan: Prüfe Genre-Reload...";
            await InvokeAsync(StateHasChanged);
            await MediaSourceClassifier.CheckReloadGenres(CancellationToken.None);

            fullScanStatus = "Komplettscan abgeschlossen.";
            await LoadSources();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim manuellen Komplettscan aller Quellen.");
            fullScanStatus = $"Fehler beim Komplettscan: {ex.Message}";
        }
        finally
        {
            isFullScanRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}

<style>
    .source-icon {
        width: 32px;
        height: 32px;
        object-fit: contain;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.06);
    }
</style>
