<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IssueTest.ViewModels"
             xmlns:views="clr-namespace:IssueTest.Views"
             x:Class="IssueTest.Views.ItemViewCollectionView">
    <VerticalStackLayout x:DataType="vm:MainFormViewModel">
        <FlexLayout
AlignContent="Start"
AlignItems="Start"
AlignSelf="Start"
BindableLayout.ItemsSource="{Binding Items}"
Direction="Row"
JustifyContent="Start"
Wrap="Wrap">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:MainFormListItemViewModel">
                    <!--<views:ItemBoxView/>-->
                    <!--<Button 
                    Opacity="0.9" 
                    Clicked="Button_Clicked" 
                    Text="{Binding Name}" 
                    TextColor="Red" 
                    BackgroundColor="Blue" 
                    BorderWidth="0" 
                    Margin="0" 
                    Padding="0" 
                    WidthRequest="200" 
                    HeightRequest="100"/>-->
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
    </VerticalStackLayout>
</ContentView>
