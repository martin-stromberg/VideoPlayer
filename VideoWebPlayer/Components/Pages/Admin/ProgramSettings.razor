@page "/admin/program-settings"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@inject ProgramSettingsService SettingsService
@inject IProgramScheduleSignal ScheduleSignal
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

<PageTitle>Allgemein</PageTitle>

@if (!isAdmin)
{
    <div class="alert alert-danger">Nicht autorisiert.</div>
}
else if (model is null)
{
    <div class="alert alert-info">Lade…</div>
}
else
{
    <section class="admin-console admin-form-page">
        <header class="admin-page-header">
            <div>
                <span class="admin-kicker">Einrichtung</span>
                <h1>Allgemein</h1>
                <p>Anwendungstitel, Scan-Verhalten, Weiterschauen und Netzwerk-Erkennung konfigurieren.</p>
            </div>
            <a class="btn btn-outline-light" href="/admin">Zurück</a>
        </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="admin-card admin-card-wide">
                <h2>Anwendung</h2>
                <div class="mb-3">
                    <label class="form-label">Anwendungstitel</label>
                    <InputText class="form-control" @bind-Value="model.ApplicationTitle" />
                    <div class="form-text">Dieser Titel erscheint in der Navigation und auf der Startseite.</div>
                </div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>Scan-Einstellungen</h2>
                <div class="admin-settings-grid">
                    <div>
                        <label class="form-label">Scanprozess-Intervall</label>
                        <div class="admin-input-with-unit">
                            <InputNumber class="form-control" @bind-Value="model.ScanProcessIntervalMinutes" />
                            <span>Min.</span>
                        </div>
                        <div class="form-text">Standard: 60 Minuten</div>
                    </div>

                    <div>
                        <label class="form-label">Sammlungs-Scan</label>
                        <div class="admin-input-with-unit">
                            <InputNumber class="form-control" @bind-Value="model.MediaCollectionScanIntervalDays" />
                            <span>Tage</span>
                        </div>
                        <div class="form-text">Standard: 7 Tage</div>
                    </div>
                </div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>Weiterschauen</h2>
                <div class="admin-settings-grid">
                    <div>
                        <label class="form-label">Sekunden vor dem Videoende</label>
                        <div class="admin-input-with-unit">
                            <InputNumber class="form-control" @bind-Value="model.ContinueWatchingEndThresholdSeconds" />
                            <span>Sek.</span>
                        </div>
                        <div class="form-text">Standard: 30 Sekunden. Position wird nicht gespeichert, wenn der Abstand zum Videoende kleiner ist.</div>
                    </div>
                </div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>TV-Sender</h2>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="tvSenderEnabled" @bind-Value="model.TvSenderEnabled" />
                    <label class="form-check-label" for="tvSenderEnabled">Automatisierten TV-Sender freischalten</label>
                </div>
                <div class="form-text">Erst bei Freigabe erscheint der „Live-TV"-Eintrag in der Navigation, laufen Sendeplan, Stream und Laufzeitermittlung und sind die Seiten <code>/live-tv</code> und <code>/admin/tv-sender</code> samt API erreichbar. Wirkt ohne Neustart — laufende Worker stoppen bzw. starten beim nächsten Intervall.</div>

                <div class="mt-3" id="tvsender-user-access">
                    <label class="form-label">Diese Benutzer dürfen den TV-Sender sehen</label>
                    @if (users.Count == 0)
                    {
                        <div class="form-text">Keine Benutzerkonten vorhanden.</div>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            var userId = user.Id;
                            <div class="form-check tvsender-user-access-row">
                                <input type="checkbox" class="form-check-input" id="tvsender-user-@userId"
                                       checked="@model.TvSenderAllowedUserIds.Contains(userId)"
                                       disabled="@user.IsAdmin"
                                       @onchange="e => OnTvSenderUserToggled(userId, e.Value is bool b && b)" />
                                <label class="form-check-label" for="tvsender-user-@userId">
                                    @user.Email
                                    @if (user.IsAdmin)
                                    {
                                        <span class="form-text d-inline">(Administrator — immer Zugriff)</span>
                                    }
                                </label>
                            </div>
                        }
                    }
                    <div class="form-text">Administratoren haben immer Zugriff. Ohne Auswahl sehen nur Administratoren den Sender. Die Auswahl wirkt zusätzlich zur globalen Freischaltung und sofort — bestehende Zugriffe entfallen ohne Neustart.</div>
                </div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>Netzwerk-Erkennung (mDNS)</h2>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="mdnsAdvertisementEnabled" @bind-Value="model.MdnsAdvertisementEnabled" />
                    <label class="form-check-label" for="mdnsAdvertisementEnabled">Server per mDNS im Netzwerk ankündigen</label>
                </div>
                <div class="form-text">Der Server kündigt sich als Diensttyp <code>_videowebplayer._tcp.local.</code> per mDNS (UDP-Port 5353) an, damit Apps ihn automatisch finden. Wirkt nur zusammen mit der Serverkonfiguration <code>Mdns:Enabled</code> — ist diese deaktiviert, bleibt das Advertisement aus. Änderungen werden spätestens nach ca. 60 Sekunden wirksam, ein Neustart ist nicht nötig.</div>
            </div>

            <div class="admin-card admin-card-wide">
                <h2>Öffentliche Basis-URL (Broadcast-Erkennung)</h2>
                <div class="mb-3">
                    <label class="form-label" for="discoveryPublicBaseUrl">Öffentliche Basis-URL</label>
                    <InputText class="form-control" id="discoveryPublicBaseUrl" @bind-Value="model.DiscoveryPublicBaseUrl" />
                    <ValidationMessage For="() => model.DiscoveryPublicBaseUrl" />
                    <div class="form-text">Adresse, die der Server bei der Broadcast-Erkennung (UDP-Port 5001) an Apps meldet — vollständig mit Schema, Host, Port und Pfad, z. B. <code>https://videos.example.com/videoplayer/</code>. Hat Vorrang vor der Serverkonfiguration <code>Discovery:PublicBaseUrl</code>. Leer lassen, damit die Adresse automatisch abgeleitet wird. Änderungen wirken sofort, ein Neustart ist nicht nötig.</div>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">Speichern</button>
            </div>
        </EditForm>
    </section>
}

@code {
    private bool isAdmin;
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;
    private SettingsModel? model;
    private List<ApplicationUser> users = new();
    private const string SystemUserNormalizedName = "SYSTEM";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.HasClaim("IsAdmin", "True");

        if (!isAdmin)
            return;

        var setup = await SettingsService.GetOrCreateSetupAsync();
        model = new SettingsModel
        {
            ApplicationTitle = setup.ApplicationTitle,
            ScanProcessIntervalMinutes = setup.ScanProcessIntervalMinutes,
            MediaCollectionScanIntervalDays = setup.MediaCollectionScanIntervalDays,
            ContinueWatchingEndThresholdSeconds = setup.ContinueWatchingEndThresholdSeconds,
            MdnsAdvertisementEnabled = setup.MdnsAdvertisementEnabled,
            DiscoveryPublicBaseUrl = setup.DiscoveryPublicBaseUrl,
            TvSenderEnabled = setup.TvSenderEnabled,
            TvSenderAllowedUserIds = await SettingsService.GetTvSenderAllowedUserIdsAsync(),
        };

        // Benutzerliste fuer die TV-Sender-Freigabe (N28): das Systemkonto wird wie in der
        // Anwenderverwaltung ausgeblendet.
        users = await UserManager.Users
            .Where(u => u.NormalizedUserName != SystemUserNormalizedName)
            .OrderBy(u => u.Email)
            .ToListAsync();
        // Admin-Haekchen sind deaktiviert, aber trotzdem in der Auswahl repräsentiert.
        foreach (var admin in users.Where(u => u.IsAdmin))
            model.TvSenderAllowedUserIds.Add(admin.Id);
    }

    private void OnTvSenderUserToggled(string userId, bool selected)
    {
        if (model is null)
            return;
        if (selected)
            model.TvSenderAllowedUserIds.Add(userId);
        else
            model.TvSenderAllowedUserIds.Remove(userId);
    }

    private async Task SaveAsync()
    {
        if (model is null)
            return;

        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            await SettingsService.UpdateGeneralSettingsAsync(
                new GeneralSettingsUpdate(
                    model.ApplicationTitle,
                    model.ScanProcessIntervalMinutes,
                    model.MediaCollectionScanIntervalDays,
                    model.ContinueWatchingEndThresholdSeconds,
                    model.MdnsAdvertisementEnabled,
                    model.DiscoveryPublicBaseUrl,
                    model.TvSenderEnabled));
            // N28: Allowlist im selben Speichern — Admin-Haekchen sind deaktiviert, werden aber
            // mitgegeben (harmlose Zeilen, Auswertung laeuft ueber den impliziten Admin-Zugriff).
            await SettingsService.UpdateTvSenderAllowedUserIdsAsync(model.TvSenderAllowedUserIds);
            // Sendeplan/Stream/Probe werten das Flag je Intervall aus; das Signal weckt sie sofort,
            // damit eine frisch erteilte Freigabe nicht bis zum nächsten Generierungslauf wartet.
            ScheduleSignal.NotifyScheduleChanged();
            statusMessage = "Gespeichert.";
        }
        catch (DiscoveryUrlValidationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class SettingsModel
    {
        [Required]
        [MaxLength(120)]
        public string ApplicationTitle { get; set; } = "Martins Videosammlung";

        [Range(1, 24 * 60)]
        public int ScanProcessIntervalMinutes { get; set; } = 60;

        [Range(1, 365)]
        public int MediaCollectionScanIntervalDays { get; set; } = 7;

        [Range(0, 3600)]
        public int ContinueWatchingEndThresholdSeconds { get; set; } = 30;

        public bool MdnsAdvertisementEnabled { get; set; } = true;

        public bool TvSenderEnabled { get; set; }

        public HashSet<string> TvSenderAllowedUserIds { get; set; } = new(StringComparer.Ordinal);

        [Display(Name = "Die öffentliche Basis-URL")]
        [AbsoluteHttpUrl]
        public string? DiscoveryPublicBaseUrl { get; set; }
    }
}
