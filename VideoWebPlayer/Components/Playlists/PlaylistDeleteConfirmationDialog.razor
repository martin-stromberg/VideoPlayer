<ConfirmationDialog Title="Playlist löschen" OnConfirm="OnConfirm" OnCancel="OnCancel"
                    ConfirmButtonText="Löschen" ConfirmButtonId="confirm-delete-playlist-button" CancelButtonId="cancel-delete-playlist-button">
    <p>Möchten Sie die Playlist "@PlaylistName" wirklich löschen?</p>
</ConfirmationDialog>

@code {
    [Parameter]
    public string? PlaylistName { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
