<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vw="clr-namespace:VideoPlayer.Views"
             xmlns:vwHome="clr-namespace:VideoPlayer.Views.Homepage"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Global;assembly=VideoPlayerMaui"
             x:Class="VideoPlayer.Views.MainPage"
             x:DataType="vm:ApplicationViewModel"             
             Shell.NavBarIsVisible="True"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="▶️" Command="{Binding StartPlayback}" CommandParameter="genral" />
    </ContentPage.ToolbarItems>
    <Grid>
        <Label
            Text="Loading..."
            IsVisible="{Binding IsInitializing}"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
        <Grid
            IsVisible="{Binding IsInitialized}">
            <vwHome:HomePageView 
                BindingContext="{Binding ContentViewModel}" />
        </Grid>
        <vw:StatusBar 
            BindingContext="{Binding StatusViewModel}"
            VerticalOptions="End"
            Margin="5"/>
    </Grid>
</ContentPage>
