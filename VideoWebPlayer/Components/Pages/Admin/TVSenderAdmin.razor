    // Live-Suche wie bei den Clip-Gruppen-Kandidaten: jede Eingabe startet die
    // 400-ms-Frist neu, erst danach läuft die Kandidaten-Abfrage.
    private Task OnStandbySearchChanged()
    {
        standbySearchDebounceCts?.Cancel();
        standbySearchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        standbySearchDebounceCts = cts;
        _ = DebouncedReloadStandbyCandidatesAsync(cts.Token);
        return Task.CompletedTask;
    }

    private async Task DebouncedReloadStandbyCandidatesAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(StandbySearchDebounceMilliseconds, cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cancellationToken.IsCancellationRequested)
            return;

        try
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await ReloadStandbyCandidatesAsync();
                }
                catch (Exception ex)
                {
                    channelStatus = ex.Message;
                }
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Dispatch oder StateHasChanged schlug fehl (z. B. Komponente bereits disposed)
            // — ohne diesen Catch faultete der unbeobachtete Task still.
        }
    }

