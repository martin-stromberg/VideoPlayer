@page "/tvshow/{Id:long}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services.EpisodeBackgroundImage
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject ApplicationDbContext Db
@inject EpisodeBackgroundImageService BackgroundImageService
@inject ILogger<TVShowDetails> Logger
@rendermode InteractiveServer

@code {
    [Parameter] public long Id { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "season")] public long? SeasonId { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "episode")] public long? EpisodeId { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "position")] public long? Position { get; set; }

    private DtoTVShow? show;
    private DtoTVShowSeason? selectedSeason;
    private DtoTVShowEpisode? selectedEpisode;
    private bool showSeasonInfo = false;
    private bool showPlayer = false;
    private bool isAuthenticated;
    private bool isFavorite = false;
    private long resumeSeconds;

    // Neu: Player-Referenz für Positionsabfrage
    private VideoPlayer? _player;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        show = await Client.RequestTVShowAsync(Id) as DtoTVShow;
        selectedSeason = show?.Seasons?.OrderBy(s => s.Name).FirstOrDefault();
        showSeasonInfo = false;

        if (SeasonId.HasValue && show?.Seasons != null)
        {
            var season = show.Seasons.FirstOrDefault(s => s.Id == SeasonId.Value);
            if (season != null)
            {
                selectedSeason = season;
                showSeasonInfo = true;
            }
        }

        if (EpisodeId.HasValue && selectedSeason?.Episodes != null)
        {
            var episode = selectedSeason.Episodes.FirstOrDefault(e => e.Id == EpisodeId.Value);
            if (episode != null)
                selectedEpisode = episode;
        }

        if (Position.HasValue && selectedEpisode is not null)
        {
            AutoPlay(Position.Value);
            Position = 0;
        }

        await EnsureEpisodeBackgroundImageAsync();
        await UpdateFavoriteMark();
    }

    private async Task EnsureEpisodeBackgroundImageAsync()
    {
        if (selectedEpisode is null)
            return;

        try
        {
            var episode = await Db.TVShowEpisodes.AsNoTracking().FirstOrDefaultAsync(e => e.Id == selectedEpisode.Id);
            if (episode is null)
                return;

            var picture = await BackgroundImageService.EnsureBackgroundImageAsync(episode, CancellationToken.None);
            selectedEpisode.GeneratedBackgroundPictureId = picture?.Id;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Hintergrundbild für Episode {EpisodeId} konnte nicht sichergestellt werden.", selectedEpisode?.Id);
        }
    }

    private string GetHeaderBackgroundUrl()
        => HasGeneratedBackgroundImage()
            ? BuildEpisodeBackgroundImageUrl(selectedEpisode!.Id, Client.AuthorizationToken)
            : GetBannerUrl((DtoMediaEntry)selectedEpisode ?? (showSeasonInfo ? (DtoMediaEntry)selectedSeason : (DtoMediaEntry)show));

    private bool HasGeneratedBackgroundImage()
        => selectedEpisode is not null && (selectedEpisode.GeneratedBackgroundPictureId ?? 0) > 0;

    /// <summary>
    /// Builds the URL for a generated episode background image, including the access token
    /// required by <see cref="Controllers.Attributes.BearerTokenCheckAttribute"/> for direct
    /// browser requests (e.g. CSS background-image). Internal and pure so it can be regression-tested
    /// without reflection or a rendered component.
    /// </summary>
    internal static string BuildEpisodeBackgroundImageUrl(long episodeId, string? accessToken)
        => $"/api/episodes/{episodeId}/background-image?access_token={accessToken}";

    private async Task UpdateFavoriteMark()
    {
        var target = GetFavoriteTarget();
        isFavorite = target?.IsFavorite ?? false;
    }

    private DtoMediaEntry? GetFavoriteTarget()
    {
        if (show is null)
            return null;

        if (selectedEpisode is not null)
        {
            if (selectedEpisode.Number == 1)
            {
                if (TryParseSeasonNumber(selectedSeason?.Name) == 1)
                    return show;

                return selectedSeason;
            }

            return selectedEpisode;
        }

        if (showSeasonInfo && selectedSeason is not null)
            return selectedSeason;

        return show;
    }

    private static int? TryParseSeasonNumber(string? seasonName)
    {
        if (string.IsNullOrWhiteSpace(seasonName))
            return null;

        var match = System.Text.RegularExpressions.Regex.Match(seasonName, @"\d+");
        return match.Success && int.TryParse(match.Value, out var n) ? n : null;
    }

    private async Task SelectSeason(DtoTVShowSeason season)
    {
        selectedSeason = season;
        selectedEpisode = season.Episodes?.OrderBy(e => e.Number).FirstOrDefault();
        resumeSeconds = 0;
        showSeasonInfo = true;
        await EnsureEpisodeBackgroundImageAsync();
        await UpdateFavoriteMark();
    }

    private async Task SelectEpisode(DtoTVShowEpisode episode)
    {
        resumeSeconds = 0;
        selectedEpisode = episode;
        await EnsureEpisodeBackgroundImageAsync();
        await UpdateFavoriteMark();
    }

    private async Task SelectEpisodeByKeyboard(KeyboardEventArgs args, DtoTVShowEpisode episode)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
            await SelectEpisode(episode);
    }

    private async Task ShowSeason()
    {
        selectedEpisode = null;
        showSeasonInfo = true;
        await UpdateFavoriteMark();
    }

    private string GetBannerUrl(DtoMediaEntry entry)
        => entry.BannerPictureId.HasValue ? $"/api/pictures/{entry.BannerPictureId}?access_token={Client.AuthorizationToken}" : entry.FanartPictureId.HasValue ? $"/api/pictures/{entry.FanartPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";

    private string GetPosterUrl(DtoMediaEntry entry)
        => entry.PosterPictureId.HasValue ? $"/api/pictures/{entry.PosterPictureId}?access_token={Client.AuthorizationToken}" : entry.FanartPictureId.HasValue ? $"/api/pictures/{entry.FanartPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";

    private void ShowPlayer() => showPlayer = true;

    private async Task HidePlayer()
    {
        if (_player != null)
        {
            try
            {
                var pos = await _player.GetCurrentPositionSecondsAsync();
                resumeSeconds = (long)Math.Floor(pos);
            }
            catch { }
        }
        showPlayer = false;
        StateHasChanged();
    }

    private void AutoPlay(long position)
    {
        resumeSeconds = position;
        ShowPlayer();
    }

    private string GetEpisodeStreamUrl(DtoTVShowEpisode episode)
        => $"/api/items/tvshowepisode/{episode.Id}/stream?access_token={Client.AuthorizationToken}";

    private string GetEpisodeDownloadUrl(DtoTVShowEpisode episode)
        => $"/api/items/tvshowepisode/{episode.Id}/download?access_token={Client.AuthorizationToken}";

    private async Task ToggleFavorite()
    {
        var target = GetFavoriteTarget();
        if (target is null)
            return;

        isFavorite = await Client.ToggleFavorite(target);
        target.IsFavorite = isFavorite;
    }

    private string GetTitle()
        => $"{show?.Name} • {selectedSeason?.Name} {selectedEpisode?.Name}";

    // Neu: Laufende Aktualisierung (optional, falls benötigt)
    private void OnPositionChanged(double seconds)
    {
        resumeSeconds = (long)Math.Floor(seconds);
    }
}

@if (!isAuthenticated)
{
    <PageTitle>Anmeldung erforderlich</PageTitle>
    <div class="alert alert-warning">
        Bitte melden Sie sich an, um Episoden abzuspielen oder herunterzuladen.
    </div>
}
else if (show == null)
{
    <PageTitle>Unbekannt</PageTitle>
    <div class="alert alert-danger">TV-Show nicht gefunden.</div>
}
else
{
    <PageTitle>@(show is null ? "Lädt..." : GetPageTitle())</PageTitle>

    <HeadContent>
        @if (show != null)
        {
            <meta name="description" content="@MetaDescription" />
            <meta name="robots" content="index,follow" />
            <meta property="og:type" content="video.tv_show" />
            <meta property="og:title" content="@GetOgTitle()" />
            <meta property="og:description" content="@MetaDescription" />
            <meta property="og:url" content="@CanonicalUrl" />
            @if (!string.IsNullOrEmpty(ShareImageUrl))
            {
                <meta property="og:image" content="@ShareImageUrl" />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:image" content="@ShareImageUrl" />
            }
            <meta name="twitter:title" content="@GetOgTitle()" />
            <meta name="twitter:description" content="@MetaDescription" />
            <link rel="canonical" href="@CanonicalUrl" />
        }
    </HeadContent>

    @code {
        private string CanonicalUrl => nav.ToAbsoluteUri($"/tvshow/{Id}" +
            (selectedSeason != null ? $"?season={selectedSeason.Id}" : "") +
            (selectedEpisode != null ? $"{(selectedSeason!=null?"&":"?")}episode={selectedEpisode.Id}" : "")).ToString();

        [Inject] private NavigationManager nav { get; set; }

        private string GetPageTitle()
            => selectedEpisode != null
                ? $"{show!.Name} – {selectedSeason?.Name} – {selectedEpisode.Name}"
                : selectedSeason != null
                    ? $"{show!.Name} – {selectedSeason.Name}"
                    : show!.Name;

        private string GetOgTitle()
            => GetPageTitle();

        private string MetaDescription {
            get {
                var raw = selectedEpisode?.Plot
                          ?? selectedSeason?.Show?.Plot
                          ?? show?.Plot
                          ?? show?.GenreNames
                          ?? show?.Name
                          ?? "";
                if (string.IsNullOrWhiteSpace(raw)) return show?.Name ?? "";
                raw = System.Text.RegularExpressions.Regex.Replace(raw, "<.*?>", ""); // falls HTML
                return raw.Length > 200 ? raw[..200] + "…" : raw;
            }
        }

        private string ShareImageUrl {
            get {
                // Für OpenGraph/Twitter besser kein Token im Query (Bots haben keinen).
                // Falls Auth nötig: eigenen anonymen Proxy/Thumb-Endpunkt schaffen.
                var picId = selectedEpisode?.PosterPictureId
                            ?? selectedSeason?.PosterPictureId
                            ?? show?.PosterPictureId
                            ?? selectedEpisode?.FanartPictureId
                            ?? show?.FanartPictureId
                            ?? null;
                if (picId is null) return null;
                // Falls Bilder Auth benötigen: optional öffentlichen Thumb-Endpunkt implementieren.
                return nav.ToAbsoluteUri($"/api/pictures/{picId}").ToString();
            }
        }
    }

    <div class="tvshow-header @(HasGeneratedBackgroundImage() ? "background-with-overlay" : "")" style="background-image: url('@GetHeaderBackgroundUrl()'); position: relative;">
        <button class="favorite-btn" @onclick="ToggleFavorite" title="Als Favorit markieren">
            @(isFavorite ? "★" : "☆")
        </button>
        <div class="tvshow-header-overlay">
            @if (selectedEpisode != null)
            {
                <button class="play-button" @onclick="ShowPlayer" title="Abspielen">
                    <span>&#9654;</span>
                </button>
                <button class="back-arrow" @onclick="ShowSeason" title="Zurück zur Staffel">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                        <path d="M15 6l-6 6 6 6" stroke="#ffe066" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            }
            <div class="tvshow-header-content">
                @if (selectedEpisode != null)
                {
                    <h1>@selectedEpisode.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@selectedEpisode.ReleaseDate?.Year</span>
                        <span class="tvshow-episode-number">Episode @selectedEpisode.Number</span>
                    </div>
                    <div class="tvshow-plot">@selectedEpisode.Plot</div>
                }
                else if (showSeasonInfo && selectedSeason != null)
                {
                    <h1>@show.Name – @selectedSeason.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@selectedSeason.PremieredAt?.Year</span>
                        <span class="tvshow-episode-count">@(selectedSeason.Episodes?.Count() ?? 0) Episoden</span>
                    </div>
                    <div class="tvshow-plot"></div>
                }
                else
                {
                    <h1>@show.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@show.PremieredAt?.Year</span>
                        <span class="tvshow-genres">@show.GenreNames</span>
                    </div>
                    <div class="tvshow-plot">@show.Plot</div>
                }
            </div>
        </div>
    </div>

    <div class="tvshow-content-flex">
        @if (show.Seasons?.Any() == true)
        {
            <div class="season-select-bar">
                <select class="form-select" @onchange="OnSeasonChanged">
                    @foreach (var season in show.Seasons.OrderBy(s => s.Name))
                    {
                        <option value="@season.Id" selected="@(season.Id == selectedSeason?.Id)">@season.Name</option>
                    }
                </select>
                @code {
                    private async Task OnSeasonChanged(ChangeEventArgs e)
                    {
                        if (long.TryParse(e.Value?.ToString(), out var seasonId))
                        {
                            var season = show.Seasons.FirstOrDefault(s => s.Id == seasonId);
                            if (season != null)
                                await SelectSeason(season);
                        }
                    }
                }
            </div>
        }

        @if (selectedSeason != null)
        {
            <div class="episode-list">
                @foreach (var episode in selectedSeason.Episodes.OrderBy(e => e.Number))
                {
                    var isSelected = selectedEpisode?.Id == episode.Id;
                    <div class="episode-box @(isSelected ? "selected" : "")" role="button" tabindex="0" @onclick="() => SelectEpisode(episode)" @onkeydown="args => SelectEpisodeByKeyboard(args, episode)">
                        <img class="episode-poster episode-poster-left" src="@GetPosterUrl(episode)" alt="@episode.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                        <div class="episode-info">
                            <div class="episode-title">@episode.Number ‧ @episode.Name</div>
                            <div class="episode-plot">@episode.Plot</div>
                        </div>
                        <a class="episode-download-btn"
                           href="@GetEpisodeDownloadUrl(episode)"
                           title="Episode herunterladen"
                           @onclick:stopPropagation>
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="10" stroke="#ffe066" stroke-width="2" fill="none" />
                                <path d="M12 7v7m0 0l-3-3m3 3l3-3M7 17h10" stroke="#ffe066" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    @if (showPlayer && selectedEpisode != null)
    {
        <VideoPlayer @ref="_player"
                     Show="showPlayer"
                     StreamUrl="@GetEpisodeStreamUrl(selectedEpisode)"
                     OnClose="HidePlayer"
                     MediaType="episode"
                     MediaId="@selectedEpisode.Id"
                     AuthToken="@Client.AuthorizationToken"
                     StartPositionSeconds="@(resumeSeconds)"
                     PositionChanged="OnPositionChanged" />
    }
}


