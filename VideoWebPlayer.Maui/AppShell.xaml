<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VideoWebPlayer.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VideoWebPlayer.Maui"
    Title="VideoWebPlayer.Maui"
    FlyoutBehavior="Flyout">

    <!-- Top-level flyout item (Home) -->
    <FlyoutItem Title="Home" Icon="dotnet_bot.png">
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <!-- Menu entries shown in the flyout -->
    <MenuItem Text="Einstellungen" Clicked="OnShellSettingsClicked" />

</Shell>
