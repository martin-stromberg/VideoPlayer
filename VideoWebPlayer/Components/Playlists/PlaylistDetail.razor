@page "/playlists/{id:long}"
@using Microsoft.AspNetCore.Components.Authorization
@using VideoWebPlayer.Client.Models
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Playlist</PageTitle>

<section class="media-section">
    <div class="admin-card-header">
        <h1>Playlist</h1>
    </div>

    @if (isLoading)
    {
        <p>Lade Daten...</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" id="playlist-detail-error">@loadError</div>
    }
    else if (playlist is not null)
    {
        <div class="admin-table-wrap">
            <dl>
                <div>
                    <dt>Name</dt>
                    <dd id="playlist-detail-name">@playlist.Name</dd>
                </div>
                <div>
                    <dt>Beschreibung</dt>
                    <dd id="playlist-detail-description">@playlist.Description</dd>
                </div>
                <div>
                    <dt>Sortierung</dt>
                    <dd id="playlist-detail-sortmode">@(playlist.SortMode == PlaylistSortModeValues.Manual ? "Manuell" : "Nach Erscheinungsdatum")</dd>
                </div>
                <div>
                    <dt>Erstellt</dt>
                    <dd id="playlist-detail-created">@playlist.CreatedAt.ToLocalTime()</dd>
                </div>
                <div>
                    <dt>Aktualisiert</dt>
                    <dd id="playlist-detail-updated">@playlist.UpdatedAt.ToLocalTime()</dd>
                </div>
            </dl>
        </div>

        <div class="admin-actions">
            <button class="btn btn-primary playlist-detail-edit-button" @onclick="OpenEditForm">Bearbeiten</button>
            <button class="btn btn-danger playlist-detail-delete-button" @onclick="RequestDelete">Loeschen</button>
            <button class="btn btn-ghost playlist-detail-back-button" @onclick="NavigateToOverview">Zurueck zur Uebersicht</button>
        </div>
    }
</section>

@if (showForm)
{
    <PlaylistForm PlaylistId="editingPlaylistId" OnSave="HandleSavedAsync" OnCancel="HandleCancel" />
}

@if (showDeleteConfirmation)
{
    <PlaylistDeleteConfirmationDialog PlaylistName="@playlist?.Name" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    private DtoPlaylist? playlist;
    private bool isLoading = true;
    private string? loadError;
    private bool showForm;
    private bool showDeleteConfirmation;
    private long? editingPlaylistId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenSilentlyAsync(authState.User);
        await LoadPlaylistAsync();
    }

    private async Task LoadPlaylistAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            playlist = await Client.RequestPlaylistAsync(Id);
            if (playlist is null)
                loadError = "Playlist nicht gefunden.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            loadError = "Zugriff auf diese Playlist verweigert.";
        }
        catch (Exception ex)
        {
            loadError = $"Fehler beim Laden der Playlist: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditForm()
    {
        editingPlaylistId = Id;
        showForm = true;
    }

    private void RequestDelete()
    {
        showDeleteConfirmation = true;
    }

    private async Task HandleSavedAsync()
    {
        showForm = false;
        await LoadPlaylistAsync();
    }

    private void HandleCancel()
    {
        showForm = false;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Client.DeletePlaylistAsync(Id);
            showDeleteConfirmation = false;
            NavigationManager.NavigateTo("/playlists");
        }
        catch (Exception ex)
        {
            loadError = $"Fehler beim Loeschen der Playlist: {ex.Message}";
            showDeleteConfirmation = false;
        }
    }

    private void NavigateToOverview()
    {
        NavigationManager.NavigateTo("/playlists");
    }
}
