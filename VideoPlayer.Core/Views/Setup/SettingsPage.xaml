<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       x:Class="VideoPlayer.Views.Setup.SettingsPage"
                       xmlns:views="clr-namespace:VideoPlayer.Views"
                       xmlns:viewsSetup="clr-namespace:VideoPlayer.Views.Setup"
                       xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Setup"
                       x:DataType="vm:SettingsViewModel"
                       Title="{Binding Title}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <VerticalStackLayout Grid.Column="0" Grid.RowSpan="3">
            <Button Text="Einstellungen"
                    Command="{Binding Navigate}"
                    CommandParameter="Settings"
                    Margin="5"/>
            <Button Text="Medienquellen"
                    Command="{Binding Navigate}"
                    CommandParameter="MediaSources"
                    Margin="5"/>
            <Button Text="Administrative Aufgaben"
                    Command="{Binding Navigate}"
                    CommandParameter="AdminTasks"
                    Margin="5"/>
        </VerticalStackLayout>
        <viewsSetup:AdminTasks 
            Grid.Row="0"
            Grid.Column="1"
            BindingContext="{Binding .}"
            IsVisible="{Binding AdminTasksVisible}"/>
        <viewsSetup:MediaSourcesView
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            BindingContext="{Binding .}"
            IsVisible="{Binding MediaSourcesVisible}"/>
        <viewsSetup:SettingsView
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            BindingContext="{Binding .}"
            IsVisible="{Binding SettingsVisible}"/>
        <Label 
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="{Binding StatusMessage}"
            VerticalOptions="Center" 
            HorizontalOptions="Start" />
    </Grid>

</views:BaseContentPage>