<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyVideoPlayer.ViewModels.Menu"
             xmlns:v="clr-namespace:MyVideoPlayer.Views"
             x:Class="MyVideoPlayer.Views.MenuBand">
    <CollectionView 
        Margin="0"
        ItemsSource="{Binding Actions}"
        x:DataType="vm:MenuViewModel"
        ItemsLayout="HorizontalList">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:MenuAction">
                <Frame Margin="5" Padding="5" BackgroundColor="Green">
                    <Button Opacity="0.9" 
                        Command="{Binding Command}" 
                        Text="{Binding Title}" 
                        BackgroundColor="Silver" 
                        TextColor="Black" 
                        BorderWidth="0" 
                        Margin="5" Padding="2" 
                        HeightRequest="40" 
                        WidthRequest="200"
                        FontSize="Small" />
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
