@page "/live-tv"
@using Microsoft.JSInterop
@using VideoWebPlayer.Client
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Components.Account.Pages.Shared
@using VideoWebPlayer.Components.Playlists
@using VideoWebPlayer.Services
@using VideoWebPlayer.ViewModels
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayerClient Client
@inject IProgramGuideApiClient ProgramGuideClient
@inject ProgramSettingsService ProgramSettings
@inject VideoWebPlayer.Services.StaticAssetVersioner AssetVersions
@inject IJSRuntime JS
@inject ILogger<LiveTv> Logger
@inject TimeProvider TimeProvider
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Live-TV</PageTitle>

@if (!isAuthenticated)
{
    @* Muster Home.razor: nicht angemeldete Anwender erhalten den Login-Dialog statt eines Fehlerbilds. *@
    <LoginForm />
}
else if (isLoading)
{
    <section class="media-section">
        <p id="live-tv-loading">Lade Daten...</p>
    </section>
}
else if (!tvSenderEnabled)
{
    <section class="media-section">
        <div class="alert alert-info" id="live-tv-disabled">Der TV-Sender ist nicht freigeschaltet.</div>
    </section>
}
else if (!tvSenderAccessGranted)
{
    <section class="media-section">
        <div class="alert alert-info" id="live-tv-no-access">@LiveTvErrorMessages.Forbidden</div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="media-section">
        <div class="alert alert-danger" id="live-tv-error">@loadError</div>
    </section>
}
else
{
    <div class="livetv-page">
        <header class="livetv-header">
            <h1>Live-TV</h1>
        </header>

        @* Player links, Programm-Karten rechts/darunter (sendeplan-vorschau.html):
           kompakte program-cards mit Poster, Uhrzeit, Titel und kurzer Beschreibung. *@
        <div class="livetv-layout">
            <div class="livetv-main">
                @* Player-Bereich: bei laufender Sendung das Video (attach via liveTv.js - nativ oder hls.js);
                   bei Sendeluecke die verstaendliche Hinweismeldung. *@
                <div class="livetv-player-wrap">
                    @if (guide?.Now is not null)
                    {
                        <video @ref="_videoRef" id="live-tv-video" class="livetv-video" controls autoplay muted playsinline></video>
                        @if (unsupportedBrowser)
                        {
                            <div class="alert alert-warning livetv-hint" id="live-tv-unsupported">@LiveTvErrorMessages.UnsupportedBrowser</div>
                        }
                        else if (streamError)
                        {
                            <div class="alert alert-warning livetv-hint" id="live-tv-stream-error">@LiveTvErrorMessages.StreamUnavailable</div>
                        }
                    }
                    else
                    {
                        <div class="livetv-gap" id="live-tv-no-program">
                            <strong>@LiveTvErrorMessages.NoProgramRunning</strong>
                            @if (guide?.Next is { } nextGap)
                            {
                                <span>Nächste Sendung um @FormatTime(nextGap.StartUtc): @nextGap.Title</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="livetv-side">
                @if (guide?.Now is { } nowEntry)
                {
                    <span class="livetv-kicker">Jetzt läuft</span>
                    <section class="program-card compact now-card" id="live-tv-now">
                        <div class="program-poster"><img src="@PosterUrl(nowEntry)" alt="" /></div>
                        <div class="program-body">
                            <span class="program-badge badge-live">Live</span>
                            <span class="program-time">
                                @FormatTime(nowEntry.StartUtc)&nbsp;–&nbsp;@FormatTime(nowEntry.EndUtc)
                                @if (nowEntry.RemainingSeconds is { } remaining)
                                {
                                    <text>&nbsp;(noch @FormatDuration(remaining))</text>
                                }
                            </span>
                            <span class="program-title" id="live-tv-now-title">@CardTitle(nowEntry)</span>
                            @if (CardSub(nowEntry) is { } nowSub)
                            {
                                <span class="program-sub">@nowSub</span>
                            }
                            <p class="program-desc">@Desc(nowEntry)</p>
                            @if (nowEntry.PositionSeconds is { } position && nowEntry.DurationSeconds > 0)
                            {
                                <div class="progress-track" aria-hidden="true">
                                    <div class="progress-fill" style="width:@CssFormat.Percent(ProgressPercent(position, nowEntry.DurationSeconds))"></div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (guide?.Next is { } nextEntry)
                {
                    <span class="livetv-kicker">Gleich</span>
                    <section class="program-card compact" id="live-tv-next">
                        <div class="program-poster"><img src="@PosterUrl(nextEntry)" alt="" /></div>
                        <div class="program-body">
                            <span class="program-time">@FormatTime(nextEntry.StartUtc)</span>
                            <span class="program-title">@CardTitle(nextEntry)</span>
                            @if (CardSub(nextEntry) is { } nextSub)
                            {
                                <span class="program-sub">@nextSub</span>
                            }
                        </div>
                    </section>
                }

                @if (upcoming.Length > 0)
                {
                    <span class="livetv-kicker">Die nächsten Stunden</span>
                    <ul class="livetv-upcoming-list" id="live-tv-upcoming">
                        @foreach (var entry in upcoming)
                        {
                            <li class="livetv-upcoming-row program-card compact" data-slot-id="@entry.SlotId">
                                <div class="program-poster"><img src="@PosterUrl(entry)" alt="" /></div>
                                <div class="program-body">
                                    <span class="program-time">@FormatTime(entry.StartUtc)</span>
                                    <span class="program-title">@CardTitle(entry)</span>
                                    @if (CardSub(entry) is { } sub)
                                    {
                                        <span class="program-sub">@sub</span>
                                    }
                                    <p class="program-desc">@Desc(entry)</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    private const int PreviewHours = 6;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(15);

    private bool isAuthenticated;
    private bool tvSenderEnabled;
    private bool tvSenderAccessGranted;
    private bool isLoading = true;
    private string? loadError;
    private bool streamError;
    private bool unsupportedBrowser;

    private DtoProgramGuideNow? guide;
    private DtoProgramGuideEntry[] upcoming = [];

    private ElementReference _videoRef;
    private DotNetObjectReference<LiveTv>? _dotNetRef;
    private long? _attachedSlotId;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollTask;

    private string? StreamUrl
        => string.IsNullOrWhiteSpace(Client.AuthorizationToken)
            ? null
            : $"/api/live-stream/live.m3u8?access_token={Uri.EscapeDataString(Client.AuthorizationToken)}";

    private string HlsScriptUrl => AssetVersions.Url("js/vendor/hls.min.js");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        if (!isAuthenticated)
        {
            isLoading = false;
            return;
        }

        await Client.EnsureAuthorizationTokenSilentlyAsync(auth.User);
        // N28: erst das globale Flag, dann die Benutzer-Freigabe (Admins implizit) — ohne
        // Freigabe wird kein Guide-Aufruf gestartet.
        tvSenderEnabled = await ProgramSettings.GetTvSenderEnabledAsync();
        if (tvSenderEnabled)
        {
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            tvSenderAccessGranted = await ProgramSettings.IsTvSenderAccessGrantedAsync(
                userId, auth.User.HasClaim("IsAdmin", "True"));
        }
        if (tvSenderAccessGranted)
            await RefreshGuideAsync(isInitial: true);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isAuthenticated || !tvSenderEnabled || !tvSenderAccessGranted)
            return;

        // Die Aktualisierungsschleife wird erst auf der interaktiven Instanz gestartet —
        // OnInitializedAsync laeuft auch beim Prerender, dessen Wegwerf-Instanz nie disposed
        // wird und sonst einen Timer fuer den Prozessrest mitschleppt.
        if (firstRender)
            _pollTask = PollLoopAsync();

        var currentSlotId = guide?.Now?.SlotId;
        if (currentSlotId == _attachedSlotId)
            return;

        if (_attachedSlotId is not null)
            await DetachPlayerAsync();

        if (currentSlotId is not null && _videoRef.Context != null && StreamUrl is { } streamUrl)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            streamError = false;
            unsupportedBrowser = false;
            _attachedSlotId = currentSlotId;
            await JS.InvokeVoidAsync("liveTv.attach", _videoRef, streamUrl, HlsScriptUrl, _dotNetRef);
        }
        else
        {
            _attachedSlotId = null;
        }
    }

    private async Task PollLoopAsync()
    {
        _timer = new PeriodicTimer(PollInterval, TimeProvider);
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                try
                {
                    // Datenabruf darf auf dem Hintergrundthread laufen; nur das Rendern geht ueber den
                    // Dispatcher. Ein einzelner fehlschlagender Tick beendet die Schleife nicht.
                    await RefreshGuideAsync(isInitial: false);
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Live-TV-Aktualisierung fehlgeschlagen; wird erneut versucht.");
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler in der Live-TV-Aktualisierungsschleife");
        }
    }

    /// <summary>
    /// Laedt Jetzt/Gleich und die Vorschau. Beim ersten Laden entscheidet ein Fehler ueber die
    /// Fehleranzeige; bei den Timer-Laeufen bleibt der letzte Stand sichtbar und es wird erneut
    /// versucht (stiller Retry), damit ein kurzer Aussetzer die Ansicht nicht leerraeumt.
    /// </summary>
    private async Task RefreshGuideAsync(bool isInitial)
    {
        // Jetzt/Gleich und Vorschau werden unabhaengig geholt: scheitert einer der beiden
        // Aufrufe dauerhaft, aktualisiert sich der andere Bereich trotzdem weiter —
        // ein gekoppelter Abruf wuerde die Upcoming-Liste bei einem `now`-Fehler einfrieren.
        try
        {
            guide = await ProgramGuideClient.RequestProgramGuideNowAsync(_cts.Token);
            if (isInitial)
                loadError = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Programmauskunft (Jetzt/Gleich) fuer Live-TV konnte nicht geladen werden.");
            if (isInitial)
            {
                loadError = LiveTvErrorMessages.Describe(ex) ?? LiveTvErrorMessages.LoadFailed;
                return; // wie zuvor: beim Initialfehler wird nichts Weiteres geholt
            }
        }

        try
        {
            upcoming = await ProgramGuideClient.RequestProgramGuideUpcomingAsync(PreviewHours, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Programmvorschau fuer Live-TV konnte nicht geladen werden.");
            if (isInitial)
                loadError = LiveTvErrorMessages.Describe(ex) ?? LiveTvErrorMessages.LoadFailed;
        }
    }

    private async Task DetachPlayerAsync()
    {
        try { await JS.InvokeVoidAsync("liveTv.detach", _videoRef); } catch { }
        _attachedSlotId = null;
    }

    [JSInvokable]
    public Task NotifyStreamPlaying()
    {
        streamError = false;
        unsupportedBrowser = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task NotifyStreamError(string kind)
    {
        streamError = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task NotifyStreamUnsupported()
    {
        unsupportedBrowser = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Bei Serien traegt die Karte den Serientitel als Hauptzeile, die Episoden-Kurzinfo als
    // Unterzeile ("S6 E42"); Filme und namentlich aufgeloeste Clips zeigen den Guide-Titel.
    private static string CardTitle(DtoProgramGuideEntry entry) => entry.ShowName ?? entry.Title;

    private static string? CardSub(DtoProgramGuideEntry entry)
        => ProgramGuideEntryText.ShortSubtitle(entry.SeasonNumber, entry.EpisodeNumber);

    private static string Desc(DtoProgramGuideEntry entry)
        => entry.Description ?? ProgramGuideEntryText.NoDescriptionText;

    private string PosterUrl(DtoProgramGuideEntry entry)
        => MediaPictureUrlResolver.Resolve(entry.PosterPictureId, Client.AuthorizationToken);

    private static string FormatTime(DateTimeOffset utc) => utc.ToLocalTime().ToString("HH:mm");

    private static string FormatDuration(double seconds)
    {
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours} Std. {span.Minutes} Min."
            : $"{Math.Max(1, span.Minutes)} Min.";
    }

    // Gibt den nackten Prozentwert als double zurueck; die CSS-Einbettung formatiert ueber
    // CssFormat.Percent invariant — sonst landet unter de-DE ein Komma im style-Attribut
    // ("width:59,38%"), das der Browser verwirft und den Balken voll wirken laesst.
    private static double ProgressPercent(double position, double duration)
        => Math.Clamp(position / duration * 100d, 0d, 100d);

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch { }
        }
        if (_attachedSlotId is not null)
            await DetachPlayerAsync();
        _dotNetRef?.Dispose();
        _cts.Dispose();
    }
}
