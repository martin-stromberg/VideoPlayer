@page "/playlists/{id:long}"
@using Microsoft.AspNetCore.Components.Authorization
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.ViewModels
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject VideoWebPlayer.Client.IPlaylistApiClient PlaylistClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<PlaylistDetail> Logger
@rendermode InteractiveServer

<PageTitle>Playlist</PageTitle>

@if (isLoading)
{
    <section class="media-section">
        <p>Lade Daten...</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="media-section">
        <div class="alert alert-danger" id="playlist-detail-error">@loadError</div>
    </section>
}
else if (playlist is not null)
{
    @* Kopfbereich mit Hintergrundbild, angelehnt an die Detailansichten von Filmen/Serien (TVShowDetails,
       MovieCollectionDetails). Playlists haben noch kein eigenes Coverbild (siehe PlaylistCoverPlaceholder),
       daher ein generischer, aus der Playlist-Id abgeleiteter Platzhalter-Hintergrund statt eines echten Fotos. *@
    <div class="tvshow-header playlist-header-fallback">
        <PlaylistCoverPlaceholder PlaylistId="Id" CssClass="playlist-header-cover" />

        <button class="back-arrow playlist-detail-back-button" @onclick="NavigateToOverview" title="Zurueck zur Uebersicht">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M15 6l-6 6 6 6" stroke="#ffe066" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="metadata-action-bar">
            <button class="metadata-icon-btn playlist-detail-edit-button" @onclick="OpenEditForm" title="Bearbeiten">✎</button>
            <button class="metadata-icon-btn playlist-detail-delete-button" @onclick="RequestDelete" title="Loeschen">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /></svg>
            </button>
        </div>

        <div class="tvshow-header-overlay">
            <div class="tvshow-header-content">
                <h1 id="playlist-detail-name">@playlist.Name</h1>
                <div class="tvshow-meta playlist-detail-meta">
                    <span class="playlist-sortmode-badge">
                        <PlaylistSortModeIcon SortMode="playlist.SortMode" />
                        <span id="playlist-detail-sortmode">@PlaylistSortModeValues.GetDisplayLabel(playlist.SortMode)</span>
                    </span>
                    <button class="metadata-icon-btn playlist-sortmode-toggle-button" @onclick="ToggleSortModeAsync" title="@SortModeToggleTitle">
                        <PlaylistSortModeIcon SortMode="selectedSortMode" Size="18" />
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(playlist.Description))
                {
                    <div class="tvshow-plot" id="playlist-detail-description">@playlist.Description</div>
                }
                else
                {
                    <div class="tvshow-plot" id="playlist-detail-description"></div>
                }
                <div class="playlist-detail-genres-row">
                    @if (playlist.Genres.Length > 0)
                    {
                        <span class="playlist-genres-line" id="playlist-detail-genres">@string.Join(", ", playlist.Genres.Select(g => g.Name))</span>
                    }
                    @if (playlist.GenresManuallyOverridden)
                    {
                        <span class="playlist-genre-override-badge" id="playlist-detail-genres-override-badge">Manuell festgelegt</span>
                    }
                    <span class="playlist-genre-actions">
                        <button class="metadata-icon-btn playlist-genre-edit-button" id="playlist-detail-edit-genres-button" @onclick="OpenGenreEditor" title="Genres bearbeiten">✎</button>
                        @if (playlist.GenresManuallyOverridden)
                        {
                            <button class="metadata-icon-btn playlist-genre-reset-button" id="playlist-detail-reset-genres-button" @onclick="ResetGenresAsync" title="Auf automatische Genres zuruecksetzen">↺</button>
                        }
                    </span>
                </div>
                <div class="playlist-detail-dates-muted">
                    <span id="playlist-detail-created"><span class="playlist-detail-date-label">Erstellt</span>@playlist.CreatedAt.ToLocalTime()</span>
                    <span id="playlist-detail-updated"><span class="playlist-detail-date-label">Aktualisiert</span>@playlist.UpdatedAt.ToLocalTime()</span>
                </div>
            </div>
        </div>
    </div>

    <section class="media-section">
        @if (!string.IsNullOrWhiteSpace(sortModeStatusMessage))
        {
            <div class="alert alert-danger" id="playlist-sortmode-status">@sortModeStatusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(genreStatusMessage))
        {
            <div class="alert alert-danger" id="playlist-genre-status">@genreStatusMessage</div>
        }

        <PlaylistEntriesList @ref="entriesList" PlaylistId="Id" IsManualMode="IsManualMode" OnPlayEntry="PlayEntryAsync" />

        @if (!string.IsNullOrWhiteSpace(playbackError))
        {
            <div class="alert alert-danger" id="playlist-playback-error">@playbackError</div>
        }
    </section>
}

@if (playbackStart is not null)
{
    <VideoPlayer Show="true"
                 StreamUrl="@playbackStart.StreamUrl"
                 OnClose="ClosePlayerAsync"
                 MediaType="@playbackStart.MediaType"
                 MediaId="@playbackStart.MediaId"
                 AuthToken="@Client.AuthorizationToken"
                 AutoPlay="true"
                 StartPositionSeconds="@playbackStart.StartPositionSeconds"
                 PlaylistContext="new PlaylistPlaybackContext(playbackStart.PlaylistId, playbackStart.CurrentEntryId, playbackStart.TotalCount, playbackStart.PlaylistName)"
                 CurrentPlaylistPosition="playbackStart.CurrentPosition"
                 CurrentPlaylistEntryIdChanged="OnPlaylistEntryIdChanged" />
}

@if (formState.IsOpen)
{
    <PlaylistForm PlaylistId="formState.EditingId" OnSave="HandleSavedAsync" OnCancel="HandleCancel" />
}

@if (deleteState.Pending is not null)
{
    <PlaylistDeleteConfirmationDialog PlaylistName="@deleteState.Pending.Name" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
}

@if (showSortModeConfirmation)
{
    <PlaylistSortModeConfirmationDialog OnConfirm="ConfirmSortModeChangeAsync" OnCancel="CancelSortModeChange" />
}

@if (showGenreEditor && playlist is not null)
{
    <PlaylistGenreEditor PlaylistId="Id" InitialGenreIds="playlist.AllGenreIds" OnSaved="HandleGenresSavedAsync" OnCancel="CloseGenreEditor" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    /// <summary>
    /// Optional playlist entry to resume playback at, supplied via the <c>?entryId=</c> URL query
    /// parameter. Populated on initial navigation from <see cref="PlaylistEntriesList.OnPlayEntry"/> and
    /// kept in sync with the currently playing entry (see <see cref="OnPlaylistEntryIdChanged"/>) so
    /// a browser reload during playlist playback resumes at the same entry (Af-010).
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "entryId")]
    public long? EntryId { get; set; }

    private DtoPlaylist? playlist;
    private bool isLoading = true;
    private string? loadError;
    private readonly PlaylistFormState formState = new();
    private readonly PlaylistDeletePendingState deleteState = new();
    private string selectedSortMode = PlaylistSortModeValues.ByReleaseDate;
    private bool showSortModeConfirmation;
    private string? sortModeStatusMessage;
    private bool showGenreEditor;
    private string? genreStatusMessage;
    private PlaylistEntriesList? entriesList;
    private DtoPlaylistPlaybackStart? playbackStart;

    /// <summary>
    /// Error from a failed <see cref="StartPlaybackAsync"/> call (e.g. the requested entry is locked or
    /// a non-playable collection entry), kept separate from <see cref="loadError"/> - which means the
    /// playlist's own metadata failed to load and, per the page's exclusive if/else-if rendering chain,
    /// replaces the entire detail page. A playback-start failure should instead leave the already-loaded
    /// playlist and its entries visible, with just an inline error shown below them, so the user can pick
    /// a different entry without a page reload.
    /// </summary>
    private string? playbackError;

    private bool IsManualMode => playlist?.SortMode == PlaylistSortModeValues.Manual;

    /// <summary>
    /// The sort mode a click on <see cref="ToggleSortModeAsync"/>'s icon button would switch to - the
    /// mode the toggle currently does NOT show, of the two supported <see cref="PlaylistSortModeValues"/>.
    /// </summary>
    private string OtherSortMode
        => selectedSortMode == PlaylistSortModeValues.Manual ? PlaylistSortModeValues.ByReleaseDate : PlaylistSortModeValues.Manual;

    private string SortModeToggleTitle
        => $"Sortierung wechseln zu \"{PlaylistSortModeValues.GetDisplayLabel(OtherSortMode)}\"";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenSilentlyAsync(authState.User);
        await LoadPlaylistAsync();

        if (EntryId.HasValue)
            await StartPlaybackAsync(EntryId);
    }

    private async Task PlayEntryAsync(DtoPlaylistEntry entry)
        => await StartPlaybackAsync(entry.Id);

    private async Task StartPlaybackAsync(long? entryId)
    {
        try
        {
            playbackStart = await PlaylistClient.StartPlaylistAsync(Id, entryId);
            // Append the access token once here, so playbackStart.StreamUrl is always ready-to-use both
            // for this initial render and for later Next/Previous/Advance updates in OnPlaylistEntryIdChanged.
            playbackStart.StreamUrl = $"{playbackStart.StreamUrl}?access_token={Client.AuthorizationToken}";
            playbackError = null;
            NavigationManager.NavigateTo($"/playlists/{Id}?entryId={playbackStart.CurrentEntryId}", replace: true);
        }
        catch (Exception ex)
        {
            // Sets playbackError (not loadError) and does not navigate: the playlist itself loaded fine,
            // only starting playback at this entry failed (e.g. it is locked or a non-playable collection
            // entry), so the detail page including its entries list must stay visible - see playbackError.
            Logger.LogWarning(ex, "Fehler beim Starten der Wiedergabe von Playlist {PlaylistId}", Id);
            playbackError = $"Fehler beim Starten der Wiedergabe: {ex.Message}";
        }
    }

    private Task ClosePlayerAsync()
    {
        playbackStart = null;
        playbackError = null;
        NavigationManager.NavigateTo($"/playlists/{Id}", replace: true);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Updates the locally held <see cref="playbackStart"/> from the stream information <see cref="VideoPlayer"/>
    /// already resolved for its new current entry (Next/Previous/Advance/Restart), rather than re-deriving
    /// the stream URL here - which would be stale relative to what VideoPlayer is actually displaying and
    /// would overwrite it on the next render this NavigateTo call triggers (see
    /// <see cref="VideoPlayer.CurrentPlaylistEntryIdChanged"/>). <paramref name="info"/> now also carries the
    /// new entry's playlist-specific <c>StartPositionSeconds</c> directly (resolved server-side together with
    /// the entry itself), so this handler is purely synchronous - deliberately so: an earlier version fetched
    /// <c>StartPositionSeconds</c> here via a separate <see cref="VideoWebPlayer.Client.IPlaylistApiClient.StartPlaylistAsync"/>
    /// roundtrip, and Blazor Server renders as soon as an async event handler reaches its first <c>await</c>,
    /// so <see cref="VideoPlayer"/> observed the new <c>StreamUrl</c> together with the still-stale previous
    /// <c>StartPositionSeconds</c> in that intermediate render and applied it before the roundtrip resolved.
    /// With no <c>await</c> in this method, all of <see cref="playbackStart"/>'s fields update atomically
    /// within the single render triggered by the originating event, closing that window entirely.
    /// </summary>
    private void OnPlaylistEntryIdChanged(VideoPlayer.PlaylistEntryPlaybackInfo info)
    {
        if (playbackStart is not null)
        {
            playbackStart.CurrentEntryId = info.EntryId;
            playbackStart.MediaType = info.PlayerMediaType;
            playbackStart.MediaId = info.MediaId;
            playbackStart.StreamUrl = info.StreamUrl;
            playbackStart.StartPositionSeconds = info.StartPositionSeconds;
        }

        NavigationManager.NavigateTo($"/playlists/{Id}?entryId={info.EntryId}", replace: true);
    }

    private async Task LoadPlaylistAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            playlist = await PlaylistClient.RequestPlaylistAsync(Id);
            if (playlist is null)
                loadError = "Playlist nicht gefunden.";
            else
                selectedSortMode = playlist.SortMode;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            Logger.LogWarning(ex, "Zugriff auf Playlist {PlaylistId} verweigert", Id);
            loadError = "Zugriff auf diese Playlist verweigert.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fehler beim Laden der Playlist {PlaylistId}", Id);
            loadError = $"Fehler beim Laden der Playlist: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditForm()
    {
        formState.OpenForEdit(Id);
    }

    private void RequestDelete()
    {
        if (playlist is not null)
            deleteState.Request(playlist);
    }

    private async Task HandleSavedAsync()
    {
        formState.Close();
        await LoadPlaylistAsync();
    }

    private void HandleCancel()
    {
        formState.Close();
    }

    private void CancelDelete()
    {
        deleteState.Cancel();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteState.Pending is null)
            return;

        try
        {
            await PlaylistClient.DeletePlaylistAsync(deleteState.Pending.Id);
            deleteState.Cancel();
            NavigationManager.NavigateTo("/playlists");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fehler beim Loeschen der Playlist {PlaylistId}", Id);
            loadError = $"Fehler beim Loeschen der Playlist: {ex.Message}";
            deleteState.Cancel();
        }
    }

    private void NavigateToOverview()
    {
        NavigationManager.NavigateTo("/playlists");
    }

    /// <summary>
    /// Resets <see cref="sortModeStatusMessage"/>, runs <paramref name="action"/>, and on failure sets it
    /// from the exception - unless <paramref name="handleSpecialError"/> is given and fully handles the
    /// exception itself (returning <see langword="true"/>), e.g. to show the confirmation dialog instead
    /// of an error. Mirrors <c>PlaylistEntriesList.RunEntryActionAsync</c> for the sort-mode-change
    /// workflow, which stays on this component since it owns <see cref="playlist"/>.
    /// </summary>
    private async Task RunSortModeActionAsync(Func<Task> action, string errorPrefix, Func<Exception, bool>? handleSpecialError = null)
    {
        sortModeStatusMessage = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            if (handleSpecialError?.Invoke(ex) == true)
                return;

            Logger.LogWarning(ex, "{ErrorPrefix} (Playlist {PlaylistId})", errorPrefix, Id);
            sortModeStatusMessage = $"{errorPrefix}: {ex.Message}";
        }
    }

    /// <summary>
    /// Handles the sort-mode-toggle icon button (replacing the former dropdown + "Anwenden" button, per
    /// Kundenfeedback: "Der Wechsel zwischen den beiden Sortiermethoden soll ... ueber ein Symbolbutton
    /// mit Sicherheitsabfrage erfolgen"): switches directly to <see cref="OtherSortMode"/> - the only other
    /// value, since exactly two sort modes exist - and applies it via the existing
    /// <see cref="ApplySortModeAsync"/> flow, which already shows <see cref="PlaylistSortModeConfirmationDialog"/>
    /// (the pre-existing "Sicherheitsabfrage") when switching away from Manual would lose the manual order.
    /// </summary>
    private Task ToggleSortModeAsync()
    {
        selectedSortMode = OtherSortMode;
        return ApplySortModeAsync();
    }

    private Task ApplySortModeAsync()
        => RunSortModeActionAsync(async () =>
        {
            playlist = await PlaylistClient.ChangeSortModeAsync(Id, new DtoChangeSortModeRequest
            {
                NewSortMode = selectedSortMode,
                ConfirmLossOfManualOrder = false
            });
            await ReloadEntriesAsync();
        }, "Fehler beim Aendern des Sortiermodus", ex =>
        {
            if (ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                showSortModeConfirmation = true;
                return true;
            }
            return false;
        });

    private Task ConfirmSortModeChangeAsync()
    {
        showSortModeConfirmation = false;
        return RunSortModeActionAsync(async () =>
        {
            playlist = await PlaylistClient.ChangeSortModeAsync(Id, new DtoChangeSortModeRequest
            {
                NewSortMode = selectedSortMode,
                ConfirmLossOfManualOrder = true
            });
            await ReloadEntriesAsync();
        }, "Fehler beim Aendern des Sortiermodus");
    }

    private void CancelSortModeChange()
    {
        showSortModeConfirmation = false;
        selectedSortMode = playlist?.SortMode ?? PlaylistSortModeValues.ByReleaseDate;
    }

    private Task ReloadEntriesAsync()
        => entriesList is not null ? entriesList.ReloadAsync() : Task.CompletedTask;

    private void OpenGenreEditor()
    {
        genreStatusMessage = null;
        showGenreEditor = true;
    }

    private void CloseGenreEditor()
    {
        showGenreEditor = false;
    }

    private Task HandleGenresSavedAsync(DtoPlaylist updated)
    {
        playlist = updated;
        showGenreEditor = false;
        return Task.CompletedTask;
    }

    private async Task ResetGenresAsync()
    {
        genreStatusMessage = null;
        try
        {
            playlist = await PlaylistClient.ResetPlaylistGenresAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fehler beim Zuruecksetzen der Genres von Playlist {PlaylistId}", Id);
            genreStatusMessage = $"Fehler beim Zuruecksetzen der Genres: {ex.Message}";
        }
    }
}
