<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             xmlns:components="clr-namespace:VideoWebPlayer.Maui.Components"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VideoWebPlayer.Maui.TVShowDetailsPage"
             x:DataType="viewmodels:TVShowDetailsViewModel"
             BackgroundColor="#000000">
    <components:PageChrome HeaderTitle="{Binding Title}">
		<components:PageChrome.HeaderActions>
			<HorizontalStackLayout Spacing="10"
			                      HorizontalOptions="End"
			                      VerticalOptions="Center">
				<Button Text="←"
				        FontSize="18"
				        BackgroundColor="#FFB84D"
				        TextColor="#000000"
				        CornerRadius="8"
				        Padding="15,8"
				        Clicked="OnBackClicked" />

				<Button Text="{Binding SelectionFavoriteStarText}"
				        FontSize="18"
				        CornerRadius="8"
				        Padding="15,8"
				        Clicked="OnToggleShowFavoriteClicked">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding IsSelectionFavorite}" Value="True">
							<Setter Property="BackgroundColor" Value="#FFB84D" />
							<Setter Property="TextColor" Value="#000000" />
						</DataTrigger>
						<DataTrigger TargetType="Button" Binding="{Binding IsSelectionFavorite}" Value="False">
							<Setter Property="BackgroundColor" Value="#23232a" />
							<Setter Property="TextColor" Value="#FFB84D" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
			</HorizontalStackLayout>
		</components:PageChrome.HeaderActions>

        <components:PageChrome.Body>
			<!-- Add bottom padding so content doesn't overlap the fixed footer and avoid vertical stretching -->
			<ScrollView Padding="0,0,0,80">
				<VerticalStackLayout Spacing="20" Padding="20,10,20,20" VerticalOptions="Start">
                <!-- MediaBannerPlayer Component -->
                <components:MediaBannerPlayer />
                
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="{Binding ReleaseYear}" FontSize="14" TextColor="#333333" FontAttributes="Bold" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="|" FontSize="14" TextColor="#333333" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding GenreNames}" FontSize="14" TextColor="#333333" FontAttributes="Bold" />
                    <Label Text="|" FontSize="14" TextColor="#333333" IsVisible="{Binding SelectedEpisodeName, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding SelectedEpisodeName}" FontSize="14" TextColor="#333333" FontAttributes="Bold" IsVisible="{Binding SelectedEpisodeName, Converter={StaticResource IsNotNullConverter}}" />
                </StackLayout>
                <Label Text="{Binding Plot}" FontSize="14" TextColor="#555555" LineBreakMode="WordWrap" />
				<Picker Title="Staffel wählen" ItemsSource="{Binding Seasons}" ItemDisplayBinding="{Binding Name}" SelectedIndex="{Binding SelectedSeasonIndex}" TitleColor="#000000" TextColor="#FFDDAA" BackgroundColor="#23232a" />
                <CollectionView ItemsSource="{Binding Episodes}" 
								SelectionMode="Single"
								SelectedItem="{Binding SelectedEpisode}"
								SelectionChanged="OnEpisodeSelectionChanged"
								VerticalOptions="Start">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TVShowEpisodeViewModel">
                            <Border StrokeThickness="0" BackgroundColor="#23232a" Padding="10" Margin="0,0,0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
							<Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="80" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#FFDDAA" />
                                        <Label Text="{Binding Plot}" FontSize="12" TextColor="#CCCCCC" LineBreakMode="WordWrap" MaxLines="3" />
                                    </VerticalStackLayout>
                                    
								<HorizontalStackLayout Grid.Column="2"
								                      Spacing="10"
								                      VerticalOptions="Center">
									<!-- Download Button -->
									<Grid WidthRequest="40"
									      HeightRequest="40"
									      VerticalOptions="Center">
										<!-- Download -->
										<Border BackgroundColor="#4CAF50">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="20" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Tapped="OnDownloadEpisodeTapped" />
											</Border.GestureRecognizers>
											<Border.Triggers>
												<DataTrigger TargetType="Border" Binding="{Binding IsDownloaded}" Value="True">
													<Setter Property="IsVisible" Value="False" />
												</DataTrigger>
											</Border.Triggers>
											<Label Text="⬇"
											       FontSize="24"
											       TextColor="White"
											       HorizontalOptions="Center"
											       VerticalOptions="Center" />
										</Border>

										<!-- Remove download -->
										<Border BackgroundColor="#E53935"
										        IsVisible="False">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="20" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Tapped="OnRemoveDownloadEpisodeTapped" />
											</Border.GestureRecognizers>
											<Border.Triggers>
												<DataTrigger TargetType="Border" Binding="{Binding IsDownloaded}" Value="True">
													<Setter Property="IsVisible" Value="True" />
												</DataTrigger>
											</Border.Triggers>
											<Label Text="🗑"
											       FontSize="20"
											       TextColor="White"
											       HorizontalOptions="Center"
											       VerticalOptions="Center" />
										</Border>
									</Grid>
								</HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
			</ScrollView>
		</components:PageChrome.Body>

		<components:PageChrome.Footer>
			<components:NotificationTicker Margin="20,0" />
		</components:PageChrome.Footer>
	</components:PageChrome>
</ContentPage>
