<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VideoPlayer.Views.Homepage.HomePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Homepage;assembly=VideoPlayerMaui"
    xmlns:vw="clr-namespace:VideoPlayer.Views.Homepage"
    x:DataType="vm:HomePageViewModel">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="0">
            <vw:CategorySelection/>
            <Label 
                Text="Weiterschauen" 
                FontSize="Title"
                VerticalOptions="Start"/>
            <vw:HorizontalMediaItemCollection 
                HeightRequest="210"
                BindingContext="{Binding LatestViews}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>