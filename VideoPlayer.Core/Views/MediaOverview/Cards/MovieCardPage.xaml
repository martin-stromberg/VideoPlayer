<?xml version="1.0" encoding="utf-8" ?>
<view:BaseCardPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:view="clr-namespace:VideoPlayer.Views.MediaOverview.Cards"
                   xmlns:vm="clr-namespace:VideoPlayer.ViewModels.MediaOverview.Cards"
                   xmlns:video="clr-namespace:VideoPlayer.Views.Video"
                   xmlns:common="clr-namespace:VideoPlayer.Views.Common"
                   x:Class="VideoPlayer.Views.MediaOverview.Cards.MovieCardPage"
                   x:DataType="vm:BaseMediaItemCardViewModel"                   
                   Title="{Binding Title}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Background Box -->
        <Frame Grid.ColumnSpan="2"
               BackgroundColor="{Binding PictureBackgroundColor}" 
               BorderColor="{Binding PictureBackgroundColor}"/>
        <!-- Background Image -->
        <Image Grid.ColumnSpan="2"
               Source="{Binding Picture}" 
               IsVisible="{Binding PictureVisible}" 
               Opacity="0.6"
               HorizontalOptions="End"/>
        <!-- Media Information -->
        <VerticalStackLayout HorizontalOptions="Start" Margin="5,5">
            <Label Text="{Binding Title}" 
                   FontSize="Header"
                   TextColor="{Binding PictureTextColor}"/>
            <Label TextColor="{Binding PictureTextColor}"
                   FontSize="Small">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0} · {1}">
                        <Binding Path="Year"/>
                        <Binding Path="Genres"/>
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Label Text="{Binding Plot}" 
                   TextColor="{Binding PictureTextColor}"
                   LineBreakMode="WordWrap"
                   Margin="0,10"/>
        </VerticalStackLayout>
        <!-- Playback Button -->
        <Frame Grid.ColumnSpan="2"
               BorderColor="Silver"
               Opacity="0.4"
               HorizontalOptions="Center" 
               VerticalOptions="Center">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </Frame.GestureRecognizers>
            <ImageButton Source="movie_collection32x32.png"                         
                         Command="{Binding PlaybackCommand}"/>
        </Frame>
        <VerticalStackLayout IsVisible="false"
                             x:Name="PanelRename"
                             Grid.ColumnSpan="2"
                             Grid.Row="0"
                             BackgroundColor="Black">
            <Entry x:Name="EditRename"
                   VerticalOptions="Start"
                   HorizontalOptions="FillAndExpand"/>
        </VerticalStackLayout>
        
        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Column="1">
            <ImageButton Source="edit64x64.png"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         IsVisible="{Binding CanEdit}"
                         Clicked="ImageButton_Clicked"
                         CommandParameter="rename"/>
            <ImageButton Source="delete64x64.png"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         IsVisible="{Binding HasDownload}"
                         Command="{Binding ActionCommand}"
                         CommandParameter="delete"/>
            <ImageButton Source="download64x64.png"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         IsVisible="{Binding HasNoDownload}"
                         Command="{Binding ActionCommand}"
                         CommandParameter="download"
                         Margin="0,0,0,5"/> 
            <ImageButton Source="classification64x64.png"
                         Margin="0,5,0,0"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Command="{Binding ActionCommand}"
                         CommandParameter="rescan"/>
            <ImageButton Source="rescan64x64.png"
                         Margin="0,5,0,0"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Command="{Binding ActionCommand}"
                         CommandParameter="reload"/>
        </VerticalStackLayout>
        <video:VideoPlayerView Grid.ColumnSpan="2"
                               IsVisible="{Binding VideoPlayerVisible}"/>

        <ScrollView Grid.Row="1"  
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2">
            <VerticalStackLayout>
                <common:HorizontalMediaCollectionView BindingContext="{Binding CollectionContext}"/>
            </VerticalStackLayout>
        </ScrollView>
        <Label  Grid.Row="2"
                Grid.ColumnSpan="2"
                Text="{Binding Message}" 
                IsVisible="{Binding HasMessage}"/>
    </Grid>
</view:BaseCardPage>