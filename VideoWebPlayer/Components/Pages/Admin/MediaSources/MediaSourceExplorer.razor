@page "/admin/mediasources/{SourceId:long}/explorer"
@using Microsoft.EntityFrameworkCore
@using VideoWebPlayer.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Services.MediaSourceScanner MediaSourceScanner
@inject VideoWebPlayer.Services.MediaSourceClassifier MediaSourceClassifier
@inject ILogger<MediaSourceExplorer> Logger
@inject VideoWebPlayer.Services.Backups.IBackgroundProcessingGate BackgroundGate
@rendermode InteractiveServer

<PageTitle>Dateiexplorer</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        @if (!isAdmin)
        {
            <div class="alert alert-danger">Zugriff verweigert: Nur Administratoren dürfen diese Seite sehen.</div>
        }
        else if (isLoading)
        {
            <p>Lade Daten...</p>
        }
        else if (mediaSource is null)
        {
            <div class="alert alert-danger">Quelle nicht gefunden.</div>
            <button class="btn btn-secondary" @onclick="BackToSource">Zurück</button>
        }
        else if (currentCollection is null)
        {
            <h1>Dateiexplorer: @mediaSource.Name</h1>
            <div class="alert alert-warning">
                Für diese Quelle wurde noch keine Root-Collection gefunden. Bitte zuerst scannen.
            </div>
            <button class="btn btn-secondary" @onclick="BackToSource">Zurück</button>
        }
        else
        {
            <h1>Dateiexplorer: @mediaSource.Name</h1>

            <div class="mb-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-secondary" @onclick="BackToSource">Zurück zur Quelle</button>
                <button class="btn btn-outline-secondary" @onclick="GoUp" disabled="@(currentCollection.ParentMediaCollectionId is null)">Nach oben</button>
                <button class="btn btn-success" @onclick="RescanCurrent" disabled="@isRescanRunning">Neu erfassen</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(rescanStatus))
            {
                <div class="alert alert-info" role="alert">
                    @rescanStatus
                    @if (isRescanRunning)
                    {
                        <span class="ms-2">(gescannte Collections: @rescanScannedCollections)</span>
                    }
                </div>
            }

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    @foreach (var crumb in breadcrumbs)
                    {
                        var isLast = ReferenceEquals(crumb, breadcrumbs.LastOrDefault());
                        if (isLast)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@crumb.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <a href="#" @onclick="() => OpenCollection(crumb.Id)">@crumb.Name</a>
                            </li>
                        }
                    }
                </ol>
            </nav>

            <div class="list-group">
                @foreach (var folder in childCollections)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                            @onclick="() => OpenCollection(folder.Id)">
                        <span>📁 @folder.Name</span>
                        <small class="text-muted">@folder.Path</small>
                    </button>
                }

                @foreach (var file in mediaItems)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>📄 @file.Name</span>
                        <small class="text-muted">@file.Path</small>
                    </div>
                }

                @if (childCollections.Count == 0 && mediaItems.Count == 0)
                {
                    <div class="list-group-item text-muted">Dieser Ordner ist leer.</div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Bitte melden Sie sich an.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public long SourceId { get; set; }

    [SupplyParameterFromQuery(Name = "collectionId")]
    public long? CollectionId { get; set; }

    private bool isAdmin;
    private bool isLoading = true;

    private MediaSource? mediaSource;
    private MediaCollection? currentCollection;

    private List<MediaCollection> breadcrumbs = new();
    private List<MediaCollection> childCollections = new();
    private List<MediaItem> mediaItems = new();

    private bool isRescanRunning;
    private string? rescanStatus;
    private int rescanScannedCollections;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.Identity?.IsAuthenticated == true && user.HasClaim("IsAdmin", "True");

        if (!isAdmin)
        {
            isLoading = false;
            return;
        }

        mediaSource = await DbContext.MediaSources
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == SourceId);

        if (mediaSource is null)
        {
            isLoading = false;
            return;
        }

        if (CollectionId.HasValue)
        {
            currentCollection = await DbContext.MediaCollections
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == CollectionId.Value && c.MediaSourceId == SourceId);
        }
        else
        {
            currentCollection = await DbContext.MediaCollections
                .AsNoTracking()
                .Where(c => c.MediaSourceId == SourceId && c.ParentMediaCollectionId == null)
                .OrderBy(c => c.Id)
                .FirstOrDefaultAsync();
        }

        if (currentCollection is not null)
        {
            await LoadCurrentAsync();
        }

        isLoading = false;
    }

    private async Task LoadCurrentAsync()
    {
        if (currentCollection is null)
            return;

        childCollections = await DbContext.MediaCollections
            .AsNoTracking()
            .Where(c => c.ParentMediaCollectionId == currentCollection.Id)
            .OrderBy(c => c.Name)
            .ToListAsync();

        mediaItems = await DbContext.MediaItems
            .AsNoTracking()
            .Where(i => i.MediaCollectionId == currentCollection.Id)
            .OrderBy(i => i.Name)
            .ToListAsync();

        breadcrumbs = await BuildBreadcrumbsAsync(currentCollection);
    }

    private async Task<List<MediaCollection>> BuildBreadcrumbsAsync(MediaCollection leaf)
    {
        var result = new List<MediaCollection>();
        var current = leaf;

        while (true)
        {
            result.Add(current);
            if (!current.ParentMediaCollectionId.HasValue)
                break;

            var parent = await DbContext.MediaCollections
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == current.ParentMediaCollectionId.Value && c.MediaSourceId == SourceId);

            if (parent is null)
                break;

            current = parent;
        }

        result.Reverse();
        return result;
    }

    private void OpenCollection(long id)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters($"/admin/mediasources/{SourceId}/explorer", new Dictionary<string, object?>
        {
            ["collectionId"] = id
        }));
    }

    private void GoUp()
    {
        if (currentCollection?.ParentMediaCollectionId is null)
            return;
        OpenCollection(currentCollection.ParentMediaCollectionId.Value);
    }

    private void BackToSource()
    {
        Navigation.NavigateTo($"/admin/mediasources/{SourceId}");
    }

    private async Task RescanCurrent()
    {
        if (isRescanRunning || currentCollection is null)
            return;

        if (BackgroundGate.IsPausedForRestore)
        {
            rescanStatus = "Restore laeuft. Neu erfassen ist derzeit gesperrt.";
            return;
        }

        isRescanRunning = true;
        rescanScannedCollections = 0;
        rescanStatus = "Neu erfassen: ScanDueAt auf MinValue und Komplettscan der Collection...";
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var processingLease = await BackgroundGate.EnterOperationAsync("Manueller Collection-Scan", CancellationToken.None);
            rescanScannedCollections = await MediaSourceScanner.ScanCollectionTreeAsync(currentCollection.Id, CancellationToken.None);

            rescanStatus = "Neu erfassen: Klassifizierung (nur diese Collection + Unterordner)...";
            await InvokeAsync(StateHasChanged);
            await MediaSourceClassifier.ClassifyCollectionTreeAsync(currentCollection.Id, CancellationToken.None);

            rescanStatus = "Neu erfassen abgeschlossen.";

            currentCollection = await DbContext.MediaCollections
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == currentCollection.Id && c.MediaSourceId == SourceId);

            if (currentCollection is not null)
                await LoadCurrentAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Neu-Erfassen der Collection (Id={CollectionId}).", currentCollection.Id);
            rescanStatus = $"Fehler beim Neu erfassen: {ex.Message}";
        }
        finally
        {
            isRescanRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
