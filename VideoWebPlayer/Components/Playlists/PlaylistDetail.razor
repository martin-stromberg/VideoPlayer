@page "/playlists/{id:long}"
@using Microsoft.AspNetCore.Components.Authorization
@using VideoWebPlayer.Client.Models
@implements IDisposable
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Playlist</PageTitle>

<section class="media-section">
    <div class="admin-card-header">
        <h1>Playlist</h1>
    </div>

    @if (isLoading)
    {
        <p>Lade Daten...</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" id="playlist-detail-error">@loadError</div>
    }
    else if (playlist is not null)
    {
        <div class="admin-table-wrap">
            <dl>
                <div>
                    <dt>Name</dt>
                    <dd id="playlist-detail-name">@playlist.Name</dd>
                </div>
                <div>
                    <dt>Beschreibung</dt>
                    <dd id="playlist-detail-description">@playlist.Description</dd>
                </div>
                <div>
                    <dt>Sortierung</dt>
                    <dd id="playlist-detail-sortmode">@(playlist.SortMode == PlaylistSortModeValues.Manual ? "Manuell" : "Nach Erscheinungsdatum")</dd>
                </div>
                <div>
                    <dt>Erstellt</dt>
                    <dd id="playlist-detail-created">@playlist.CreatedAt.ToLocalTime()</dd>
                </div>
                <div>
                    <dt>Aktualisiert</dt>
                    <dd id="playlist-detail-updated">@playlist.UpdatedAt.ToLocalTime()</dd>
                </div>
            </dl>
        </div>

        <div class="admin-actions">
            <button class="btn btn-primary playlist-detail-edit-button" @onclick="OpenEditForm">Bearbeiten</button>
            <button class="btn btn-danger playlist-detail-delete-button" @onclick="RequestDelete">Loeschen</button>
            <button class="btn btn-ghost playlist-detail-back-button" @onclick="NavigateToOverview">Zurueck zur Uebersicht</button>
        </div>

        <div class="admin-card-header">
            <h2>Inhalte</h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(entriesStatusMessage))
        {
            <div class="alert @(entriesStatusIsError ? "alert-danger" : "alert-success")" id="playlist-entries-status">@entriesStatusMessage</div>
        }

        <div class="admin-table-wrap">
            <div class="admin-actions">
                <select class="form-control playlist-add-mediatype-select" @bind="newEntryMediaType">
                    <option value="@MediaTypeValues.Movie">Film</option>
                    <option value="@MediaTypeValues.TVShow">Serie</option>
                    <option value="@MediaTypeValues.TVShowSeason">Staffel</option>
                    <option value="@MediaTypeValues.TVShowEpisode">Episode</option>
                    <option value="@MediaTypeValues.MovieCollection">Filmsammlung</option>
                </select>
                <input class="form-control playlist-add-mediaid-input" type="number" min="1" @bind="newEntryMediaId" placeholder="Medien-Id" />
                <button class="btn btn-primary playlist-add-entry-button" @onclick="AddEntryAsync">Hinzufuegen</button>
            </div>

            @if (allEntries.Count == 0 && !hasMorePages)
            {
                <div class="admin-empty-state">
                    <strong>Keine Eintraege vorhanden</strong>
                    <span>Fuegen Sie einen Medieninhalt hinzu.</span>
                </div>
            }
            else
            {
                <div class="playlist-entries-scroll">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Typ</th>
                                <th>Titel</th>
                                <th>Sammlung</th>
                                <th>Hinzugefuegt</th>
                                <th>Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize TItem="DtoPlaylistEntry" @ref="virtualizeRef" ItemsProvider="ItemsProviderAsync" Context="entry">
                                <ItemContent>
                                    <tr class="playlist-entry-row @(entry.IsAccessible ? string.Empty : "opacity-50 text-muted")" data-media-type="@entry.MediaType" data-media-id="@entry.MediaId">
                                        <td>@entry.MediaType</td>
                                        <td>@entry.MediaTitle</td>
                                        <td>@entry.ParentMediaTitle</td>
                                        <td>@entry.AddedAt.ToLocalTime()</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger playlist-entry-remove-button" disabled="@(!entry.IsAccessible)" @onclick="() => RemoveEntryAsync(entry)">Entfernen</button>
                                        </td>
                                    </tr>
                                </ItemContent>
                                <Placeholder>
                                    <tr class="playlist-entry-row playlist-entry-placeholder">
                                        <td colspan="5">Lade...</td>
                                    </tr>
                                </Placeholder>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>

                @if (isLoadingMore)
                {
                    <p id="playlist-entries-loading-more">Lade weitere Eintraege...</p>
                }
                @if (hasMorePages)
                {
                    <p id="playlist-entries-more-available">Weitere Eintraege werden beim Scrollen geladen.</p>
                }
            }
        </div>
    }
</section>

@if (showForm)
{
    <PlaylistForm PlaylistId="editingPlaylistId" OnSave="HandleSavedAsync" OnCancel="HandleCancel" />
}

@if (showDeleteConfirmation)
{
    <PlaylistDeleteConfirmationDialog PlaylistName="@playlist?.Name" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
}

@code {
    private const int PageSize = 20;

    [Parameter]
    public long Id { get; set; }

    private DtoPlaylist? playlist;
    private bool isLoading = true;
    private string? loadError;
    private bool showForm;
    private bool showDeleteConfirmation;
    private long? editingPlaylistId;
    private string newEntryMediaType = MediaTypeValues.Movie;
    private long newEntryMediaId;
    private string? entriesStatusMessage;
    private bool entriesStatusIsError;

    private int currentPageNumber = 1;
    private bool isLoadingMore;
    private List<DtoPlaylistEntry> allEntries = new();
    private bool hasMorePages = true;
    private int totalCount;
    private Virtualize<DtoPlaylistEntry>? virtualizeRef;
    private readonly SemaphoreSlim loadPageSemaphore = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenSilentlyAsync(authState.User);
        await LoadPlaylistAsync();
    }

    private async Task LoadPlaylistAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            playlist = await Client.RequestPlaylistAsync(Id);
            if (playlist is null)
                loadError = "Playlist nicht gefunden.";
            else
                await LoadInitialPageAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            loadError = "Zugriff auf diese Playlist verweigert.";
        }
        catch (Exception ex)
        {
            loadError = $"Fehler beim Laden der Playlist: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadInitialPageAsync()
    {
        try
        {
            currentPageNumber = 1;
            allEntries = new List<DtoPlaylistEntry>();
            hasMorePages = true;
            totalCount = 0;

            var page = await Client.RequestPlaylistEntriesPagedAsync(Id, currentPageNumber, PageSize);
            allEntries.AddRange(page.Entries);
            hasMorePages = page.HasNextPage;
            totalCount = page.TotalCount;
            currentPageNumber++;

            if (virtualizeRef is not null)
                await virtualizeRef.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            entriesStatusIsError = true;
            entriesStatusMessage = $"Fehler beim Laden der Eintraege: {ex.Message}";
        }
    }

    private async ValueTask<ItemsProviderResult<DtoPlaylistEntry>> ItemsProviderAsync(ItemsProviderRequest request)
    {
        await loadPageSemaphore.WaitAsync(request.CancellationToken);
        try
        {
            while (allEntries.Count < request.StartIndex + request.Count && hasMorePages)
            {
                isLoadingMore = true;
                try
                {
                    var page = await Client.RequestPlaylistEntriesPagedAsync(Id, currentPageNumber, PageSize, request.CancellationToken);
                    allEntries.AddRange(page.Entries);
                    hasMorePages = page.HasNextPage;
                    totalCount = page.TotalCount;
                    currentPageNumber++;
                }
                finally
                {
                    isLoadingMore = false;
                }
            }
        }
        finally
        {
            loadPageSemaphore.Release();
        }

        var count = Math.Clamp(allEntries.Count - request.StartIndex, 0, request.Count);
        var items = allEntries.Skip(request.StartIndex).Take(count);
        return new ItemsProviderResult<DtoPlaylistEntry>(items, totalCount);
    }

    public void Dispose()
    {
        loadPageSemaphore.Dispose();
    }

    private async Task AddEntryAsync()
    {
        entriesStatusMessage = null;
        entriesStatusIsError = false;
        try
        {
            var result = await Client.AddMediaToPlaylistAsync(Id, new DtoAddMediaToPlaylistRequest
            {
                MediaType = newEntryMediaType,
                MediaId = newEntryMediaId
            });
            entriesStatusMessage = result.Message;
            await LoadInitialPageAsync();
            newEntryMediaId = 0;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            entriesStatusIsError = true;
            entriesStatusMessage = "Medieninhalt wurde nicht gefunden.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            entriesStatusIsError = true;
            entriesStatusMessage = "Sie sind nicht Besitzer dieser Playlist.";
        }
        catch (Exception ex)
        {
            entriesStatusIsError = true;
            entriesStatusMessage = $"Fehler beim Hinzufuegen: {ex.Message}";
        }
    }

    private async Task RemoveEntryAsync(DtoPlaylistEntry entry)
    {
        entriesStatusMessage = null;
        entriesStatusIsError = false;
        try
        {
            await Client.RemoveMediaFromPlaylistAsync(Id, entry.MediaType, entry.MediaId);
            await LoadInitialPageAsync();
        }
        catch (Exception ex)
        {
            entriesStatusIsError = true;
            entriesStatusMessage = $"Fehler beim Entfernen: {ex.Message}";
        }
    }

    private void OpenEditForm()
    {
        editingPlaylistId = Id;
        showForm = true;
    }

    private void RequestDelete()
    {
        showDeleteConfirmation = true;
    }

    private async Task HandleSavedAsync()
    {
        showForm = false;
        await LoadPlaylistAsync();
    }

    private void HandleCancel()
    {
        showForm = false;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Client.DeletePlaylistAsync(Id);
            showDeleteConfirmation = false;
            NavigationManager.NavigateTo("/playlists");
        }
        catch (Exception ex)
        {
            loadError = $"Fehler beim Loeschen der Playlist: {ex.Message}";
            showDeleteConfirmation = false;
        }
    }

    private void NavigateToOverview()
    {
        NavigationManager.NavigateTo("/playlists");
    }
}
