<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VideoPlayer.Views.Management.SourcesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Management.Sources;assembly=VideoPlayerMaui"
    xmlns:view="clr-namespace:VideoPlayer.Views.Management.Sources"
    x:DataType="vm:SourcesViewModel">
    <ScrollView Orientation="Vertical">
        <CollectionView 
            Margin="0"
            ItemsSource="{Binding Sources}"
            ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceSettingsViewModel">
                    <view:SourceConfigurationBox />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentView>