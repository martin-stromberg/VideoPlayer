@page "/actors/{actorId:long}"
@using VideoWebPlayer.Client
@using VideoWebPlayer.Client.Models
@inject VideoWebPlayerClient Client
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@actorName</PageTitle>

@if (actor is null)
{
    <p>Lade Schauspieler...</p>
}
else
{
    <div class="d-flex align-items-center mb-3">
        @if (!string.IsNullOrWhiteSpace(actor.PictureUrl))
        {
            <img src="@actor.PictureUrl" alt="@actor.Name" class="rounded me-3" style="max-height: 150px;" />
        }
        <h3>@actor.Name</h3>
    </div>

    <button class="btn btn-outline-secondary mb-3" @onclick="BackToList">Zurück zur Übersicht</button>

    <h4>Medien</h4>
    @if (!actor.Media.Any())
    {
        <p>Keine Medien vorhanden.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var media in actor.Media)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@media.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(media.Subtitle))
                        {
                            <br />
                            <small class="text-muted">@media.Subtitle</small>
                        }
                    </div>
                    <span class="badge bg-secondary">@media.Type</span>
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public long actorId { get; set; }

    private ActorDetailsDto? actor;
    private string actorName = "Schauspieler";

    protected override async Task OnInitializedAsync()
    {
        actor = await Client.RequestActorAsync(actorId);
        actorName = actor?.Name ?? "Schauspieler";
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/actors");
    }
}
