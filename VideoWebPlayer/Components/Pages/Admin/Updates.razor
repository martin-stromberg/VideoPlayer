@page "/admin/updates"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@using msTools.Updater
@using VideoWebPlayer.Services.Updates
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject PersistentComponentState ApplicationState
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject UpdateAdminService UpdateAdmin
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Systemupdates</PageTitle>

@if (!isAdmin)
{
    <div class="alert alert-danger">Nicht autorisiert.</div>
}
else if (model is null || status is null)
{
    <div class="alert alert-info">Lade...</div>
}
else
{
    <section class="admin-console admin-update-page">
        <header class="admin-page-header update-page-header">
            <div>
                <span class="admin-kicker">Administration</span>
                <h1>Systemupdates</h1>
                <p>Update-Status pruefen, Versionen vergleichen und automatische Update- sowie Backup-Einstellungen verwalten.</p>
            </div>
            <span class="admin-chip @GetStatusChipClass(status)" data-testid="update-state">@GetStateLabel(status.State)</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="update-overview-grid">
            <section class="update-panel update-status-panel" aria-labelledby="update-status-title" data-testid="update-status-section">
                <div class="update-panel-header">
                    <div>
                        <span class="admin-kicker">Update</span>
                        <h2 id="update-status-title">Update-Status</h2>
                    </div>
                    <span class="update-status-indicator @GetStatusIndicatorClass(status)" aria-hidden="true"></span>
                </div>

                <div class="update-status-summary" role="status">
                    <strong>@GetStatusText(status)</strong>
                    <span>@GetVersionSummary(status)</span>
                </div>

                <dl class="update-metric-list">
                    <div>
                        <dt>Installiert</dt>
                        <dd>@Empty(status.InstalledVersion)</dd>
                    </div>
                    <div>
                        <dt>Verfuegbar</dt>
                        <dd>@Empty(status.AvailableVersion ?? status.LastCheckResult?.AvailableVersion)</dd>
                    </div>
                    <div>
                        <dt>Letzte Pruefung</dt>
                        <dd>@FormatDate(status.LastCheckedAt)</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(status.LastError))
                {
                    <div class="update-inline-message update-inline-message-danger" role="alert">
                        <strong>Fehler beim Abruf</strong>
                        <span>@status.LastError</span>
                        @if (status.LastErrorCode is not null)
                        {
                            <small>Code: @status.LastErrorCode</small>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(checkSuccessMessage))
                {
                    <div class="update-inline-message update-inline-message-success" role="status">
                        <strong>Updatepruefung abgeschlossen</strong>
                        <span>@checkSuccessMessage</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(checkErrorMessage))
                {
                    <div class="update-inline-message update-inline-message-danger" role="alert">
                        <strong>Updatepruefung fehlgeschlagen</strong>
                        <span>@checkErrorMessage</span>
                    </div>
                }

                @if (status.IsLocked)
                {
                    <div class="update-inline-message update-inline-message-warning" role="status">
                        <strong>Update-Sperre aktiv</strong>
                        <span>Seit @FormatDate(status.LockCreatedAt) koennen keine weiteren Aktionen gestartet werden.</span>
                    </div>
                }

                <div class="update-action-row">
                    <form method="post" action="/admin/updates/api/check">
                        @if (!string.IsNullOrWhiteSpace(antiforgeryRequestToken))
                        {
                            <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryRequestToken" />
                        }
                        <button class="btn btn-primary update-primary-action" type="submit" disabled="@(isBusy || IsActionBlocked)">Nach Updates suchen</button>
                    </form>
                    <button class="btn btn-ghost" type="button" @onclick="ReloadAsync" disabled="@isBusy" data-testid="refresh-updates">Daten aktualisieren</button>
                    <form method="post" action="/admin/updates/api/install">
                        @if (!string.IsNullOrWhiteSpace(antiforgeryRequestToken))
                        {
                            <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryRequestToken" />
                        }
                        <button class="btn btn-warning" type="submit" disabled="@(isBusy || IsActionBlocked || !UpdateAdminService.IsInstallable(status))" data-testid="install-update">Update installieren</button>
                    </form>
                </div>
            </section>

            <section class="update-panel" aria-labelledby="version-details-title" data-testid="version-details-section">
                <div class="update-panel-header">
                    <div>
                        <span class="admin-kicker">Versionen</span>
                        <h2 id="version-details-title">Versionsdetails</h2>
                    </div>
                </div>

                <dl class="update-detail-grid">
                    <div>
                        <dt>Installierte Version</dt>
                        <dd>@Empty(status.InstalledVersion)</dd>
                    </div>
                    <div>
                        <dt>Verfuegbare Version</dt>
                        <dd>@Empty(status.AvailableVersion ?? status.LastCheckResult?.AvailableVersion)</dd>
                    </div>
                    <div>
                        <dt>Prerelease-Kanal</dt>
                        <dd>@FormatBool(status.LastCheckResult?.IsPrerelease == true)</dd>
                    </div>
                    <div>
                        <dt>Release-Datum</dt>
                        <dd>@FormatDate(status.LastCheckResult?.PublishedAt)</dd>
                    </div>
                    <div class="update-detail-wide">
                        <dt>Letzter Download</dt>
                        <dd>@FormatDownload(status.LastDownloadResult)</dd>
                    </div>
                    <div class="update-detail-wide">
                        <dt>Letzte Installation</dt>
                        <dd>@FormatInstall(status.LastInstallResult)</dd>
                    </div>
                </dl>
            </section>
        </div>

        <section class="update-panel update-config-panel" aria-labelledby="configuration-title" data-testid="configuration-section">
            <div class="update-panel-header">
                <div>
                    <span class="admin-kicker">Einstellungen</span>
                    <h2 id="configuration-title">Konfiguration</h2>
                </div>
            </div>

            <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="update-settings">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="update-settings-grid">
                    <fieldset class="update-settings-group">
                        <legend>Automatisierung</legend>

                        <label class="update-toggle" for="automatic-checks">
                            <InputCheckbox id="automatic-checks" class="form-check-input" @bind-Value="model.AutomaticChecksEnabled" />
                            <span>
                                <strong>Automatische Pruefung</strong>
                                <small>Regelmaessig nach neuen Versionen suchen.</small>
                            </span>
                        </label>

                        <div class="update-field">
                            <label class="form-label" for="check-interval">Pruefintervall in Minuten</label>
                            <InputNumber id="check-interval" class="form-control admin-mono" @bind-Value="model.CheckIntervalMinutes" min="1" max="1440" />
                            <ValidationMessage For="@(() => model.CheckIntervalMinutes)" />
                        </div>

                        <label class="update-toggle" for="allow-prerelease">
                            <InputCheckbox id="allow-prerelease" class="form-check-input" @bind-Value="model.AllowPrereleaseUpdates" />
                            <span>
                                <strong>Vorabversionen akzeptieren</strong>
                                <small>Prerelease-Versionen in die Pruefung einbeziehen.</small>
                            </span>
                        </label>

                        @if (model.AllowPrereleaseUpdates && !prereleaseWasEnabled)
                        {
                            <div class="update-inline-message update-inline-message-warning">
                                <strong>Vorabversionen koennen experimentell sein.</strong>
                                <label class="update-toggle update-toggle-compact" for="confirm-prerelease">
                                    <InputCheckbox id="confirm-prerelease" class="form-check-input" @bind-Value="confirmPrerelease" />
                                    <span>Prerelease-Aktivierung bestaetigen</span>
                                </label>
                            </div>
                        }

                        <label class="update-toggle" for="automatic-installation">
                            <InputCheckbox id="automatic-installation" class="form-check-input" @bind-Value="model.AutomaticInstallationEnabled" />
                            <span>
                                <strong>Automatische Installation</strong>
                                <small>Gefundene Updates automatisch installieren.</small>
                            </span>
                        </label>

                        <div class="update-field">
                            <label class="form-label" for="service-name">Dienstname fuer Neustart</label>
                            <InputText id="service-name" class="form-control" @bind-Value="model.ServiceName" />
                            <ValidationMessage For="@(() => model.ServiceName)" />
                        </div>
                    </fieldset>

                    <fieldset class="update-settings-group">
                        <legend>Sicherheit &amp; Backups</legend>

                        <label class="update-toggle" for="create-backup">
                            <InputCheckbox id="create-backup" class="form-check-input" @bind-Value="model.CreateBackupBeforeInstallation" />
                            <span>
                                <strong>Backup vor Installation</strong>
                                <small>Vor dem Update eine Sicherung erstellen.</small>
                            </span>
                        </label>

                        <label class="update-toggle" for="cancel-on-backup-failure">
                            <InputCheckbox id="cancel-on-backup-failure" class="form-check-input" @bind-Value="model.CancelInstallationOnBackupFailure" />
                            <span>
                                <strong>Bei Backupfehler abbrechen</strong>
                                <small>Installation nur bei erfolgreichem Backup fortsetzen.</small>
                            </span>
                        </label>

                        <div class="update-field">
                            <label class="form-label" for="backup-path">Update-Backup-Pfad</label>
                            <InputText id="backup-path" class="form-control" @bind-Value="model.UpdateBackupPath" />
                            <ValidationMessage For="@(() => model.UpdateBackupPath)" />
                        </div>

                        <div class="update-field">
                            <label class="form-label" for="retained-backups">Aufzubewahrende Update-Backups</label>
                            <InputNumber id="retained-backups" class="form-control admin-mono" @bind-Value="model.RetainedUpdateBackupCount" min="1" max="10" />
                            <ValidationMessage For="@(() => model.RetainedUpdateBackupCount)" />
                        </div>
                    </fieldset>
                </div>

                <div class="update-form-actions">
                    <button class="btn btn-ghost" type="button" @onclick="ResetDefaults" disabled="@(isBusy || defaultModel is null)" data-testid="reset-defaults">Standards zuruecksetzen</button>
                    <button class="btn btn-primary update-primary-action" type="submit" disabled="@isBusy">Konfiguration speichern</button>
                </div>
            </EditForm>
        </section>
    </section>
}

@code {
    private bool isAdmin;
    private bool isBusy;
    private bool prereleaseWasEnabled;
    private bool confirmPrerelease;
    private string? successMessage;
    private string? errorMessage;
    private string? checkSuccessMessage;
    private string? checkErrorMessage;
    private string? antiforgeryRequestToken;
    private SettingsModel? model;
    private SettingsModel? defaultModel;
    private AutoUpdateStatusSnapshot? status;
    private PeriodicTimer? timer;
    private CancellationTokenSource? timerCts;
    private PersistingComponentStateSubscription _stateSubscription;

    private bool IsActionBlocked => status is null || UpdateAdminService.IsBusy(status);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.Identity?.IsAuthenticated == true && user.HasClaim("IsAdmin", "True");
        if (!isAdmin)
            return;

        antiforgeryRequestToken = CreateAntiforgeryRequestToken();
        ApplyQueryMessages();
        await ReloadAsync();
        StartPolling();
    }

    private string? CreateAntiforgeryRequestToken()
    {
        if (ApplicationState.TryTakeFromJson<string>("antiforgeryToken", out var token))
            return token;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
            return null;

        var requestToken = Antiforgery.GetAndStoreTokens(httpContext).RequestToken;
        _stateSubscription = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson("antiforgeryToken", requestToken);
            return Task.CompletedTask;
        });
        return requestToken;
    }

    private void ApplyQueryMessages()
    {
        var query = QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        if (query.TryGetValue("updateStatus", out var statusMessage))
            successMessage = statusMessage.ToString();
        if (query.TryGetValue("updateError", out var error))
            errorMessage = error.ToString();
        if (query.TryGetValue("checkStatus", out var checkStatusMessage))
            checkSuccessMessage = checkStatusMessage.ToString();
        if (query.TryGetValue("checkError", out var checkError))
            checkErrorMessage = checkError.ToString();
    }

    private async Task ReloadAsync()
    {
        isBusy = true;
        try
        {
            var snapshot = await UpdateAdmin.GetSnapshotAsync();
            status = snapshot.Status;
            model = SettingsModel.FromSettings(snapshot.Settings);
            defaultModel = SettingsModel.FromSettings(snapshot.DefaultSettings);
            prereleaseWasEnabled = model.AllowPrereleaseUpdates;
            confirmPrerelease = false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetDefaults()
    {
        if (defaultModel is null)
            return;

        model = defaultModel.Clone();
        confirmPrerelease = false;
        successMessage = "Standardwerte wurden im Formular geladen. Zum Uebernehmen bitte die Konfiguration speichern.";
        errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (model is null)
            return;

        if (model.AllowPrereleaseUpdates && !prereleaseWasEnabled && !confirmPrerelease)
        {
            model.AllowPrereleaseUpdates = false;
            errorMessage = "Prerelease-Versionen wurden nicht aktiviert, weil die Sicherheitsabfrage nicht bestaetigt wurde.";
            successMessage = null;
            return;
        }

        isBusy = true;
        successMessage = null;
        errorMessage = null;
        try
        {
            await UpdateAdmin.UpdateSettingsAsync(new UpdateSettingsUpdate(
                model.AutomaticChecksEnabled,
                model.CheckIntervalMinutes,
                model.AllowPrereleaseUpdates,
                model.AutomaticInstallationEnabled,
                AutomaticDownloadEnabled: true,
                model.ServiceName,
                model.CreateBackupBeforeInstallation,
                model.CancelInstallationOnBackupFailure,
                model.UpdateBackupPath,
                model.RetainedUpdateBackupCount));
            successMessage = "Konfiguration wurde gespeichert.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartPolling()
    {
        timerCts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync(timerCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        if (timer is null)
            return;

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    var snapshot = await UpdateAdmin.GetSnapshotAsync(cancellationToken);
                    status = snapshot.Status;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string GetStatusChipClass(AutoUpdateStatusSnapshot snapshot) => snapshot.State switch
    {
        AutoUpdateState.Failed => "admin-chip-danger",
        AutoUpdateState.UpdateAvailable or AutoUpdateState.ReadyToInstall => "admin-chip-warning",
        AutoUpdateState.Installing or AutoUpdateState.Downloading or AutoUpdateState.Checking => "admin-chip-info",
        AutoUpdateState.Disabled => "admin-chip-muted",
        AutoUpdateState.Success => "admin-chip-success",
        _ => string.Empty
    };

    private static string GetStatusIndicatorClass(AutoUpdateStatusSnapshot snapshot) => snapshot.State switch
    {
        AutoUpdateState.Failed => "update-status-danger",
        AutoUpdateState.UpdateAvailable or AutoUpdateState.ReadyToInstall => "update-status-warning",
        AutoUpdateState.Installing or AutoUpdateState.Downloading or AutoUpdateState.Checking => "update-status-info",
        AutoUpdateState.Success => "update-status-success",
        _ => "update-status-muted"
    };

    private static string GetStateLabel(AutoUpdateState state) => state switch
    {
        AutoUpdateState.Checking => "Pruefung",
        AutoUpdateState.UpdateAvailable => "Update verfuegbar",
        AutoUpdateState.Downloading => "Download",
        AutoUpdateState.ReadyToInstall => "Bereit",
        AutoUpdateState.Installing => "Installation",
        AutoUpdateState.Idle => "Wartet",
        AutoUpdateState.Success => "Erfolgreich",
        AutoUpdateState.Failed => "Fehler",
        AutoUpdateState.Disabled => "Deaktiviert",
        _ => "Unbekannt"
    };

    private static string GetStatusText(AutoUpdateStatusSnapshot snapshot) => snapshot.State switch
    {
        AutoUpdateState.Checking => "Update-Pruefung laeuft.",
        AutoUpdateState.UpdateAvailable => "Eine neue Version ist verfuegbar.",
        AutoUpdateState.Downloading => "Update-Paket wird heruntergeladen.",
        AutoUpdateState.ReadyToInstall => "Das Update ist bereit zur Installation.",
        AutoUpdateState.Installing => "Installation laeuft.",
        AutoUpdateState.Success => "Die letzte Update-Aktion war erfolgreich.",
        AutoUpdateState.Failed => "Die letzte Update-Aktion ist fehlgeschlagen.",
        AutoUpdateState.Disabled => "Automatische Updates sind deaktiviert.",
        _ => "Keine laufende Update-Aktion."
    };

    private static string GetVersionSummary(AutoUpdateStatusSnapshot snapshot)
    {
        var availableVersion = snapshot.AvailableVersion ?? snapshot.LastCheckResult?.AvailableVersion;
        if (string.IsNullOrWhiteSpace(availableVersion))
            return $"Installierte Version {Empty(snapshot.InstalledVersion)}";

        return $"Installierte Version {Empty(snapshot.InstalledVersion)}, verfuegbare Version {availableVersion}";
    }

    private static string FormatDate(DateTimeOffset? value)
        => value?.ToLocalTime().ToString("g") ?? "-";

    private static string FormatDownload(AutoUpdateDownloadResult? result)
        => result is null
            ? "Noch kein Download vorhanden."
            : $"{Path.GetFileName(result.LocalPath)} ({FormatBytes(result.SizeBytes)}, Pruefsumme {(result.ChecksumValid ? "gueltig" : "ungueltig")})";

    private static string FormatInstall(AutoUpdateInstallResult? result)
        => result is null
            ? "-"
            : $"{result.Version}, gestartet {result.StartedAt.ToLocalTime():g}";

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.##} {units[unit]}";
    }

    private static string FormatBool(bool value)
        => value ? "Ja" : "Nein";

    private static string Empty(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    /// <inheritdoc />
    public void Dispose()
    {
        _stateSubscription.Dispose();
        timerCts?.Cancel();
        timer?.Dispose();
        timerCts?.Dispose();
    }

    private sealed class SettingsModel
    {
        public bool AutomaticChecksEnabled { get; set; } = true;

        [Range(1, 24 * 60, ErrorMessage = "Das Pruefintervall muss zwischen 1 und 1440 Minuten liegen.")]
        public int CheckIntervalMinutes { get; set; } = 360;

        public bool AllowPrereleaseUpdates { get; set; }

        public bool AutomaticInstallationEnabled { get; set; }

        [MaxLength(200, ErrorMessage = "Der Dienstname darf hoechstens 200 Zeichen lang sein.")]
        public string? ServiceName { get; set; }

        public bool CreateBackupBeforeInstallation { get; set; } = true;

        public bool CancelInstallationOnBackupFailure { get; set; } = true;

        [Required(ErrorMessage = "Der Backup-Pfad ist erforderlich.")]
        [MaxLength(1024, ErrorMessage = "Der Backup-Pfad darf hoechstens 1024 Zeichen lang sein.")]
        public string UpdateBackupPath { get; set; } = "Backups";

        [Range(1, 10, ErrorMessage = "Es koennen 1 bis 10 Update-Backups aufbewahrt werden.")]
        public int RetainedUpdateBackupCount { get; set; } = 5;

        public static SettingsModel FromSettings(VideoWebPlayer.Data.UpdateSettings settings)
            => new()
            {
                AutomaticChecksEnabled = settings.AutomaticChecksEnabled,
                CheckIntervalMinutes = settings.CheckIntervalMinutes,
                AllowPrereleaseUpdates = settings.AllowPrereleaseUpdates,
                AutomaticInstallationEnabled = settings.AutomaticInstallationEnabled,
                ServiceName = settings.ServiceName,
                CreateBackupBeforeInstallation = settings.CreateBackupBeforeInstallation,
                CancelInstallationOnBackupFailure = settings.CancelInstallationOnBackupFailure,
                UpdateBackupPath = settings.UpdateBackupPath,
                RetainedUpdateBackupCount = settings.RetainedUpdateBackupCount
            };

        public SettingsModel Clone()
            => new()
            {
                AutomaticChecksEnabled = AutomaticChecksEnabled,
                CheckIntervalMinutes = CheckIntervalMinutes,
                AllowPrereleaseUpdates = AllowPrereleaseUpdates,
                AutomaticInstallationEnabled = AutomaticInstallationEnabled,
                ServiceName = ServiceName,
                CreateBackupBeforeInstallation = CreateBackupBeforeInstallation,
                CancelInstallationOnBackupFailure = CancelInstallationOnBackupFailure,
                UpdateBackupPath = UpdateBackupPath,
                RetainedUpdateBackupCount = RetainedUpdateBackupCount
            };
    }
}
