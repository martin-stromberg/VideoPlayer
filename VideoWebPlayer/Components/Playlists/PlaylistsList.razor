@page "/playlists"
@using Microsoft.AspNetCore.Components.Authorization
@using VideoWebPlayer.Client.Models
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject VideoWebPlayer.Client.IPlaylistApiClient PlaylistClient
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Playlists</PageTitle>

<section class="media-section">
    <div class="admin-card-header">
        <h1>Playlists</h1>
        <button class="btn btn-primary" id="create-playlist-button" @onclick="OpenCreateForm">Neue Playlist erstellen</button>
    </div>

    @if (genreOptions.Count > 0)
    {
        @* Genre-Filter fuer Playlists (Entwicklungsschritt 9): "lassen sich wie die Genres anderer Inhalte
           zum Filtern und Suchen nutzen" - Auswahl aus dem globalen Genre-Katalog, analog zur
           Genre-Auswahl bei Filmen/Serien. *@
        <div class="admin-filter-row">
            <label for="playlists-genre-filter">Nach Genre filtern</label>
            <select class="form-select" id="playlists-genre-filter" value="@(selectedGenreId?.ToString() ?? string.Empty)" @onchange="OnGenreFilterChangedAsync">
                <option value="">Alle Genres</option>
                @foreach (var genre in genreOptions.OrderBy(g => g.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>
    }

    @if (isLoading)
    {
        <p>Lade Daten...</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" id="playlists-load-error">@loadError</div>
    }
    else if (playlists.Count == 0)
    {
        <div class="admin-empty-state">
            <strong>Keine Playlists vorhanden</strong>
            <span>Erstellen Sie Ihre erste Playlist.</span>
        </div>
    }
    else
    {
        @* Kachel-UI statt Tabelle (Kundenfeedback): Titel + Grafik pro Playlist, Sortierung als Symbol statt
           Text, "Erstellt"/"Aktualisiert" dezent dargestellt. Ein Klick auf die Kachel oeffnet die
           Detailansicht; Bearbeiten/Loeschen gibt es nur noch dort (siehe PlaylistDetail.razor).

           Die Kachel ist ein echter Link (".media-box-link", dasselbe etablierte Muster wie bei
           MediaBox.razor fuer Filme/Serien) und kein unsichtbares Button-Overlay per z-index: ein
           <a href> ist sofort - auch ohne bereits verbundenen Blazor-Server-Circuit - klickbar/tippbar
           und bringt automatisch "touch-action: manipulation" mit, was den fruehreren Button-Ansatz auf
           Touch-Geraeten anfaellig fuer ausbleibende Klicks machte (siehe Regressionstests in
           PlaylistsE2ETests, die genau das jetzt gegen die tatsaechlich sichtbaren Elemente prüfen). *@
        <div class="media-grid playlist-grid">
            @foreach (var playlist in playlists)
            {
                <a class="media-box-link playlist-row" href="@($"/playlists/{playlist.Id}")" data-playlist-name="@playlist.Name" title="@playlist.Name" aria-label="Playlist &quot;@(playlist.Name)&quot; oeffnen">
                    <div class="media-box playlist-card">
                        @* Platzhalter liegt immer darunter (billig: Farbverlauf + Symbol) und wird nur
                           sichtbar, wenn kein Cover gesetzt ist oder das Bild nicht ladbar ist (onerror
                           blendet das <img> aus) - vermeidet einen unnoetigen HTTP-Request, wenn ohnehin
                           kein Cover existiert, ohne dedizierte JS-Interop fuer den Fallback zu brauchen. *@
                        <PlaylistCoverPlaceholder PlaylistId="playlist.Id" CssClass="playlist-card-cover" />
                        @if (playlist.CoverPictureId.HasValue)
                        {
                            <img class="playlist-card-cover playlist-card-cover-image" src="@GetCoverImageUrl(playlist)" alt="@playlist.Name"
                                 onerror="this.style.display='none'" />
                        }
                        <div class="media-card-overlay">
                            <div class="media-titles">
                                <span class="media-title-text playlist-card-title">@playlist.Name</span>
                                @if (!string.IsNullOrWhiteSpace(playlist.Description))
                                {
                                    <span class="media-subtitle-text">@TruncateDescription(playlist.Description)</span>
                                }
                                @if (playlist.Genres.Length > 0)
                                {
                                    <span class="playlist-genres-line playlist-card-genres">@string.Join(", ", playlist.Genres.Select(g => g.Name))</span>
                                }
                            </div>
                            <div class="playlist-card-meta">
                                <PlaylistSortModeIcon SortMode="playlist.SortMode" Size="14" />
                                <span class="playlist-card-dates">
                                    Erstellt @playlist.CreatedAt.ToLocalTime().ToString("d") &middot; Aktualisiert @playlist.UpdatedAt.ToLocalTime().ToString("d")
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

@if (formState.IsOpen)
{
    <PlaylistForm PlaylistId="formState.EditingId" OnSave="HandleSavedAsync" OnCancel="HandleCancel" />
}

@code {
    private const int DescriptionTruncateLength = 100;
    private const string DescriptionTruncateEllipsis = "…";

    private List<DtoPlaylist> playlists = new();
    private List<DtoGenreOption> genreOptions = new();
    private long? selectedGenreId;
    private bool isLoading = true;
    private string? loadError;
    private readonly PlaylistFormState formState = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenSilentlyAsync(authState.User);
        genreOptions = await Client.RequestGenreOptionsAsync();
        await LoadPlaylistsAsync();
    }

    private async Task LoadPlaylistsAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            playlists = (await PlaylistClient.RequestPlaylistsAsync(selectedGenreId)).ToList();
        }
        catch (Exception ex)
        {
            loadError = $"Fehler beim Laden der Playlists: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnGenreFilterChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value as string;
        selectedGenreId = long.TryParse(value, out var genreId) ? genreId : null;
        await LoadPlaylistsAsync();
    }

    private void OpenCreateForm()
    {
        formState.OpenForCreate();
    }

    private async Task HandleSavedAsync()
    {
        formState.Close();
        await LoadPlaylistsAsync();
    }

    private void HandleCancel()
    {
        formState.Close();
    }

    /// <summary>
    /// URL of a playlist's cover image, carrying the access token needed since a plain <c>&lt;img&gt;</c>
    /// request cannot send an <c>Authorization</c> header (same convention as the poster URLs built
    /// throughout the app, e.g. <c>TVShowDetails.razor</c>), and cache-busted via
    /// <see cref="DtoPlaylist.CoverPictureId"/> (which changes on every upload/regeneration) so the browser
    /// fetches the new image instead of reusing a stale cached response for the same <c>/cover</c> endpoint
    /// - same reasoning as <c>PlaylistDetail.razor.CoverImageUrl</c>.
    /// </summary>
    private string GetCoverImageUrl(DtoPlaylist playlist)
        => $"/api/playlists/{playlist.Id}/cover?access_token={Client.AuthorizationToken}&v={playlist.CoverPictureId}";

    private static string TruncateDescription(string? description)
    {
        if (string.IsNullOrEmpty(description))
            return string.Empty;

        return description.Length > DescriptionTruncateLength
            ? description[..DescriptionTruncateLength] + DescriptionTruncateEllipsis
            : description;
    }
}
