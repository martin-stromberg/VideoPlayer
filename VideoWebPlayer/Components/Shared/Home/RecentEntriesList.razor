@inject IJSRuntime JS
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@code {
    public List<DtoRecentEntry> RecentEntries { get; set; } = new();

    private Dictionary<long, string> movieTitles = new();
    private Dictionary<long, string> moviePosters = new();
    private Dictionary<long, string> movieLinks = new();
    private Dictionary<long, string> collectionTitles = new();
    private Dictionary<long, string> collectionPosters = new();
    private Dictionary<long, string> collectionLinks = new();
    private Dictionary<long, string> showTitles = new();
    private Dictionary<long, string> showBanners = new();
    private Dictionary<long, string> showLinks = new();
    private Dictionary<long, string> seasonTitles = new();
    private Dictionary<long, string> seasonBanners = new();
    private Dictionary<long, string> seasonLinks = new();
    private Dictionary<long, string> episodeTitles = new();
    private Dictionary<long, string> episodePosters = new();
    private Dictionary<long, string> episodeLinks = new();

    private ElementReference recentEntriesListRef;

    protected override async Task OnInitializedAsync()
    {
        RecentEntries = (await Client.RequestRecentEntriesAsync()).ToList();
        await InitializeValues();
        await base.OnInitializedAsync();
    }

    private async Task InitializeValues()
    {
        // Dictionaries leeren
        movieTitles.Clear();
        moviePosters.Clear();
        movieLinks.Clear();
        collectionTitles.Clear();
        collectionPosters.Clear();
        collectionLinks.Clear();
        showTitles.Clear();
        showBanners.Clear();
        showLinks.Clear();
        seasonTitles.Clear();
        seasonBanners.Clear();
        seasonLinks.Clear();
        episodeTitles.Clear();
        episodePosters.Clear();
        episodeLinks.Clear();

        foreach (var entry in RecentEntries)
        {
            if (entry.Entry is DtoMovie movie)
            {
                var collection = movie.Collection;
                if (collection is null)
                    continue;
                movieTitles[entry.Id] = entry.Entry.Name;
                moviePosters[entry.Id] = entry.Entry.PosterPictureId.HasValue ? $"/api/pictures/{entry.Entry.PosterPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";
                movieLinks[entry.Id] = $"/moviecollection/{collection.Id}?movie={entry.Entry.Id}";
            }
            if (entry.Entry is DtoMovieCollection)
            {
                collectionTitles[entry.Id] = entry.Entry.Name;
                collectionPosters[entry.Id] = entry.Entry.PosterPictureId.HasValue ? $"/api/pictures/{entry.Entry.PosterPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";
                collectionLinks[entry.Id] = $"/moviecollection/{entry.Entry.Id}";
            }
            if (entry.Entry is DtoTVShow)
            {
                showTitles[entry.Id] = entry.Entry.Name;
                showBanners[entry.Id] = entry.Entry.PosterPictureId.HasValue ? $"/api/pictures/{entry.Entry.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : entry.Entry.BannerPictureId.HasValue ? $"/api/pictures/{entry.Entry.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : entry.Entry.FanartPictureId.HasValue ? $"/api/pictures/{entry.Entry.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : "/images/placeholder.png";
                showLinks[entry.Id] = $"/tvshow/{entry.Entry.Id}";
            }
            if (entry.Entry is DtoTVShowSeason season)
            {
                var showSeason = season.Show;
                if (showSeason is null)
                    continue;
                seasonTitles[entry.Id] = $"{showSeason?.Name ?? ""} - {season.Name}";
                seasonBanners[entry.Id] = season.PosterPictureId.HasValue ? $"/api/pictures/{season.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : season.FanartPictureId.HasValue ? $"/api/pictures/{season.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : season.BannerPictureId.HasValue ? $"/api/pictures/{season.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : showSeason.PosterPictureId.HasValue ? $"/api/pictures/{showSeason.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : showSeason.BannerPictureId.HasValue ? $"/api/pictures/{showSeason.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : showSeason.FanartPictureId.HasValue ? $"/api/pictures/{showSeason.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : "/images/placeholder.png";
                seasonLinks[entry.Id] = $"/tvshow/{showSeason?.Id}?season={season.Id}";
            }
            if (entry.Entry is DtoTVShowEpisode episode)
            {
                var seasonEp = episode.Season;
                var showEp = seasonEp?.Show;
                if (seasonEp is null || showEp is null)
                    continue;
                episodeTitles[entry.Id] = $"{showEp?.Name ?? ""} - S{seasonEp?.Name?.Split(' ').Last()}E{episode.Number.ToString().PadLeft(2, '0')}";
                episodePosters[entry.Id] = episode.PosterPictureId.HasValue ? $"/api/pictures/{episode.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : episode.FanartPictureId.HasValue ? $"/api/pictures/{episode.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : episode.BannerPictureId.HasValue ? $"/api/pictures/{episode.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : seasonEp.PosterPictureId.HasValue ? $"/api/pictures/{seasonEp.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : seasonEp.FanartPictureId.HasValue ? $"/api/pictures/{seasonEp.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : seasonEp.BannerPictureId.HasValue ? $"/api/pictures/{seasonEp.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : showEp.PosterPictureId.HasValue ? $"/api/pictures/{showEp.PosterPictureId}?access_token={Client.AuthorizationToken}"
                    : showEp.BannerPictureId.HasValue ? $"/api/pictures/{showEp.BannerPictureId}?access_token={Client.AuthorizationToken}"
                    : showEp.FanartPictureId.HasValue ? $"/api/pictures/{showEp.FanartPictureId}?access_token={Client.AuthorizationToken}"
                    : "/images/placeholder.png";
                episodeLinks[entry.Id] = $"/tvshow/{showEp?.Id}?season={seasonEp?.Id}&episode={episode.Id}";
            }

           
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RecentEntries.Any())
        {
            await JS.InvokeVoidAsync("enableHorizontalWheelScroll", ".recent-entries-list");
        }
    }
}

@if (RecentEntries.Any())
{
    <section class="media-section" aria-labelledby="recent-title">
        <h2 id="recent-title">Neu im Programm</h2>
        <div class="recent-entries-list" @ref="recentEntriesListRef">
            @foreach (var entry in RecentEntries)
            {
                if (entry.Entry is DtoMovie && movieTitles.ContainsKey(entry.Id))
                {
                    <MediaBox Title="@movieTitles[entry.Id]" ImageUrl="@moviePosters[entry.Id]" LinkUrl="@movieLinks[entry.Id]" WatchedAt="@entry.Entry.WatchedAt" />
                }
                else if (entry.Entry is DtoMovieCollection && collectionTitles.ContainsKey(entry.Id))
                {
                    <MediaBox Title="@collectionTitles[entry.Id]" ImageUrl="@collectionPosters[entry.Id]" LinkUrl="@collectionLinks[entry.Id]" />
                }
                else if (entry.Entry is DtoTVShow && showTitles.ContainsKey(entry.Id))
                {
                    <MediaBox Title="@showTitles[entry.Id]" ImageUrl="@showBanners[entry.Id]" LinkUrl="@showLinks[entry.Id]" />
                }
                else if (entry.Entry is DtoTVShowSeason && seasonTitles.ContainsKey(entry.Id))
                {
                    <MediaBox Title="@seasonTitles[entry.Id]" ImageUrl="@seasonBanners[entry.Id]" LinkUrl="@seasonLinks[entry.Id]" />
                }
                else if (entry.Entry is DtoTVShowEpisode && episodeTitles.ContainsKey(entry.Id))
                {
                    <MediaBox Title="@episodeTitles[entry.Id]" ImageUrl="@episodePosters[entry.Id]" LinkUrl="@episodeLinks[entry.Id]" WatchedAt="@entry.Entry.WatchedAt" />
                }
            }
        </div>
    </section>
}

<script>
window.enableHorizontalWheelScroll = function (selector) {
    var el = document.querySelector(selector);
    if (!el) return;
    el.addEventListener('wheel', function (e) {
        if (e.deltaY === 0) return;
        e.preventDefault();
        el.scrollLeft += e.deltaY;
    }, { passive: false });
};
</script>
