<ConfirmationDialog Title="Hochgeladenes Bild ersetzen" OnConfirm="OnConfirm" OnCancel="OnCancel"
                    ConfirmButtonText="Ja, ersetzen" ConfirmButtonId="confirm-regenerate-cover-button" CancelButtonId="cancel-regenerate-cover-button">
    <p>Das von Ihnen hochgeladene Bild wird durch ein automatisch erzeugtes Bild ersetzt und kann nicht wiederhergestellt werden. Möchten Sie fortfahren?</p>
</ConfirmationDialog>

@code {
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
