<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="VideoWebPlayer.Maui.MovieCollectionDetailsPage"
             x:DataType="viewmodels:MovieCollectionDetailsViewModel"
             BackgroundColor="#000000">
    <Grid BackgroundColor="#181820" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="47" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Source="background_header_left.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="1" Source="background_header_middle.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="2" Source="background_header_right.png" Aspect="Fill" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="28" FontAttributes="Bold" TextColor="#FFDDAA" Padding="20,20,20,15" FontFamily="OpenSansSemibold">
            <Label.Shadow>
                <Shadow Brush="#000000" Offset="5,5" Radius="6" />
            </Label.Shadow>
        </Label>
        <Image Grid.Row="1" Grid.Column="0" Source="background_content_left.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.Column="1" Source="background_content_middle.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.Column="2" Source="background_content_right.png" Aspect="Fill" />
        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Spacing="20" Padding="20,10,20,20">
                <!-- Banner mit Hintergrundfarbe -->
                <Border HeightRequest="200" StrokeThickness="0" BackgroundColor="{Binding DisplayBannerBackgroundColor}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <!-- Banner Image (verborgen wenn Video läuft) -->
                        <Image x:Name="BannerImage"
                               Source="{Binding DisplayBannerSource}" 
                               Aspect="AspectFit" />
                        
                        <!-- Video Player (verborgen bis Play gedrückt) -->
                        <mct:MediaElement x:Name="VideoPlayer"
                                          IsVisible="False"
                                          ShouldAutoPlay="True"
                                          ShouldShowPlaybackControls="True"
                                          StateChanged="OnMediaStateChanged" />
                        
                        <!-- Play Button (verborgen wenn Video läuft, nur wenn Film ausgewählt) -->
                        <Border x:Name="PlayButton"
                                BackgroundColor="#FFB84D"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Opacity="0.9"
                                IsVisible="{Binding SelectedMovie, Converter={StaticResource IsNotNullConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000"
                                        Offset="4,4"
                                        Radius="8"
                                        Opacity="0.5" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlayTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="▶"
                                   FontSize="40"
                                   TextColor="#000000"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="5,0,0,0" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Film Details (nur wenn ein Film ausgewählt ist) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding SelectedMovie, Converter={StaticResource IsNotNullConverter}}">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="{Binding ReleaseYear}" FontSize="14" TextColor="#333333" FontAttributes="Bold" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="|" FontSize="14" TextColor="#333333" IsVisible="{Binding ReleaseYear, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding GenreNames}" FontSize="14" TextColor="#333333" FontAttributes="Bold" />
                    </StackLayout>
                    <Label Text="{Binding Plot}" FontSize="14" TextColor="#555555" LineBreakMode="WordWrap" />
                    
                    <!-- Download Button für ausgewählten Film -->
                    <Button Text="⬇ Film herunterladen (7 Tage)"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            Clicked="OnDownloadMovieTapped"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Filme Liste (nur wenn mehr als 1 Film) -->
                <Label Text="Filme in dieser Sammlung:" FontSize="18" FontAttributes="Bold" TextColor="#FFB84D" IsVisible="{Binding ShowMoviesList}" />
                <CollectionView ItemsSource="{Binding Movies}" 
                                SelectionMode="Single" 
                                SelectedItem="{Binding SelectedMovie}"
                                SelectionChanged="OnMovieSelected"
                                IsVisible="{Binding ShowMoviesList}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MediaItemViewModel">
                            <Border StrokeThickness="0" BackgroundColor="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3" />
                                </Border.Shadow>
                                <Grid RowDefinitions="*,Auto">
                                    <Image Grid.Row="0" Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="270" />
                                    <Label Grid.Row="1" Text="{Binding Title}" FontSize="14" TextColor="#FFDDAA" Padding="5" LineBreakMode="TailTruncation" MaxLines="2" BackgroundColor="#23232a" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Image Grid.Row="2" Grid.Column="0" Source="background_footer_left.png" Aspect="Fill" />
        <Image Grid.Row="2" Grid.Column="1" Source="background_footer_middle.png" Aspect="Fill" />
        <Image Grid.Row="2" Grid.Column="2" Source="background_footer_right.png" Aspect="Fill" />
    </Grid>
</ContentPage>

