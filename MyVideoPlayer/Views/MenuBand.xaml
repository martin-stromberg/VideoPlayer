<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyVideoPlayer.ViewModels.Menu"
             xmlns:v="clr-namespace:MyVideoPlayer.Views"
             x:Class="MyVideoPlayer.Views.MenuBand">
    <HorizontalStackLayout Margin="0">
        <ScrollView x:DataType="vm:MenuViewModel">
            <FlexLayout
    AlignContent="End"
    AlignItems="Center"
    AlignSelf="End"
    BindableLayout.ItemsSource="{Binding Actions}"
    Direction="RowReverse"
    JustifyContent="End">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MenuAction">
                        <Button Opacity="0.9" 
                                Command="{Binding Command}" 
                                Text="{Binding Title}" 
                                BackgroundColor="Silver" 
                                TextColor="Black" 
                                BorderWidth="0" 
                                Margin="2" Padding="2" 
                                HeightRequest="40" 
                                WidthRequest="200"
                                FontSize="Small" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>
    </HorizontalStackLayout>
</ContentView>
