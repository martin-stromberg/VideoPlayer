    private async Task StartFfmpegDownloadAsync()
    {
        confirmFfmpegDownload = false;
        downloadError = null;
        downloadErrorDismissed = false;
        downloadSuccessDismissed = false;
        try
        {
            var result = await ToolDownloadService.StartDownloadAsync(userId);
            downloadSnapshot = result.Snapshot;
            // Also when another admin's job is already running (Started=false but active):
            // without the loop the progress card would freeze — the loop ends itself once
            // the job is no longer active.
            if (result.Snapshot.IsActive)
                _ = DownloadProgressLoopAsync(refreshCts?.Token ?? CancellationToken.None);
        }
        catch (Exception ex)
        {
            downloadError = ex.Message;
        }
    }

    // Schließen quittiert den Endstand zusätzlich im Service — die Meldung kehrt dann auch
    // nicht wieder, falls die Komponente den Übergang selbst nicht miterlebt hat.
    private void DismissDownloadError()
    {
        downloadErrorDismissed = true;
        // Nur den angezeigten Stand quittieren — ein zwischenzeitlich neuerer Endstand
        // bleibt für den nächsten Beobachter erhalten.
        ToolDownloadService.AcknowledgeTerminalState(downloadSnapshot.Id);
    }

    private void DismissDownloadSuccess()
    {
        downloadSuccessDismissed = true;
        ToolDownloadService.AcknowledgeTerminalState(downloadSnapshot.Id);
    }

    // Polls the download job while it is active so progress and the final state reach the
    // UI; on every non-active state the locator flags are re-read so the "missing" notices
    // disappear without a reload — also when another tab completed and already
    // acknowledged the job (this loop then reads Idle), not only on Succeeded here.
    private async Task DownloadProgressLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(DownloadRefreshInterval, TimeProvider);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (disposed)
                    return;

                var finished = false;
                try
                {
                    await InvokeAsync(() =>
                    {
                        if (disposed)
                            return;
                        downloadSnapshot = ToolDownloadService.GetSnapshot();
                        if (!downloadSnapshot.IsActive)
                        {
                            // Jeder nicht-aktive Stand (Succeeded, Failed, bereits fremd-
                            // quittiertes Idle): die Locators sind billige File.Exists-
                            // Aufrufe, ein veralteter "fehlt"-Hinweis darf nicht stehen bleiben.
                            RefreshToolPaths();
                            // Der Endstand wurde dieser Komponente einmal angezeigt — als
                            // gesehen quittieren, damit er beim nächsten Seitenaufruf nicht
                            // erneut aufpoppt. Die Id bindet das Quittieren an genau den
                            // gelesenen Stand.
                            ToolDownloadService.AcknowledgeTerminalState(downloadSnapshot.Id);
                            finished = true;
                        }
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch (Exception)
                {
                    // Transient failure — the next tick retries.
                }

                if (finished)
                    return;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

