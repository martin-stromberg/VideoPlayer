<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mediathek.ViewModels.Management.Sources;assembly=MediathekMaui"
             xmlns:view="clr-namespace:MediaPlayer.Views.Management.Sources"
             x:Class="MediaPlayer.Views.Management.Sources.SourceConfigurationBox"
             x:DataType="vm:SourceSettingsViewModel">
    <Frame Margin="5" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Text="{Binding Title}" IsVisible="{Binding IsStored}"/>
            <Entry Grid.Row="0" Text="{Binding Title}"  IsVisible="{Binding IsNew}"/>
            <Picker Grid.Column="1" ItemsSource="{Binding SourceTypeNames}" IsVisible="{Binding IsNew}" SelectedItem="{Binding SelectedType}"/>
            <view:SourceFTPConfigurationBox Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsFTP}"/>
            <view:SourceSSHConfigurationBox Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsSSH}"/>
            <view:SourceHttpConfigurationBox Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsHttp}"/>
            <view:SourceSambaConfigurationBox Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsSamba}"/>

            <Button Grid.Column="2" Grid.Row="0" IsVisible="{Binding IsStored}" Text="🔄" Margin="0" Padding="0" Background="Transparent" Command="{Binding Rescan}" FontSize="Large"/>
            <Button Grid.Column="2" Grid.Row="1" IsVisible="{Binding IsStored}" Text="🧹" Margin="0" Padding="0" Background="Transparent" Command="{Binding Clean}" FontSize="Medium"/>
            <Button Grid.Column="2" Grid.Row="2" IsVisible="{Binding IsStored}" Text="※" Margin="0" Padding="0" Background="Transparent" Command="{Binding Test}" FontSize="Medium"/>
            <Button Grid.Column="2" Grid.Row="3" IsVisible="{Binding IsStored}" Text="🗑" Margin="0" Padding="0" Background="Transparent" Command="{Binding Delete}" FontSize="Medium"/>
        </Grid>
    </Frame>
</ContentView>
