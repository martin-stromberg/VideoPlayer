<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Setup"
             x:Class="VideoPlayer.Views.Setup.AdminTasks"
             x:DataType="vm:SettingsViewModel">
    <VerticalStackLayout>
        <Button Text="Anwendung zurücksetzen"
                Command="{Binding Action}" 
                CommandParameter="ResetApp"
                Margin="5"/>
        <Button Text="Daten exportieren"
                Command="{Binding Action}" 
                CommandParameter="Export"
                Margin="5"/>
        <Button Text="Arbeitsspeicherdaten exportieren"
                Command="{Binding Action}" 
                CommandParameter="ExportMemory"
                Margin="5"/>
        <Button Text="Backup exportieren"
                Command="{Binding Action}" 
                CommandParameter="Backup"
                Margin="5"/>
        <Button Text="Alle Einträge neu klassifizieren"
            Command="{Binding Action}" 
            CommandParameter="ReclassifyAll"
            Margin="5"/>
        <Label Text="{Binding StatusMessage}"/>
    </VerticalStackLayout>
</ContentView>
