    // Anzeigename des aktuell gewählten Standby-Clips; ein gelöschtes Medium bleibt als
    // weiche Referenz sichtbar, statt still auf den Standard zurückzufallen — selbsterklärend
    // ohne interne Id, die in keinem Eingabefeld wieder verwendbar wäre. Die verwaiste
    // Auswahl wird dabei auf „Standard" zurückgesetzt: der Chip sagt bereits „Standard-Clip
    // wird verwendet", sonst scheiterte jedes „Speichern" an der toten Referenz.
    private async Task<string> LoadStandbyLabelAsync(long mediaItemId)
    {
        var info = await DbContext.MediaItems
            .AsNoTracking()
            .Where(mi => mi.Id == mediaItemId)
            .Select(mi => new { mi.Name, SourceName = mi.MediaCollection.MediaSource.Name })
            .FirstOrDefaultAsync();
        if (info is null)
        {
            standbyMediaItemId = null;
            return "Zuvor gewählter Clip ist nicht mehr vorhanden — Standard-Clip wird verwendet";
        }

        return $"{info.Name} ({info.SourceName})";
    }

