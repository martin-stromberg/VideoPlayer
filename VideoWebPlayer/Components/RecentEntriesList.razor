@using VideoWebPlayer.Data
@inject IJSRuntime JS
@code {
    [Parameter]
    public List<RecentEntry> RecentEntries { get; set; } = new();

    [Parameter]
    public ApplicationDbContext DbContext { get; set; } = default!;

    private Dictionary<long, string> movieTitles = new();
    private Dictionary<long, string> moviePosters = new();
    private Dictionary<long, string> movieLinks = new();
    private Dictionary<long, string> collectionTitles = new();
    private Dictionary<long, string> collectionPosters = new();
    private Dictionary<long, string> collectionLinks = new();
    private Dictionary<long, string> showTitles = new();
    private Dictionary<long, string> showBanners = new();
    private Dictionary<long, string> showLinks = new();
    private Dictionary<long, string> seasonTitles = new();
    private Dictionary<long, string> seasonBanners = new();
    private Dictionary<long, string> seasonLinks = new();
    private Dictionary<long, string> episodeTitles = new();
    private Dictionary<long, string> episodePosters = new();
    private Dictionary<long, string> episodeLinks = new();

    private ElementReference recentEntriesListRef;

    protected override async Task OnParametersSetAsync()
    {
        // Dictionaries leeren
        movieTitles.Clear();
        moviePosters.Clear();
        movieLinks.Clear();
        collectionTitles.Clear();
        collectionPosters.Clear();
        collectionLinks.Clear();
        showTitles.Clear();
        showBanners.Clear();
        showLinks.Clear();
        seasonTitles.Clear();
        seasonBanners.Clear();
        seasonLinks.Clear();
        episodeTitles.Clear();
        episodePosters.Clear();
        episodeLinks.Clear();

        foreach (var entry in RecentEntries)
        {
            switch (entry.Type)
            {
                case RecentEntryType.Movie:
                    var movie = await DbContext.Movies.FindAsync(entry.MovieId);
                    if (movie != null)
                    {
                        movieTitles[entry.Id] = movie.Name;
                        moviePosters[entry.Id] = movie.PosterPictureId.HasValue ? $"/api/pictures/{movie.PosterPictureId}" : "/images/placeholder.png";
                        movieLinks[entry.Id] = $"/movie/{movie.Id}";
                    }
                    break;
                case RecentEntryType.MovieCollection:
                    var collection = await DbContext.MovieCollections.FindAsync(entry.MovieCollectionId);
                    if (collection != null)
                    {
                        collectionTitles[entry.Id] = collection.Name;
                        collectionPosters[entry.Id] = collection.PosterPictureId.HasValue ? $"/api/pictures/{collection.PosterPictureId}" : "/images/placeholder.png";
                        collectionLinks[entry.Id] = $"/moviecollection/{collection.Id}";
                    }
                    break;
                case RecentEntryType.TVShow:
                    var show = await DbContext.TVShows.FindAsync(entry.TVShowId);
                    if (show != null)
                    {
                        showTitles[entry.Id] = show.Name;
                        showBanners[entry.Id] = show.PosterPictureId.HasValue ? $"/api/pictures/{show.PosterPictureId}"
                            : show.BannerPictureId.HasValue ? $"/api/pictures/{show.BannerPictureId}"
                            : show.FanartPictureId.HasValue ? $"/api/pictures/{show.FanartPictureId}"
                            : "/images/placeholder.png";
                        showLinks[entry.Id] = $"/tvshow/{show.Id}";
                    }
                    break;
                case RecentEntryType.TVShowSeason:
                    var season = await DbContext.TVShowSeasons.FindAsync(entry.TVShowSeasonId);
                    if (season != null)
                    {
                        var showSeason = DbContext.TVShows.FirstOrDefault(rec => rec.Id == season.TVShowId);
                        seasonTitles[entry.Id] = $"{showSeason?.Name ?? ""} - {season.Name}";
                        seasonBanners[entry.Id] = season.PosterPictureId.HasValue ? $"/api/pictures/{season.PosterPictureId}"
                            : season.FanartPictureId.HasValue ? $"/api/pictures/{season.FanartPictureId}"
                            : season.BannerPictureId.HasValue ? $"/api/pictures/{season.BannerPictureId}"
                            : showSeason.PosterPictureId.HasValue ? $"/api/pictures/{showSeason.PosterPictureId}"
                            : showSeason.BannerPictureId.HasValue ? $"/api/pictures/{showSeason.BannerPictureId}"
                            : showSeason.FanartPictureId.HasValue ? $"/api/pictures/{showSeason.FanartPictureId}"
                            : "/images/placeholder.png";
                        seasonLinks[entry.Id] = $"/tvshow/{showSeason?.Id}?season={season.Id}";
                    }
                    break;
                case RecentEntryType.TVShowEpisode:
                    var episode = DbContext.TVShowEpisodes.FirstOrDefault(rec => rec.Id == entry.TVShowEpisodeId);
                    if (episode != null)
                    {
                        var seasonEp = DbContext.TVShowSeasons.FirstOrDefault(rec => rec.Id == episode.TVShowSeasonId);
                        var showEp = DbContext.TVShows.FirstOrDefault(rec => rec.Id == seasonEp.TVShowId);
                        episodeTitles[entry.Id] = $"{showEp?.Name ?? ""} - S{seasonEp?.Name?.Split(' ').Last()}E{episode.Number.ToString().PadLeft(2, '0')}";
                        episodePosters[entry.Id] = episode.PosterPictureId.HasValue ? $"/api/pictures/{episode.PosterPictureId}"
                            : episode.FanartPictureId.HasValue ? $"/api/pictures/{episode.FanartPictureId}"
                            : episode.BannerPictureId.HasValue ? $"/api/pictures/{episode.BannerPictureId}"
                            : seasonEp.PosterPictureId.HasValue ? $"/api/pictures/{seasonEp.PosterPictureId}"
                            : seasonEp.FanartPictureId.HasValue ? $"/api/pictures/{seasonEp.FanartPictureId}"
                            : seasonEp.BannerPictureId.HasValue ? $"/api/pictures/{seasonEp.BannerPictureId}"
                            : showEp.PosterPictureId.HasValue ? $"/api/pictures/{showEp.PosterPictureId}"
                            : showEp.BannerPictureId.HasValue ? $"/api/pictures/{showEp.BannerPictureId}"
                            : showEp.FanartPictureId.HasValue ? $"/api/pictures/{showEp.FanartPictureId}"
                            : "/images/placeholder.png";
                        episodeLinks[entry.Id] = $"/tvshow/{showEp?.Id}?season={seasonEp?.Id}&episode={episode.Id}";
                    }
                    break;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RecentEntries.Any())
        {
            await JS.InvokeVoidAsync("enableHorizontalWheelScroll", ".recent-entries-list");
        }
    }
}

@if (RecentEntries.Any())
{
    <h2>Neu im Programm</h2>
    <div class="recent-entries-list" @ref="recentEntriesListRef">
        @foreach (var entry in RecentEntries)
        {
            if (entry.Type == RecentEntryType.Movie && movieTitles.ContainsKey(entry.Id))
            {
                <a class="media-box-link" href="@movieLinks[entry.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@moviePosters[entry.Id]" alt="@movieTitles[entry.Id]" />
                        <div class="recent-entry-title">@movieTitles[entry.Id]</div>
                    </div>
                </a>
            }
            else if (entry.Type == RecentEntryType.MovieCollection && collectionTitles.ContainsKey(entry.Id))
            {
                <a class="media-box-link" href="@collectionLinks[entry.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@collectionPosters[entry.Id]" alt="@collectionTitles[entry.Id]" />
                        <div class="recent-entry-title">@collectionTitles[entry.Id]</div>
                    </div>
                </a>
            }
            else if (entry.Type == RecentEntryType.TVShow && showTitles.ContainsKey(entry.Id))
            {
                <a class="media-box-link" href="@showLinks[entry.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@showBanners[entry.Id]" alt="@showTitles[entry.Id]" />
                        <div class="recent-entry-title">@showTitles[entry.Id]</div>
                    </div>
                </a>
            }
            else if (entry.Type == RecentEntryType.TVShowSeason && seasonTitles.ContainsKey(entry.Id))
            {
                <a class="media-box-link" href="@seasonLinks[entry.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@seasonBanners[entry.Id]" alt="@seasonTitles[entry.Id]" />
                        <div class="recent-entry-title">@seasonTitles[entry.Id]</div>
                    </div>
                </a>
            }
            else if (entry.Type == RecentEntryType.TVShowEpisode && episodeTitles.ContainsKey(entry.Id))
            {
                <a class="media-box-link" href="@episodeLinks[entry.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@episodePosters[entry.Id]" alt="@episodeTitles[entry.Id]" />
                        <div class="recent-entry-title">@episodeTitles[entry.Id]</div>
                    </div>
                </a>
            }
        }
    </div>
}

            <style>
.recent-entries-list {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 1rem 0;
    margin-bottom: 2rem;
    scrollbar-width: thin;
    scrollbar-color: #23232a #181820;
}
.recent-entries-list::-webkit-scrollbar {
    height: 8px;
    background: #181820;
}
.recent-entries-list::-webkit-scrollbar-thumb {
    background: #23232a;
    border-radius: 4px;
}
.recent-entries-list::-webkit-scrollbar-thumb:hover {
    background: #ffe066;
}
.recent-entry-box {
    min-width: 180px;
    max-width: 220px;
    background: #23232a;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0.5rem 0.5rem 0.5rem;
    transition: box-shadow 0.2s;
    cursor: pointer;
}
.recent-entry-box:hover {
    box-shadow: 0 4px 24px rgba(255,224,102,0.15);
    background: #282838;
}
.recent-entry-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.7rem;
    background: #444;
}
.recent-entry-title {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffe066;
    text-align: center;
    text-shadow: 0 2px 8px #000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
}
.media-box-link {
    text-decoration: none;
    color: inherit;
}
</style>

<script>
window.enableHorizontalWheelScroll = function (selector) {
    var el = document.querySelector(selector);
    if (!el) return;
    el.addEventListener('wheel', function (e) {
        if (e.deltaY === 0) return;
        e.preventDefault();
        el.scrollLeft += e.deltaY;
    }, { passive: false });
};
</script>