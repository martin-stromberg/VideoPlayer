<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mediathek.ViewModels.Homepage;assembly=MediathekMaui"
             xmlns:view="clr-namespace:Mediathek.Views.MediaLists"
             x:Class="Mediathek.Views.Homepage.HorizontalMediaItemCollection"
             x:DataType="vm:LatestViewsViewModel">
    <ScrollView Orientation="Horizontal">
        <CollectionView
            ItemsSource="{Binding Items}"
            ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <view:MediaListItemView/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentView>
