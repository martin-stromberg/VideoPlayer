@page "/admin/security"
@using VideoWebPlayer.Services
@using VideoWebPlayer.Data
@inject ILoginIpBlockService IpBlockService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Sicherheit</PageTitle>

@if (!isAdmin)
{
    <div class="alert alert-danger">Nicht autorisiert.</div>
}
else
{
    <section class="admin-console admin-security-page">
        <header class="admin-page-header">
            <div>
                <span class="admin-kicker">Einrichtung</span>
                <h1>Sicherheit</h1>
                <p>Gesperrte IP-Adressen und fehlgeschlagene Anmeldeversuche.</p>
            </div>
            <div class="admin-header-actions">
                <button class="btn btn-outline-light" @onclick="Reload">Aktualisieren</button>
                <a class="btn btn-ghost" href="/admin">Zurueck</a>
            </div>
        </header>

        <div class="admin-stats-grid">
            <div class="admin-stat-card">
                <span class="admin-stat-label">Gesperrt</span>
                <strong>@blockedIps.Count</strong>
                <small>IP-Adressen</small>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-label">Fehlversuche</span>
                <strong>@blockedIps.Sum(x => x.Failures)</strong>
                <small>seit letzter Bereinigung</small>
            </div>
        </div>

        <div class="admin-card admin-card-wide">
            <div class="admin-card-header">
                <h2>Gesperrte IP-Adressen</h2>
            </div>

            @if (blockedIps.Count == 0)
            {
                <div class="admin-empty-state">
                    <strong>Keine Sperren aktiv</strong>
                    <span>Derzeit sind keine IP-Adressen blockiert.</span>
                </div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>IP</th>
                                <th>Gesperrt seit (UTC)</th>
                                <th>Fehlversuche</th>
                                <th>Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ip in blockedIps)
                            {
                                <tr>
                                    <td class="admin-mono">@ip.Ip</td>
                                    <td class="admin-mono">@ip.BlockedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@ip.Failures</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Unblock(ip.Ip)">Entsperren</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

@code {
    private bool isAdmin;
    private List<BlockedLoginIp> blockedIps = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.HasClaim("IsAdmin", "True");
        if (isAdmin)
            Load();
    }

    private void Load()
    {
        blockedIps = IpBlockService.GetBlockedIps().ToList();
    }

    private Task Reload()
    {
        Load();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Unblock(string ip)
    {
        if (IpBlockService.Unblock(ip))
        {
            blockedIps.RemoveAll(b => b.Ip == ip);
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("localStorage.setItem", "security.lastVisitUtc", DateTime.UtcNow.ToString("o"));
    }
}
