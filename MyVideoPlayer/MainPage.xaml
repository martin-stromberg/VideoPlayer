<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyVideoPlayer.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:v="clr-namespace:MyVideoPlayer.Views"             
             x:Class="MyVideoPlayer.MainPage"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="X"                     
                     Order="Primary"
                     Command="{Binding NavigateBack}"/>
        <ToolbarItem Text="Quellen"                     
             Order="Primary"
             Command="{Binding NavigateToSources}"/>
        <ToolbarItem Text="Quellen neu einlesen"                     
             Order="Secondary"
             Command="{Binding CleanScan}"/>
    </ContentPage.ToolbarItems>    
    <Grid x:DataType="vm:HomePageViewModel">
        <Grid IsVisible="{Binding IsInitializing}" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Lade..."/>
        </Grid>
        <Grid IsVisible="{Binding NavigationVisible}">
            <v:MediaCollectionView BindingContext="{Binding NavigationContent}" IsVisible="{Binding NavigationVisible}"/>
        </Grid>
        <Grid IsVisible="{Binding IsVideoVisible}">
            <v:MediaElementView BindingContext="{Binding MediaElement}" IsVisible="{Binding IsVideoVisible}"/>
        </Grid>        
        <Label Text="{Binding StatusMessage}" VerticalOptions="End"/>
    </Grid>
</ContentPage>
