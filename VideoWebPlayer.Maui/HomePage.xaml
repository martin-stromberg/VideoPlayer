<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:VideoWebPlayer.Maui.Components"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             x:Class="VideoWebPlayer.Maui.HomePage"
             x:DataType="viewmodels:HomePageViewModel"
             BackgroundColor="#000000">

	<components:PageChrome HeaderTitle="Media Player">
		<components:PageChrome.HeaderActions>
			<Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="15" HorizontalOptions="End" VerticalOptions="Center">
             <!-- Settings button: visible on Windows/Desktop -->
				<Button x:Name="SettingsButton" Grid.Column="0"
						Text="⚙"
						FontSize="18"
						BackgroundColor="#FFB84D"
						TextColor="#000000"
						CornerRadius="8"
						Padding="15,8"
						Clicked="OnSettingsClicked"
						VerticalOptions="Center" />

				<!-- Hamburger menu: visible on Android/iOS -->
				<Button x:Name="HamburgerButton" Grid.Column="0"
						Text="☰"
						FontSize="18"
						BackgroundColor="#FFB84D"
						TextColor="#000000"
						CornerRadius="8"
						Padding="15,8"
						Clicked="OnHamburgerClicked"
						VerticalOptions="Center"
						IsVisible="False" />

				<CollectionView Grid.Column="1"
				                ItemsSource="{Binding Sources}"
				                SelectionMode="None"
				                HorizontalOptions="End"
				                VerticalOptions="Center"
				                IsVisible="{Binding IsOnline}">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
					</CollectionView.ItemsLayout>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="viewmodels:MediaSourceViewModel">
							<Border BackgroundColor="#FFB84D"
							        StrokeThickness="0"
							        WidthRequest="50"
							        HeightRequest="50">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="25" />
								</Border.StrokeShape>
								<Border.Shadow>
									<Shadow Brush="#000000"
									        Offset="2,2"
									        Radius="4"
									        Opacity="0.3" />
								</Border.Shadow>
								<Border.GestureRecognizers>
									<TapGestureRecognizer Tapped="OnSourceTapped" />
								</Border.GestureRecognizers>
							<Grid>
								<Label Text="{Binding Icon, TargetNullValue=📁}"
								       FontSize="24"
								       HorizontalOptions="Center"
								       VerticalOptions="Center"
								       IsVisible="False">
									<Label.Triggers>
										<DataTrigger TargetType="Label" Binding="{Binding IconImageSource}" Value="{x:Null}">
											<Setter Property="IsVisible" Value="True" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
								<Image Source="{Binding IconImageSource}"
								       WidthRequest="34"
								       HeightRequest="34"
								       Aspect="AspectFit"
								       HorizontalOptions="Center"
								       VerticalOptions="Center">
									<Image.Triggers>
										<DataTrigger TargetType="Image" Binding="{Binding IconImageSource}" Value="{x:Null}">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</Image.Triggers>
								</Image>
							</Grid>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

				<HorizontalStackLayout Grid.Column="2"
				                       HorizontalOptions="End"
				                       VerticalOptions="Center"
				                       Spacing="15"
				                       IsVisible="{Binding IsOfflineMode}">
					<Label Text="&#x1F6AB;"
					       FontSize="24"
					       TextColor="#FF6B6B" />
					<Label Text="Offline"
					       FontSize="16"
					       TextColor="#FF6B6B"
					       FontAttributes="Bold"
					       VerticalOptions="Center" />

					<Button Text="🔄 Verbinden"
					        FontSize="14"
					        BackgroundColor="#FFB84D"
					        TextColor="#000000"
					        CornerRadius="8"
					        Padding="15,5"
					        Clicked="OnReconnectClicked"
					        VerticalOptions="Center">
						<Button.Shadow>
							<Shadow Brush="#000000"
							        Offset="2,2"
							        Radius="4"
							        Opacity="0.3" />
						</Button.Shadow>
					</Button>
				</HorizontalStackLayout>
			</Grid>
		</components:PageChrome.HeaderActions>

		<components:PageChrome.Body>
			<Grid>
				<ScrollView IsVisible="{Binding IsOnline}">
					<VerticalStackLayout Spacing="35" Padding="0,10,0,20">
						<components:MediaCarousel BindingContext="{Binding ContinueWatching}" />
						<components:MediaCarousel BindingContext="{Binding Favorites}" />
						<components:MediaCarousel BindingContext="{Binding RecentEntries}" />
						<components:MediaCarousel BindingContext="{Binding Downloads}" />
					</VerticalStackLayout>
				</ScrollView>

				<VerticalStackLayout IsVisible="{Binding IsOfflineMode}"
				                     VerticalOptions="Start"
				                     HorizontalOptions="Fill"
				                     Spacing="20"
				                     Padding="40">
					<VerticalStackLayout VerticalOptions="Center"
					                     HorizontalOptions="Center"
					                     Spacing="20"
					                     Padding="0,40">
						<Grid WidthRequest="100" HeightRequest="100" HorizontalOptions="Center">
							<Label Text="📡"
							       FontSize="80"
							       TextColor="#666666"
							       HorizontalOptions="Center"
							       VerticalOptions="Center"
							       Opacity="0.5" />
							<BoxView Color="#FF6B6B"
							         HeightRequest="4"
							         WidthRequest="120"
							         Rotation="45"
							         HorizontalOptions="Center"
							         VerticalOptions="Center" />
						</Grid>
						<Label Text="Offline-Modus"
						       FontSize="28"
						       FontAttributes="Bold"
						       TextColor="#FFDDAA"
						       HorizontalOptions="Center" />
						<Label Text="Der Server ist nicht erreichbar. Bitte überprüfen Sie Ihre Internetverbindung oder die Server-Einstellungen."
						       FontSize="16"
						       TextColor="#CCCCCC"
						       HorizontalOptions="Center"
						       HorizontalTextAlignment="Center"
						       LineBreakMode="WordWrap" />
					</VerticalStackLayout>
					<components:MediaCarousel BindingContext="{Binding Downloads}" />
				</VerticalStackLayout>
			</Grid>
		</components:PageChrome.Body>

		<components:PageChrome.Footer>
			<components:NotificationTicker Margin="20,0" />
		</components:PageChrome.Footer>
	</components:PageChrome>

</ContentPage>
