<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:VideoPlayer.Views;assembly=VideoPlayerMaui"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Global;assembly=VideoPlayerMaui"
             x:Class="VideoPlayer.MainPage"
             x:DataType="vm:ApplicationViewModel"
             Title="{Binding Title}">
    <Grid>
        <Label
            Text="Loading..."
            IsVisible="{Binding IsInitializing}"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
        <Grid
            IsVisible="{Binding IsInitialized}">
            <view:HomePageView 
                BindingContext="{Binding ContentViewModel}" />
        </Grid>
        <view:StatusBar 
            BindingContext="{Binding StatusViewModel}"
            VerticalOptions="End"
            Margin="5"/>
    </Grid>
</ContentPage>
