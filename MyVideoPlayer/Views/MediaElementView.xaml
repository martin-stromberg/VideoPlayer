<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyVideoPlayer.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyVideoPlayer.Views.MediaElementView"
             Unloaded="ContentView_Unloaded">
    <Grid x:DataType="vm:IMediaElementViewModel" IsVisible="{Binding VideoVisible}">
        <toolkit:MediaElement
            x:Name="mediaElement"
            IsVisible="{Binding VideoVisible}"
            ShouldShowPlaybackControls="True"
            ShouldAutoPlay="True"
            Aspect="AspectFill"            
            MediaEnded="mediaElement_MediaEnded"
            MediaFailed="mediaElement_MediaFailed"
            MediaOpened="mediaElement_MediaOpened"
            PositionChanged="mediaElement_PositionChanged"
            SeekCompleted="mediaElement_SeekCompleted"
            Source="{Binding VideoSource}"
            >            
        </toolkit:MediaElement>
    </Grid>
</ContentView>
