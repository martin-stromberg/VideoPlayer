<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.22000.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>VideoPlayer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>VideoPlayer</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.videoplayer</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22000.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22000.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	  <MtouchLink>None</MtouchLink>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-windows10.0.22000.0|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-ios|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-windows10.0.22000.0|AnyCPU'">
	  <ApplicationId>de.MartinStromberg.videoplayer</ApplicationId>
	  <ApplicationIdGuid>9c007b76-9113-46f4-b4ca-d07a17410b22</ApplicationIdGuid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
	  <CodesignKey>Apple Development: Created via API (466MVK852A)</CodesignKey>
	  <CodesignProvision>VS: WildCard Development</CodesignProvision>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#000000" BaseSize="512,512" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#000000" BaseSize="512,512" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiImage Update="Resources\Images\home.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</MauiImage>

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <MauiImage Remove="Resources\Images\abenteuer.png" />
	  <MauiImage Remove="Resources\Images\abenteuer32x32.png" />
	  <MauiImage Remove="Resources\Images\action.png" />
	  <MauiImage Remove="Resources\Images\action32x32.png" />
	  <MauiImage Remove="Resources\Images\animation.png" />
	  <MauiImage Remove="Resources\Images\animation32x32.png" />
	  <MauiImage Remove="Resources\Images\biografie.png" />
	  <MauiImage Remove="Resources\Images\biografie32x32.png" />
	  <MauiImage Remove="Resources\Images\crime.png" />
	  <MauiImage Remove="Resources\Images\crime32x32.png" />
	  <MauiImage Remove="Resources\Images\documentary.png" />
	  <MauiImage Remove="Resources\Images\documentary32x32.png" />
	  <MauiImage Remove="Resources\Images\drama.png" />
	  <MauiImage Remove="Resources\Images\drama32x32.png" />
	  <MauiImage Remove="Resources\Images\familie.png" />
	  <MauiImage Remove="Resources\Images\familie32x32.png" />
	  <MauiImage Remove="Resources\Images\fantasy.png" />
	  <MauiImage Remove="Resources\Images\fantasy32x32.png" />
	  <MauiImage Remove="Resources\Images\komodie.png" />
	  <MauiImage Remove="Resources\Images\komodie32x32.png" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Images\movie_collection32x32.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.1.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.82" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.82" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VideoPlayer.Core\VideoPlayer.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\icons.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>icons.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\videos.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>videos.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\secrets.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>secrets.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\icons.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>icons.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Properties\videos.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>videos.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Properties\secrets.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>secrets.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Raw\" />
	</ItemGroup>

	<ProjectExtensions><VisualStudio><UserProperties XamarinHotReloadDebuggerTimeoutExceptionVideoPlayerHideInfoBar="True" /></VisualStudio></ProjectExtensions>

</Project>
