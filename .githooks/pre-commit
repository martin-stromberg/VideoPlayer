#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"

if ! command -v dotnet >/dev/null 2>&1; then
  echo "Markdown link check failed: dotnet was not found. Install the .NET 10 SDK or disable the repository hook path." >&2
  exit 1
fi

dotnet run --no-restore --project "$repo_root/tools/SecretScan/SecretScan.csproj" -- --root "$repo_root"
dotnet run --no-restore --project "$repo_root/tools/MarkdownLinkCheck/MarkdownLinkCheck.csproj" -- --root "$repo_root"
