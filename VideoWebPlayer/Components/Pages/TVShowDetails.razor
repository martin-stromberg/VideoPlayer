@page "/tvshow/{Id:long}"
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VideoWebPlayer.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

@code {
    [Parameter]
    public long Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "season")]
    public long? SeasonId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "episode")]
    public long? EpisodeId { get; set; }

    private TVShow? show;
    private TVShowSeason? selectedSeason;
    private TVShowEpisode? selectedEpisode;
    private bool showSeasonInfo = false;
    private bool showPlayer = false;
    private bool isAuthenticated;
    private bool isFavorite = false; // Neu: Favoritenstatus

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        show = await DbContext.TVShows
            .Include(ts => ts.Seasons)
                .ThenInclude(s => s.Episodes)
            .FirstOrDefaultAsync(ts => ts.Id == Id);

        // Standard: erste Staffel
        selectedSeason = show?.Seasons?.OrderBy(s => s.Name).FirstOrDefault();
        showSeasonInfo = false;

        // Falls SeasonId gesetzt ist, wähle die entsprechende Staffel
        if (SeasonId.HasValue && show?.Seasons != null)
        {
            var season = show.Seasons.FirstOrDefault(s => s.Id == SeasonId.Value);
            if (season != null)
            {
                selectedSeason = season;
                showSeasonInfo = true;
            }
        }

        // Falls EpisodeId gesetzt ist, wähle die entsprechende Episode
        if (EpisodeId.HasValue && selectedSeason?.Episodes != null)
        {
            var episode = selectedSeason.Episodes.FirstOrDefault(e => e.Id == EpisodeId.Value);
            if (episode != null)
            {
                selectedEpisode = episode;
            }
        }

        await UpdateFavoriteMark();
    }
    private async Task UpdateFavoriteMark()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (showSeasonInfo)
            isFavorite = DbContext.IsFavorite(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), (MediaBaseEntry)selectedEpisode ?? (MediaBaseEntry)selectedSeason);
        else
            isFavorite = DbContext.IsFavorite(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), (MediaBaseEntry)selectedEpisode ?? (MediaBaseEntry)show);
    }

    private async Task SelectSeason(TVShowSeason season)
    {
        selectedSeason = season;
        selectedEpisode = null;
        showSeasonInfo = true;
        await UpdateFavoriteMark();
    }

    private async Task SelectEpisode(TVShowEpisode episode)
    {
        selectedEpisode = episode;
        await UpdateFavoriteMark();
    }

    private async Task ShowSeason()
    {
        selectedEpisode = null;
        showSeasonInfo = true;
        await UpdateFavoriteMark();
    }

    private string GetBannerUrl(MediaBaseEntry entry)
        => entry.BannerPictureId.HasValue ? $"/api/pictures/{entry.BannerPictureId}" : entry.FanartPictureId.HasValue ? $"/api/pictures/{entry.FanartPictureId}" : "/images/placeholder.png";

    private string GetPosterUrl(MediaBaseEntry entry)
        => entry.PosterPictureId.HasValue ? $"/api/pictures/{entry.PosterPictureId}" : entry.FanartPictureId.HasValue ? $"/api/pictures/{entry.FanartPictureId}" : "/images/placeholder.png";

    private void ShowPlayer()
    {
        showPlayer = true;
    }
    private void HidePlayer()
    {
        showPlayer = false;
    }

    private string GetEpisodeStreamUrl(TVShowEpisode episode)
    {
        return $"/api/episodes/{episode.Id}/stream";
    }

    private string GetEpisodeDownloadUrl(TVShowEpisode episode)
    {
        var episodeMediaItem = DbContext.TVShowEpisodeMediaItems.FirstOrDefault(mmi => mmi.TVShowEpisodeId == episode.Id);
        var mediaItemId = episodeMediaItem?.MediaItemId;
        return mediaItemId != null ? $"/api/mediaitems/{mediaItemId}/download" : "#";
    }

    private async Task ToggleFavorite()
    {
        var userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (showSeasonInfo)
            isFavorite = await DbContext.ToggleFavoriteAsync(userId, (MediaBaseEntry)selectedEpisode ?? (MediaBaseEntry)selectedSeason);
        else
            isFavorite = await DbContext.ToggleFavoriteAsync(userId, (MediaBaseEntry)selectedEpisode ?? (MediaBaseEntry)show);
    }
    private string GetTitle()
    {
        return $"{show.Name} • {selectedSeason?.Name} {selectedEpisode?.Name}";
    }
}

@if (!isAuthenticated)
{
    <PageTitle>Anmeldung erforderlich</PageTitle>
    <div class="alert alert-warning">
        Bitte melden Sie sich an, um Episoden abzuspielen oder herunterzuladen.
    </div>
}
else if (show == null)
{
    <PageTitle>Unbekannt</PageTitle>
    <div class="alert alert-danger">TV-Show nicht gefunden.</div>
}
else
{
    <PageTitle>@GetTitle()</PageTitle>
    <div class="tvshow-header" style="background-image: url('@GetBannerUrl((MediaBaseEntry)selectedEpisode ?? (showSeasonInfo ? (MediaBaseEntry)selectedSeason : (MediaBaseEntry)show))'); position: relative;">
        <button class="favorite-btn" @onclick="ToggleFavorite" title="Als Favorit markieren">
            @(isFavorite ? "★" : "☆")
        </button>
        <div class="tvshow-header-overlay">
            @if (selectedEpisode != null)
            {
                <button class="play-button" @onclick="ShowPlayer" title="Abspielen">
                    <span>&#9654;</span>
                </button>
                <button class="back-arrow" @onclick="ShowSeason" title="Zurück zur Staffel">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                        <path d="M15 6l-6 6 6 6" stroke="#ffe066" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            <div class="tvshow-header-content">
                @if (selectedEpisode != null)
                {
                    <h1>@selectedEpisode.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@selectedEpisode.ReleaseDate?.Year</span>
                        <span class="tvshow-episode-number">Episode @selectedEpisode.Number</span>
                    </div>
                    <div class="tvshow-plot">@selectedEpisode.Plot</div>
                }
                else if (showSeasonInfo && selectedSeason != null)
                {
                    <h1>@show.Name – @selectedSeason.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@selectedSeason.PremieredAt?.Year</span>
                        <span class="tvshow-episode-count">@(selectedSeason.Episodes?.Count() ?? 0) Episoden</span>
                    </div>
                    <div class="tvshow-plot"></div>
                }
                else
                {
                    <h1>@show.Name</h1>
                    <div class="tvshow-meta">
                        <span class="tvshow-year">@show.PremieredAt?.Year</span>
                        <span class="tvshow-genres">@show.Genres</span>
                    </div>
                    <div class="tvshow-plot">@show.Plot</div>
                }
            </div>
        </div>
    </div>

    <div class="tvshow-content-flex">
        <!-- Staffel-Auswahl -->
        @if (show.Seasons?.Any() == true)
        {
            <div class="season-select-bar">
                        <select class="form-select" @onchange="OnSeasonChanged">
                            @foreach (var season in show.Seasons.OrderBy(s => s.Name))
                            {
                                <option value="@season.Id" selected="@(season.Id == selectedSeason?.Id)">
                                    @season.Name
                            </option>
                            }
                        </select>

                        @code {
                            private void OnSeasonChanged(ChangeEventArgs e)
                            {
                                if (long.TryParse(e.Value?.ToString(), out var seasonId))
                                {
                                    var season = show.Seasons.FirstOrDefault(s => s.Id == seasonId);
                                    if (season != null)
                                    {
                                        SelectSeason(season);
                                    }
                                }
                            }
                        }
            </div>
        }

        <!-- Episodenliste -->
        @if (selectedSeason != null)
        {
            <div class="episode-list">
                @foreach (var episode in selectedSeason.Episodes.OrderBy(e => e.Number))
                {
                    var isSelected = selectedEpisode?.Id == episode.Id;
                    <div class="episode-box @(isSelected ? "selected" : "")" @onclick="() => SelectEpisode(episode)">
                        <img class="episode-poster episode-poster-left" src="@GetPosterUrl(episode)" alt="@episode.Name" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                        <div class="episode-info">
                            <div class="episode-title">@episode.Number ‧ @episode.Name</div>
                            <div class="episode-plot">@episode.Plot</div>
                        </div>
                        <a class="episode-download-btn"
                           href="@GetEpisodeDownloadUrl(episode)"
                           title="Episode herunterladen"
                           @onclick:stopPropagation>
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="10" stroke="#ffe066" stroke-width="2" fill="none"/>
                                <path d="M12 7v7m0 0l-3-3m3 3l3-3M7 17h10" stroke="#ffe066" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    @if (showPlayer && selectedEpisode != null)
    {
        <div class="player-overlay">
            <div class="player-content">
                <video src="@GetEpisodeStreamUrl(selectedEpisode)" controls autoplay style="max-width:900px;"></video>
                <button class="close-player" @onclick="HidePlayer">&#10006;</button>
            </div>
        </div>
    }

    <!-- Favoriten-Button (neu hinzugefügt) -->
}

<style>
    .tvshow-header {
        position: relative;
        height: 320px;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        margin-bottom: 2rem;
        background-color: #22222a;
        box-shadow: 0 8px 32px rgba(0,0,0,0.7);
    }
    .tvshow-header-overlay {
        width: 100%;
        height: 100%;
        background: linear-gradient(to top, rgba(24,24,32,0.95) 70%, rgba(24,24,32,0.5) 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        padding-top: 3.5rem;
        box-sizing: border-box;
    }
    .tvshow-header-content {
        padding: 1rem 1rem 1rem 1rem;
        color: #fff;
        z-index: 2;
        text-shadow: 0 2px 8px #000;
        max-height: 380px;
        overflow: hidden;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }
    .tvshow-meta {
        margin-top: 0.5rem;
        font-size: 1.1rem;
        color: #b0b0b0;
        display: flex;
        gap: 2rem;
    }
    .tvshow-year, .tvshow-genres, .tvshow-episode-number, .tvshow-episode-count {
        font-weight: bold;
    }
    .tvshow-plot {
        margin-top: 1rem;
        font-size: 1.05rem;
        color: #b0b0b0;
        max-width: 800px;
        word-break: break-word;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
    }
    .season-select-bar {
        margin: 0 0 2rem 0;
        padding: 0 1rem;
        max-width: 400px;
        flex: 0 0 auto;
    }
    .episode-list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin-bottom: 2rem;
        padding-right: 8px;
        scrollbar-width: thin;
        scrollbar-color: #23232a #181820;
    }

    /* Optional: Scrollbar-Design für Webkit-Browser */
    .episode-list::-webkit-scrollbar {
        width: 8px;
        background: #181820;
    }
    .episode-list::-webkit-scrollbar-thumb {
        background: #23232a;
        border-radius: 4px;
    }
    .episode-list::-webkit-scrollbar-thumb:hover {
        background: #ffe066;
    }
    .episode-box {
        display: flex;
        align-items: stretch;
        background: #23232a;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.7);
        cursor: pointer;
        width: 100%;
        min-height: 140px; /* Mehr Platz für Titel und Plot */
        transition: box-shadow 0.2s;
        position: relative;
    }
    .episode-box:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.9);
        background: #282838;
    }
    .episode-box.selected {
        border: 2px solid #ffe066;
        background: #282838;
    }
    .episode-info {
        flex: 1 1 auto;
        padding: 1.4rem 1.2rem 1.4rem 1.2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }
    .episode-title {
        font-size: 1.25rem;
        font-weight: bold;
        color: #ffe066;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 8px #000;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Titel kann auf zwei Zeilen umbrechen */
        -webkit-box-orient: vertical;
        white-space: normal;
    }
    .episode-plot {
        font-size: 0.8rem;
        color: #b0b0b0;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3; /* Weniger Zeilen für Plot */
        -webkit-box-orient: vertical;
        word-break: break-word;
    }
    .episode-poster {
        width: 120px;
        height: 100%;
        object-fit: cover;
        border-radius: 0 10px 10px 0;
        background: #444;
        flex-shrink: 0;
        display: block;
    }
    .episode-poster-left {
        border-radius: 10px 0 0 10px; /* Nur links abrunden */
