@using Microsoft.AspNetCore.Components.Authorization
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Events
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Services.EventManager EventManager

@code {
    private List<ContinueWatchingDto> Items = new();
    private static readonly MediaBoxAction[] ContextActions =
    [
        new("hide", "Ausblenden"),
        new("skip", "Überspringen")
    ];

    private readonly Dictionary<long, string> titles = new();
    private readonly Dictionary<long, string> images = new();
    private readonly Dictionary<long, string> links = new();

    private ElementReference listRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await Client.EnsureAuthorizationTokenAsync(authState.User);
        await LoadItemsAsync();
        await base.OnInitializedAsync();
    }

    private async Task<bool> LoadItemsAsync()
    {
        List<ContinueWatchingDto> loadedItems;
        try
        {
            loadedItems = (await Client.RequestContinueWatchingAsync())
                .Where(e => e.Entry is not null)
                .ToList();
        }
        catch (Exception ex)
        {
            PublishStatus($"Fehler beim Aktualisieren der Weiterschauen-Liste: {ex.Message}");
            return false;
        }

        Items = loadedItems;

        titles.Clear();
        images.Clear();
        links.Clear();

        foreach (var it in Items)
        {
            titles[it.Entry.Id] = it.Title ?? "";
            images[it.Entry.Id] = it.PosterPictureId.HasValue
                ? $"/api/pictures/{it.PosterPictureId}?access_token={Client.AuthorizationToken}"
                : "/images/placeholder.png";

            // Link ableiten: einfache Heuristik (wie in RecentEntriesList für Movie),
            // optional später durch genauere Auflösung ersetzen
            if (it.MediaType == "movie" && it.Entry is DtoMovie movie && movie.Collection is not null)
            {
                // Falls es eine dedizierte Movie-Seite gibt (RecentEntries nutzt /movie/{id})
                links[it.Entry.Id] = $"/moviecollection/{movie.Collection.Id}?movie={it.Entry.Id}&position={it.PositionSeconds}";
            }
            else if (it.MediaType == "episode" && it.Entry is DtoTVShowEpisode episode && episode.Season?.Show is not null)
            {
                // Fallback-Link für Episode; bei Bedarf auf /tvshow/{showId}?season={seasonId}&episode={episodeId} erweitern
                links[it.Entry.Id] = $"/tvshow/{episode.Season.Show.Id}?season={episode.Season.Id}&episode={it.Entry.Id}&position={it.PositionSeconds}";
            }
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Items.Any())
        {
            await JS.InvokeVoidAsync("enableHorizontalWheelScroll", ".continue-watching-list");
        }
    }

    private async Task HandleContextActionAsync(ContinueWatchingDto item, string action)
    {
        if (item.Entry is null)
            return;

        try
        {
            ContinueWatchingMutationResult result = action switch
            {
                "hide" => await Client.HideContinueWatchingAsync(item.MediaType, item.Entry.Id),
                "skip" => await Client.SkipContinueWatchingAsync(item.MediaType, item.Entry.Id),
                _ => new ContinueWatchingMutationResult("ignored", "Aktion ist nicht verfügbar.")
            };

            if (await LoadItemsAsync())
            {
                PublishStatus(result.Message);
            }
            else
            {
                PublishStatus($"{result.Message} Die Liste konnte danach nicht aktualisiert werden.");
            }
        }
        catch (Exception ex)
        {
            PublishStatus($"Fehler: {ex.Message}");
        }
    }

    private void PublishStatus(string message)
    {
        EventManager.Publish(new BackgroundProcessingStatusEvent(message, DateTimeOffset.Now));
    }
}

@if (Items.Any())
{
    <section class="media-section" aria-labelledby="continue-watching-title">
        <h2 id="continue-watching-title">Weiterschauen</h2>
        <div class="continue-watching-list" @ref="listRef">
            @foreach (var it in Items)
            {
                if (titles.ContainsKey(it.Entry.Id))
                {
                    <MediaBox @key="it.Entry.Id"
                              Title="@titles[it.Entry.Id]"
                              ImageUrl="@images[it.Entry.Id]"
                              LinkUrl="@links[it.Entry.Id]"
                              WatchedAt="@it.WatchedAt"
                              CardKey="@($"continue-{it.MediaType}-{it.Entry.Id}")"
                              Actions="@ContextActions"
                              OnActionSelected="action => HandleContextActionAsync(it, action)" />
                }
            }
        </div>
    </section>
}

<script>
window.enableHorizontalWheelScroll = window.enableHorizontalWheelScroll || function (selector) {
    var el = document.querySelector(selector);
    if (!el) return;
    el.addEventListener('wheel', function (e) {
        if (e.deltaY === 0) return;
        e.preventDefault();
        el.scrollLeft += e.deltaY;
    }, { passive: false });
};
</script>
