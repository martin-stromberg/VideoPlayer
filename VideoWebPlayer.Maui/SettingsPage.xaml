<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoWebPlayer.Maui.SettingsPage"
             Title="Server Einstellungen">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Bitte geben Sie die Serveradresse ein:" />
        <Entry x:Name="ServerEntry" Placeholder="http://192.168.1.100:5000" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Automatisch suchen" Clicked="OnDiscoverClicked" />
            <Button Text="Verbindung herstellen" Clicked="OnSaveClicked" />
            <Button Text="Abbrechen" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
        <Label x:Name="StatusLabel" TextColor="Gray" />
    </VerticalStackLayout>

</ContentPage>
