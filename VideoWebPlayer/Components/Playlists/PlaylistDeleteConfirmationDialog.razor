<ConfirmationDialog Title="Playlist loeschen" OnConfirm="OnConfirm" OnCancel="OnCancel"
                    ConfirmButtonText="Loeschen" ConfirmButtonId="confirm-delete-playlist-button" CancelButtonId="cancel-delete-playlist-button">
    <p>Moechten Sie die Playlist "@PlaylistName" wirklich loeschen?</p>
</ConfirmationDialog>

@code {
    [Parameter]
    public string? PlaylistName { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
