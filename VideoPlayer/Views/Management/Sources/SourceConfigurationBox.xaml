<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Management.Sources;assembly=VideoPlayerMaui"
             xmlns:view="clr-namespace:VideoPlayer.Views.Management.Sources"
             x:Class="VideoPlayer.Views.Management.Sources.SourceConfigurationBox"
             x:DataType="vm:SourceSettingsViewModel">
    <Frame Margin="5" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Text="{Binding Title}"/>
            <view:SourceFTPConfigurationBox Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsFTP}"/>

            <Button Grid.Column="1" Grid.Row="0" Text="🔄" Margin="0" Padding="0" Background="Transparent" Command="{Binding Rescan}" FontSize="Large"/>
            <Button Grid.Column="1" Grid.Row="1" Text="🧹" Margin="0" Padding="0" Background="Transparent" Command="{Binding Clean}" FontSize="Medium"/>
        </Grid>
    </Frame>
</ContentView>
