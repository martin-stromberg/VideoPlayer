<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:VideoWebPlayer.Maui.Components"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             x:Class="VideoWebPlayer.Maui.MainPage"
             x:DataType="viewmodels:HomePageViewModel"
             BackgroundColor="#000000">

    <components:PageChrome x:Name="HomeChrome" HeaderTitle="Media Player" IsVisible="False">
        <components:PageChrome.HeaderActions>
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="15" HorizontalOptions="End" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="2"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Spacing="15"
                                       IsVisible="{Binding IsOfflineMode}">
                    <Label Text="&#x1F6AB;"
                           FontSize="24"
                           TextColor="#FF6B6B" />
                    <Label Text="Offline"
                           FontSize="16"
                           TextColor="#FF6B6B"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <Button Text="🔄 Verbinden"
                            FontSize="14"
                            BackgroundColor="#FFB84D"
                            TextColor="#000000"
                            CornerRadius="8"
                            Padding="15,5"
                            Clicked="OnReconnectClicked"
                            VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="2,2"
                                    Radius="4"
                                    Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                </HorizontalStackLayout>
            </Grid>
        </components:PageChrome.HeaderActions>

        <components:PageChrome.Body>
            <Grid>
                <ScrollView IsVisible="{Binding IsOnline}">
                    <VerticalStackLayout Spacing="35" Padding="0,10,0,20">
                        <components:MediaCarousel BindingContext="{Binding ContinueWatching}" />
                        <components:MediaCarousel BindingContext="{Binding Favorites}" />
                        <components:MediaCarousel BindingContext="{Binding RecentEntries}" />
                        <components:MediaCarousel BindingContext="{Binding Downloads}" />
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout IsVisible="{Binding IsOfflineMode}"
                                     VerticalOptions="Start"
                                     HorizontalOptions="Fill"
                                     Spacing="20"
                                     Padding="40">
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="20"
                                         Padding="0,40">
                        <Grid WidthRequest="100" HeightRequest="100" HorizontalOptions="Center">
                            <Label Text="📡"
                                   FontSize="80"
                                   TextColor="#666666"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Opacity="0.5" />
                            <BoxView Color="#FF6B6B"
                                     HeightRequest="4"
                                     WidthRequest="120"
                                     Rotation="45"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Offline-Modus"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#FFDDAA"
                               HorizontalOptions="Center" />
                        <Label Text="Der Server ist nicht erreichbar. Bitte überprüfen Sie Ihre Internetverbindung oder die Server-Einstellungen."
                               FontSize="16"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <components:MediaCarousel BindingContext="{Binding Downloads}" />
                </VerticalStackLayout>
                <!-- Connecting overlay -->
                <AbsoluteLayout IsVisible="{Binding IsLoading}" BackgroundColor="#80000000" Padding="20">
                    <Frame AbsoluteLayout.LayoutBounds="0.5,0.5,0.8,0.2" AbsoluteLayout.LayoutFlags="All" CornerRadius="12" BackgroundColor="#111111" HasShadow="True">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#FFDDAA" WidthRequest="36" HeightRequest="36" />
                            <Label Text="Verbindung wird hergestellt..." TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </AbsoluteLayout>
            </Grid>
        </components:PageChrome.Body>

        <components:PageChrome.Footer>
            <components:NotificationTicker Margin="20,0" />
        </components:PageChrome.Footer>
    </components:PageChrome>

</ContentPage>
