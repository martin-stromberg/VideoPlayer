@page "/moviecollection/{Id:long}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@rendermode InteractiveServer

@if (!isAuthenticated)
{
    <div class="alert alert-warning">
        Bitte melden Sie sich an, um Filme abzuspielen oder herunterzuladen.
    </div>
}
else if (collection == null)
{
    <div class="alert alert-danger">Sammlung nicht gefunden.</div>
}
else if (selectedMovie != null)
{
    <div class="movie-header" style="background-image: url('@GetBannerUrl(selectedMovie)'); position: relative;">
        <button class="favorite-btn" @onclick="() => ToggleFavorite(selectedMovie)" title="Film als Favorit markieren">
            @((IsMovieFavorite) ? "★" : "☆")
        </button>
        @RenderActionButtons()
        <div class="collection-header-overlay">
            @if (collection?.Movies?.Length > 1)
            {
                <button class="back-arrow" @onclick="ShowCollection" title="Zurueck zur Sammlung">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                        <path d="M15 6l-6 6 6 6" stroke="#ffe066" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            <div class="collection-header-content">
                @if (isEditing)
                {
                    @RenderEditForm()
                }
                else
                {
                    <h1>@selectedMovie.Name</h1>
                    <div class="collection-meta">
                        <span class="collection-year">@GetYear(selectedMovie)</span>
                        <span class="collection-genres">@GetGenres(selectedMovie)</span>
                    </div>
                    <div class="collection-plot">@selectedMovie.Plot</div>
                }
            </div>
            @if (!isEditing)
            {
                <button class="play-button" @onclick="ShowPlayer">
                    <span>&#9654;</span>
                </button>
            }
        </div>
    </div>
    @if (!isEditing)
    {
        <div class="media-section">
            <a class="btn btn-primary"
               href="@GetDownloadUrl(selectedMovie)"
               download>
                Video herunterladen
            </a>
        </div>
    }
    @if (showPlayer && selectedMovie != null)
    {
        <VideoPlayer @ref="_player"
                     Show="showPlayer"
                     StreamUrl="@GetMovieStreamUrl(selectedMovie)"
                     OnClose="HidePlayer"
                     MediaType="movie"
                     MediaId="@selectedMovie.Id"
                     AuthToken="@Client.AuthorizationToken"
                     StartPositionSeconds="@(resumeSeconds)"
                     PositionChanged="OnPositionChanged" />
    }
}
else
{
    <div class="collection-header" style="background-image: url('@GetBannerUrl(collection)'); position: relative;">
        <button class="favorite-btn" @onclick="() => ToggleFavorite(null)" title="Sammlung als Favorit markieren">
            @((IsCollectionFavorite) ? "★" : "☆")
        </button>
        @RenderActionButtons()
        <div class="collection-header-overlay">
            <div class="collection-header-content">
                @if (isEditing)
                {
                    @RenderEditForm()
                }
                else
                {
                    <h1>@collection.Name</h1>
                    <div class="collection-meta">
                        <span class="collection-year">@GetYear(collection)</span>
                        <span class="collection-genres">@GetGenres(collection)</span>
                    </div>
                    <div class="collection-plot"></div>
                }
            </div>
            @if (!isEditing)
            {
                <button class="play-button" @onclick="ShowFirstMovie">
                    <span>&#9654;</span>
                </button>
            }
        </div>
    </div>
    <div class="movie-list-horizontal" id="movieListHorizontal">
        @foreach (var movie in collection.Movies.OrderBy(m => m.ReleaseDate).ThenBy(m => m.PremieredAt).ThenBy(m => m.Name))
        {
            var name = movie.Name;
            if (name.StartsWith(collection.Name))
                name = name.Remove(0, collection.Name.Length).TrimStart(' ', ':', '-');
            if (string.IsNullOrWhiteSpace(name) || (name.Length <= 3)) name = movie.Name;
            <div class="media-box"
                 role="button"
                 tabindex="0"
                 @onclick="() => SelectMovieAsync(movie)"
                 @onkeydown="args => SelectMovieByKeyboard(args, movie)"
                 title="@movie.Name">
                <img class="media-poster"
                     src="@GetPosterUrl(movie)"
                     alt="@movie.Name"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                <span class="media-quick-play" aria-hidden="true">&#9654;</span>
                <div class="media-card-overlay">
                    <span class="media-title-text">@name</span>
                </div>
            </div>
        }
    </div>
}

@if (showDiscardDialog)
{
    <div class="metadata-dialog-overlay">
        <div class="metadata-dialog">
            <h2>Aenderungen verwerfen?</h2>
            <div class="metadata-dialog-actions">
                <button class="btn btn-primary" @onclick="DiscardAndContinueAsync">Aenderungen verwerfen</button>
                <button class="btn btn-ghost" @onclick="ContinueEditing">Weiter bearbeiten</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name = "movie")] public long? MovieId { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "position")] public long? Position { get; set; }

    private DtoMovieCollection? collection;
    private DtoMovie? selectedMovie;
    private List<DtoGenreOption> genreOptions = [];
    private bool showPlayer;
    private bool isAuthenticated;
    private bool isAdmin;
    private bool IsCollectionFavorite;
    private bool IsMovieFavorite;
    private long resumeSeconds;
    private VideoPlayer? _player;

    private bool isEditing;
    private bool isDirty;
    private bool editSupportsPlot;
    private bool editSupportsGenres;
    private string editObjectType = "";
    private long editId;
    private string editName = "";
    private DateTime? editDate;
    private string editPlot = "";
    private string editNewGenres = "";
    private string? editError;
    private HashSet<string> editGenres = new(StringComparer.OrdinalIgnoreCase);
    private bool showDiscardDialog;
    private Func<Task>? pendingDiscardAction;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        isAdmin = isAuthenticated && authState.User.HasClaim("IsAdmin", "True");

        collection = await Client.RequestMovieCollectionAsync(Id) as DtoMovieCollection;
        genreOptions = await Client.RequestGenreOptionsAsync();
        IsCollectionFavorite = await CheckIfFavorite(collectionId: collection, movieId: null);

        if (MovieId.HasValue && collection?.Movies != null)
        {
            var movie = collection.Movies.FirstOrDefault(m => m.Id == MovieId.Value);
            if (movie != null)
                await SelectMovieCoreAsync(movie, false);
        }
        if (Position.HasValue && selectedMovie is not null)
        {
            AutoPlay(Position.Value);
            Position = 0;
        }
    }

    private RenderFragment RenderActionButtons() => builder =>
    {
        if (!isAdmin)
            return;

        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "metadata-action-bar");
        if (isEditing)
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "metadata-icon-btn");
            builder.AddAttribute(seq++, "title", "Speichern");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, SaveEditAsync));
            builder.AddContent(seq++, "✓");
            builder.CloseElement();
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "metadata-icon-btn");
            builder.AddAttribute(seq++, "title", "Abbrechen");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, CancelEditAsync));
            builder.AddContent(seq++, "×");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "metadata-icon-btn");
            builder.AddAttribute(seq++, "title", "Bearbeiten");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, BeginEditCurrent));
            builder.AddContent(seq++, "✎");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RenderEditForm() => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "metadata-edit-form");
        if (!string.IsNullOrWhiteSpace(editError))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "metadata-edit-error");
            builder.AddContent(seq++, editError);
            builder.CloseElement();
        }
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "class", "form-control metadata-title-input");
        builder.AddAttribute(seq++, "value", editName);
        builder.AddAttribute(seq++, "maxlength", "512");
        builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnEditNameChanged));
        builder.CloseElement();
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "class", "form-control metadata-date-input");
        builder.AddAttribute(seq++, "type", "date");
        builder.AddAttribute(seq++, "value", FormatDate(editDate));
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, OnEditDateChanged));
        builder.CloseElement();
        if (editSupportsGenres)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "genre-scrollbar metadata-genre-scrollbar");
            foreach (var genre in genreOptions)
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "class", $"genre-btn {(editGenres.Contains(genre.Name) ? "selected" : "")}");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleEditGenre(genre.Name)));
                builder.AddContent(seq++, genre.Name);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "form-control");
            builder.AddAttribute(seq++, "value", editNewGenres);
            builder.AddAttribute(seq++, "placeholder", "Weitere Genres");
            builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnEditNewGenresChanged));
            builder.CloseElement();
        }
        if (editSupportsPlot)
        {
            builder.OpenElement(seq++, "textarea");
            builder.AddAttribute(seq++, "class", "form-control metadata-plot-input");
            builder.AddAttribute(seq++, "value", editPlot);
            builder.AddAttribute(seq++, "maxlength", "10000");
            builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnEditPlotChanged));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private string GetBannerUrl(DtoMovieCollection col)
        => col.BannerPictureId.HasValue ? $"/api/pictures/{col.BannerPictureId}?access_token={Client.AuthorizationToken}" : col.FanartPictureId.HasValue ? $"/api/pictures/{col.FanartPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";

    private string GetBannerUrl(DtoMovie movie)
        => movie.BannerPictureId.HasValue ? $"/api/pictures/{movie.BannerPictureId}?access_token={Client.AuthorizationToken}" : movie.FanartPictureId.HasValue ? $"/api/pictures/{movie.FanartPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";

    private string GetPosterUrl(DtoMovie movie)
        => movie.PosterPictureId.HasValue ? $"/api/pictures/{movie.PosterPictureId}?access_token={Client.AuthorizationToken}" : movie.FanartPictureId.HasValue ? $"/api/pictures/{movie.FanartPictureId}?access_token={Client.AuthorizationToken}" : "/images/placeholder.png";

    private string GetYear(DtoMovieCollection col)
        => col.ReleaseDate?.Year.ToString() ?? col.Movies?.Where(m => m.ReleaseDate != DateTime.MinValue)?.OrderBy(m => m.ReleaseDate)?.FirstOrDefault()?.ReleaseDate?.Year.ToString() ?? "";

    private string GetYear(DtoMovie movie)
        => movie.ReleaseDate?.Year.ToString() ?? "";

    private string GetGenres(DtoMovieCollection col)
        => string.Join(", ", col.Movies?.SelectMany(m => SplitGenres(m.GenreNames)).Distinct(StringComparer.OrdinalIgnoreCase) ?? []);

    private string GetGenres(DtoMovie movie)
        => movie.GenreNames ?? "";

    private void ShowPlayer() => showPlayer = true;

    private async Task HidePlayer()
    {
        if (_player != null)
        {
            try
            {
                var pos = await _player.GetCurrentPositionSecondsAsync();
                resumeSeconds = (long)Math.Floor(pos);
            }
            catch { }
        }
        showPlayer = false;
        StateHasChanged();
    }

    private void AutoPlay(long position)
    {
        resumeSeconds = position;
        ShowPlayer();
    }

    private string GetMovieStreamUrl(DtoMovie movie)
        => $"/api/items/movie/{movie.Id}/stream?access_token={Client.AuthorizationToken}";

    private async Task SelectMovieAsync(DtoMovie movie)
        => await RunWithDirtyCheckAsync(async () => await SelectMovieCoreAsync(movie, isEditing));

    private async Task SelectMovieCoreAsync(DtoMovie movie, bool editAfterSwitch)
    {
        selectedMovie = movie;
        resumeSeconds = 0;
        showPlayer = false;
        IsMovieFavorite = await CheckIfFavorite(collectionId: null, movieId: selectedMovie);
        if (editAfterSwitch)
            BeginEdit(movie);
    }

    private async Task SelectMovieByKeyboard(KeyboardEventArgs args, DtoMovie movie)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
            await SelectMovieAsync(movie);
    }

    private async Task ShowCollection()
        => await RunWithDirtyCheckAsync(() =>
        {
            selectedMovie = null;
            showPlayer = false;
            if (isEditing && collection is not null)
                BeginEdit(collection);
            return Task.CompletedTask;
        });

    private async Task ShowFirstMovie()
    {
        if (collection?.Movies?.Any() == true)
            await SelectMovieAsync(collection.Movies.First());
    }

    private string GetDownloadUrl(DtoMovie movie)
        => $"/api/items/movie/{movie.Id}/download?access_token={Client.AuthorizationToken}";

    private async Task ToggleFavorite(DtoMovie? movie)
    {
        if (movie != null)
            IsMovieFavorite = await Client.ToggleFavorite(movie);
        else if (collection != null)
            IsCollectionFavorite = await Client.ToggleFavorite(collection);
    }

    private Task<bool> CheckIfFavorite(DtoMediaEntry? collectionId, DtoMediaEntry? movieId)
    {
        if (movieId is not null)
            return Task.FromResult(movieId.IsFavorite);
        if (collectionId is not null)
            return Task.FromResult(collectionId.IsFavorite);
        return Task.FromResult(false);
    }

    private void BeginEditCurrent()
    {
        if (selectedMovie is not null)
            BeginEdit(selectedMovie);
        else if (collection is not null)
            BeginEdit(collection);
    }

    private void BeginEdit(DtoMediaEntry target)
    {
        editObjectType = target is DtoMovie ? "movie" : "moviecollection";
        editId = target.Id;
        editName = target.Name;
        editDate = target.ReleaseDate;
        editSupportsPlot = target is DtoMovie;
        editSupportsGenres = target is DtoMovie;
        editPlot = (target as DtoMovie)?.Plot ?? "";
        editGenres = new HashSet<string>(SplitGenres((target as DtoMovie)?.GenreNames), StringComparer.OrdinalIgnoreCase);
        editNewGenres = "";
        editError = null;
        isEditing = true;
        isDirty = false;
    }

    private async Task SaveEditAsync()
    {
        if (!isEditing || string.IsNullOrWhiteSpace(editName))
            return;

        editError = null;
        var genres = editGenres.Concat(SplitGenres(editNewGenres)).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
        try
        {
            await Client.SaveMetadataAsync(new MediaMetadataUpdateRequest
            {
                ObjectType = editObjectType,
                Id = editId,
                Name = editName.Trim(),
                ReleaseDate = editDate,
                PremieredAt = null,
                Plot = editSupportsPlot ? editPlot : null,
                GenreNames = editSupportsGenres ? genres : []
            });
        }
        catch (Exception ex)
        {
            editError = ex.Message;
            return;
        }

        await ReloadCollectionAsync();
        isEditing = false;
        isDirty = false;
    }

    private async Task ReloadCollectionAsync()
    {
        var movieId = selectedMovie?.Id;
        collection = await Client.RequestMovieCollectionAsync(Id) as DtoMovieCollection;
        if (collection is null)
            return;
        selectedMovie = movieId.HasValue ? collection.Movies.FirstOrDefault(m => m.Id == movieId.Value) : null;
        IsCollectionFavorite = await CheckIfFavorite(collectionId: collection, movieId: null);
        if (selectedMovie is not null)
            IsMovieFavorite = await CheckIfFavorite(collectionId: null, movieId: selectedMovie);
        genreOptions = await Client.RequestGenreOptionsAsync();
    }

    private async Task CancelEditAsync()
    {
        if (!isDirty)
        {
            ClearEditState();
            return;
        }

        pendingDiscardAction = () =>
        {
            ClearEditState();
            return Task.CompletedTask;
        };
        showDiscardDialog = true;
    }

    private async Task RunWithDirtyCheckAsync(Func<Task> action)
    {
        if (isEditing && isDirty)
        {
            pendingDiscardAction = action;
            showDiscardDialog = true;
            return;
        }

        await action();
    }

    private async Task DiscardAndContinueAsync()
    {
        var action = pendingDiscardAction;
        showDiscardDialog = false;
        pendingDiscardAction = null;
        ClearEditState();
        if (action is not null)
            await action();
    }

    private void ContinueEditing()
    {
        pendingDiscardAction = null;
        showDiscardDialog = false;
    }

    private void ClearEditState()
    {
        isEditing = false;
        isDirty = false;
        editObjectType = "";
        editId = 0;
        editGenres.Clear();
        editNewGenres = "";
        editError = null;
    }

    private void OnEditNameChanged(ChangeEventArgs e)
    {
        editName = e.Value?.ToString() ?? "";
        editError = null;
        isDirty = true;
    }

    private void OnEditDateChanged(ChangeEventArgs e)
    {
        editDate = DateTime.TryParse(e.Value?.ToString(), out var value) ? value.Date : null;
        editError = null;
        isDirty = true;
    }

    private void OnEditPlotChanged(ChangeEventArgs e)
    {
        editPlot = e.Value?.ToString() ?? "";
        editError = null;
        isDirty = true;
    }

    private void OnEditNewGenresChanged(ChangeEventArgs e)
    {
        editNewGenres = e.Value?.ToString() ?? "";
        editError = null;
        isDirty = true;
    }

    private void ToggleEditGenre(string name)
    {
        if (!editGenres.Add(name))
            editGenres.Remove(name);
        editError = null;
        isDirty = true;
    }

    private static IEnumerable<string> SplitGenres(string? value)
        => (value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(g => !string.IsNullOrWhiteSpace(g));

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "";

    private void OnPositionChanged(double seconds)
    {
        resumeSeconds = (long)Math.Floor(seconds);
    }
}

<script src="scroll-horizontal.js"></script>
