<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.MediaLists;assembly=VideoPlayerMaui"
             xmlns:view="clr-namespace:VideoPlayer.Views.MediaLists"
             x:Class="VideoPlayer.Views.MediaLists.MediaListItemView"
             x:DataType="vm:MediaListItemViewModel">
    <Frame Margin="5" WidthRequest="200" HeightRequest="200">
        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
        </Frame.GestureRecognizers>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Image Source="{Binding Picture}"/>
            <Label                 
                Text="{Binding Title}"
                VerticalOptions="End" 
                HorizontalOptions="Center" />
        </Grid>
    </Frame>
</ContentView>
