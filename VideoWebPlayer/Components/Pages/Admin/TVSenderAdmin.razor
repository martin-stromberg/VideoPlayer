@page "/admin/tv-sender"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Components.Playlists
@using VideoWebPlayer.Controllers.Models
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@inject ApplicationDbContext DbContext
@inject IProgramRuleService ProgramRuleService
@inject IProgramScheduleService ProgramScheduleService
@inject IProgramScheduleSignal ScheduleSignal
@inject IProgramClipGroupService ClipGroupService
@inject MediaDurationProbeService ProbeService
@inject ProgramSettingsService ProgramSettings
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayer.Client.VideoWebPlayerClient Client
@inject IFfprobeLocator FfprobeLocator
@inject IFfmpegLocator FfmpegLocator
@inject IFfmpegToolDownloadService ToolDownloadService
@inject TimeProvider TimeProvider
@rendermode InteractiveServer

<PageTitle>TV-Sender</PageTitle>

@if (!isAdmin)
{
    <div class="alert alert-danger">Nicht autorisiert.</div>
}
else if (!tvSenderEnabled)
{
    <section class="admin-console">
        <div class="alert alert-info" id="tvsender-disabled">
            Der TV-Sender ist nicht freigeschaltet. Die Freischaltung erfolgt unter
            <a href="/admin/program-settings">Einrichtung → Allgemein</a>.
        </div>
    </section>
}
else
{
    <section class="admin-console admin-tvsender-page">
        <header class="admin-page-header">
            <div>
                <span class="admin-kicker">Einrichtung</span>
                <h1>TV-Sender</h1>
                <p>Sender, Programmregeln und Feiertags-Einstellung verwalten.</p>
            </div>
            <div class="admin-header-side">
                @if (channel is not null)
                {
                    <span class="admin-chip admin-chip-success" id="tvsender-header-channel" title="Sender-Status">Sender: @channel.Name</span>
                    <span class="admin-chip" id="tvsender-header-interval" title="Generierungsintervall">Plan alle @intervalMinutes&nbsp;Min aktiv</span>
                }
                <a class="btn btn-outline-light" href="/admin">Zurück</a>
            </div>
        </header>

        <nav class="admin-tabs" role="tablist">
            <button id="tvsender-tab-regeln" class="admin-tab @(activeTab == "regeln" ? "active" : "")" role="tab"
                    aria-selected="@(activeTab == "regeln" ? "true" : "false")" aria-controls="tab-regeln"
                    @onclick='() => SelectTab("regeln")'>Regeln</button>
            <button id="tvsender-tab-sendeplan" class="admin-tab @(activeTab == "sendeplan" ? "active" : "")" role="tab"
                    aria-selected="@(activeTab == "sendeplan" ? "true" : "false")" aria-controls="tab-sendeplan"
                    @onclick='() => SelectTab("sendeplan")'>Sendeplan</button>
            <button id="tvsender-tab-einstellungen" class="admin-tab @(activeTab == "einstellungen" ? "active" : "")" role="tab"
                    aria-selected="@(activeTab == "einstellungen" ? "true" : "false")" aria-controls="tab-einstellungen"
                    @onclick='() => SelectTab("einstellungen")'>Einstellungen</button>
            <button id="tvsender-tab-laufzeit" class="admin-tab @(activeTab == "laufzeit" ? "active" : "")" role="tab"
                    aria-selected="@(activeTab == "laufzeit" ? "true" : "false")" aria-controls="tab-laufzeit"
                    @onclick='() => SelectTab("laufzeit")'>Laufzeitermittlung</button>
            <button id="tvsender-tab-clipgruppen" class="admin-tab @(activeTab == "clipgruppen" ? "active" : "")" role="tab"
                    aria-selected="@(activeTab == "clipgruppen" ? "true" : "false")" aria-controls="tab-clipgruppen"
                    @onclick='() => SelectTab("clipgruppen")'>Clip-Gruppen</button>
        </nav>

        @if (downloadSnapshot.IsActive)
        {
            <div class="admin-card" id="tvsender-download-progress-card">
                @* Ohne bekannte Gesamtgröße bleibt der Balken unbestimmt (keine aria-Werte) —
                   die Byte-Anzeige steht dann im sichtbaren Statustext. *@
                <div class="progress" role="progressbar" aria-label="Download-Fortschritt"
                     aria-valuenow="@DownloadAriaValue" aria-valuemin="@DownloadAriaMin"
                     aria-valuemax="@DownloadAriaMax">
                    <div class="progress-bar" style="width: @DownloadPercent%"></div>
                </div>
                <p class="form-text" id="tvsender-download-status">@DownloadStatusLabel</p>
            </div>
        }
        else if ((!string.IsNullOrWhiteSpace(downloadError) || downloadSnapshot.Status == FfmpegToolDownloadJobStatus.Failed) && !downloadErrorDismissed)
        {
            <div class="alert alert-danger" id="tvsender-download-error">
                @(downloadError ?? downloadSnapshot.Error)
                <button type="button" id="tvsender-download-error-close" class="btn btn-sm btn-ghost"
                        @onclick="DismissDownloadError">Schließen</button>
            </div>
        }
        else if (downloadSnapshot.Status == FfmpegToolDownloadJobStatus.Succeeded && !downloadSuccessDismissed)
        {
            <div class="alert alert-success" id="tvsender-download-success">
                @downloadSnapshot.Message Laufzeitermittlung und Live-Stream laufen wieder.
                <button type="button" id="tvsender-download-success-close" class="btn btn-sm btn-ghost"
                        @onclick="DismissDownloadSuccess">Schließen</button>
            </div>
        }

        <!-- ============ Tab: Regeln ============ -->
        <div class="tab-pane @(activeTab == "regeln" ? "active" : "")" id="tab-regeln" role="tabpanel" aria-labelledby="tvsender-tab-regeln">

        <div class="admin-card admin-card-wide">
            <div class="admin-card-header">
                <div class="admin-card-header-left">
                    <h2>Programmregeln</h2>
                    <span class="admin-chip">@rules.Count Einträge</span>
                </div>
                <button id="tvsender-new-rule" class="btn btn-sm btn-primary" @onclick="StartCreate">Neue Regel</button>
            </div>

            @if (rules.Count == 0)
            {
                <div class="admin-empty-state">
                    <strong>Keine Programmregeln vorhanden</strong>
                    <span>Legen Sie die erste Regel für diesen Sender an.</span>
                </div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Regelart</th>
                                <th>Wiederholung</th>
                                <th>Sendezeit</th>
                                <th>Umfang</th>
                                <th>Material</th>
                                <th>Planbar</th>
                                <th>Priorität</th>
                                <th>Status</th>
                                <th>Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in rules)
                            {
                                <tr class="tvsender-rule-row" data-rule-id="@rule.Id">
                                    <td>@rule.Name</td>
                                    <td>@RuleTypeLabel(rule.RuleType)</td>
                                    <td>@RecurrenceLabel(rule)</td>
                                    <td>@rule.TimeOfDay.ToString("HH:mm")</td>
                                    <td>@DurationLabel(rule)</td>
                                    <td>@MaterialLabel(rule)</td>
                                    <td class="tvsender-rule-diagnosis">@DiagnosisLabel(rule)</td>
                                    <td>@rule.Priority</td>
                                    <td>
                                        <span class="admin-chip @(rule.IsActive ? "admin-chip-success" : "admin-chip-warning")">@(rule.IsActive ? "Aktiv" : "Inaktiv")</span>
                                    </td>
                                    <td class="actions-cell">
                                        <button class="btn btn-sm btn-primary tvsender-rule-edit" @onclick="() => StartEdit(rule)">Bearbeiten</button>
                                        <button class="btn btn-sm btn-outline-light tvsender-rule-toggle" @onclick="() => ToggleActiveAsync(rule)">@(rule.IsActive ? "Deaktivieren" : "Aktivieren")</button>
                                        <button class="btn btn-sm btn-danger tvsender-rule-delete" @onclick="() => AskDelete(rule)">Löschen</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(rulesStatus))
            {
                <div class="form-text" id="tvsender-rules-status">@rulesStatus</div>
            }
        </div>

        @if (editRule != null)
        {
            <div class="admin-dialog-overlay" @onclick="CancelEdit">
            <div class="admin-dialog rule-editor-dialog" id="rule-editor" @onclick:stopPropagation>
                <div class="admin-card-header">
                    <h2>@(editRule.Id == 0 ? "Neue Programmregel" : $"Programmregel „{editRule.Name}“")</h2>
                    <button class="btn btn-sm btn-outline-light" @onclick="CancelEdit">Schließen</button>
                </div>

                <label class="form-label" for="rule-name">Name</label>
                <input id="rule-name" class="form-control" @bind="editRule.Name" />

                <div class="admin-settings-grid">
                    <div>
                        <label class="form-label" for="rule-type">Regelart</label>
                        <select id="rule-type" class="form-control" value="@editRule.RuleType" @onchange="OnRuleTypeChanged">
                            @foreach (ProgramRuleType t in Enum.GetValues<ProgramRuleType>())
                            {
                                <option value="@t">@RuleTypeLabel(t)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="rule-recurrence">Wiederholung</label>
                        <select id="rule-recurrence" class="form-control" value="@editRule.Recurrence" @onchange="OnRecurrenceChanged">
                            <option value="@ProgramRuleRecurrence.Daily">Täglich</option>
                            <option value="@ProgramRuleRecurrence.Weekly">Wöchentlich</option>
                            <option value="@ProgramRuleRecurrence.Once">Einmalig</option>
                            <option value="@ProgramRuleRecurrence.Holiday">An Feiertagen</option>
                            <option value="@ProgramRuleRecurrence.Weekday">Werktags (Mo–Fr)</option>
                            <option value="@ProgramRuleRecurrence.Weekend">Wochenende (Sa+So)</option>
                        </select>
                    </div>
                </div>

                <div class="admin-settings-grid">
                    @if (editRule.Recurrence == ProgramRuleRecurrence.Weekly)
                    {
                        <div>
                            <label class="form-label" for="rule-weekday">Wochentag</label>
                            <select id="rule-weekday" class="form-control" @bind="editRule.DayOfWeek">
                                @foreach (DayOfWeek d in Enum.GetValues<DayOfWeek>())
                                {
                                    <option value="@d">@WeekdayLabel(d)</option>
                                }
                            </select>
                        </div>
                    }
                    @if (editRule.Recurrence == ProgramRuleRecurrence.Once)
                    {
                        <div>
                            <label class="form-label" for="rule-date">Datum</label>
                            <InputDate id="rule-date" class="form-control" @bind-Value="editRule.SingleDate" />
                        </div>
                    }
                    <div>
                        <label class="form-label" for="rule-time">Sendezeit</label>
                        <input id="rule-time" type="time" class="form-control" @bind="editRule.TimeOfDay" />
                    </div>
                </div>

                <div class="admin-settings-grid">
                    <div>
                        <label class="form-label" for="rule-episodes">Anzahl Folgen</label>
                        <input id="rule-episodes" type="number" min="0" class="form-control" @bind="editRule.EpisodeCount" />
                    </div>
                    <div>
                        <label class="form-label" for="rule-duration">Länge (Minuten)</label>
                        <input id="rule-duration" type="number" min="0" class="form-control" @bind="editRule.DurationMinutes" />
                    </div>
                    <div>
                        <label class="form-label" for="rule-priority">Priorität</label>
                        <input id="rule-priority" type="number" class="form-control" @bind="editRule.Priority" />
                    </div>
                </div>

                <label class="admin-toggle-row">
                    <InputCheckbox class="form-check-input" @bind-Value="editRule.IsActive" />
                    <span>Regel ist aktiv</span>
                </label>

                <label class="form-label">Programmmaterial</label>
                @if (!string.IsNullOrWhiteSpace(editRule.MaterialDisplayName))
                {
                    <div class="admin-chip" id="rule-material-selected">
                        @editRule.MaterialDisplayName
                        <button class="btn btn-sm btn-ghost" @onclick="() => editRule.MaterialDisplayName = string.Empty">Ändern</button>
                    </div>
                }
                else
                {
                    <div id="rule-material-picker">
                        @if (AllowedMaterialTypes.Any(t => t is ProgramRuleMaterialType.TVShow or ProgramRuleMaterialType.Movie or ProgramRuleMaterialType.MovieCollection))
                        {
                            <MediaSearchSelector AllowedMediaTypes="@AllowedSearchMediaTypes" OnMediaSelected="OnMaterialSelected" />
                        }
                        @if (AllowedMaterialTypes.Contains(ProgramRuleMaterialType.Playlist))
                        {
                            <select id="rule-material-playlist" class="form-control" @onchange="OnPlaylistSelected">
                                <option value="">Playlist wählen…</option>
                                @foreach (var p in playlistOptions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        }
                        @if (AllowedMaterialTypes.Contains(ProgramRuleMaterialType.Trailer))
                        {
                            <label class="form-check rule-trailer-option" for="rule-material-trailer">
                                <input type="checkbox" class="form-check-input" id="rule-material-trailer"
                                       checked="@(editRule.MaterialType == ProgramRuleMaterialType.Trailer)"
                                       @onchange="e => OnTrailerToggled(e.Value is bool b && b)" />
                                Trailer anstehender Filme
                            </label>
                        }
                        @if (AllowedMaterialTypes.Contains(ProgramRuleMaterialType.MediaSourceClips))
                        {
                            <select id="rule-material-clipsource" class="form-control" @onchange="OnClipSourceSelected">
                                <option value="">Clip-Quelle wählen…</option>
                                @foreach (var s in mediaSources)
                                {
                                    <option value="@s.Id" selected="@(editRule.MaterialType == ProgramRuleMaterialType.MediaSourceClips && editRule.MaterialId == s.Id)">Clip-Quelle: @s.Name</option>
                                }
                            </select>
                        }
                    </div>
                }

                @if (AllowedMaterialTypes.Contains(ProgramRuleMaterialType.Genre)
                    && (editRule.MaterialType == ProgramRuleMaterialType.Genre || string.IsNullOrWhiteSpace(editRule.MaterialDisplayName)))
                {
                    <div class="rule-genre-editor" id="rule-genre-editor">
                        <label class="form-label" id="rule-material-genre-label">Genres (Mehrfachauswahl)</label>
                        <div id="rule-material-genre" class="rule-multi-select">
                            @if (genreOptions.Count == 0)
                            {
                                <span class="form-text" id="rule-material-genre-empty">Keine wählbaren Genres für die aktuelle Quell-Auswahl.</span>
                            }
                            @foreach (var g in genreOptions)
                            {
                                <label class="form-check rule-genre-option" for="rule-genre-@g.Id">
                                    <input type="checkbox" class="form-check-input" id="rule-genre-@g.Id"
                                           checked="@editRule.SelectedGenreIds.Contains(g.Id)"
                                           @onchange="e => OnGenreToggled(g.Id, e.Value is bool b && b)" />
                                    @g.Name
                                </label>
                            }
                        </div>
                        <label class="form-label" id="rule-material-sources-label">Quellen einschränken (keine Auswahl = alle Quellen)</label>
                        <div id="rule-material-sources" class="rule-multi-select">
                            @foreach (var s in mediaSources)
                            {
                                <label class="form-check rule-source-option" for="rule-source-@s.Id">
                                    <input type="checkbox" class="form-check-input" id="rule-source-@s.Id"
                                           checked="@editRule.SelectedMediaSourceIds.Contains(s.Id)"
                                           @onchange="async e => await OnSourceToggledAsync(s.Id, e.Value is bool b && b)" />
                                    @s.Name
                                </label>
                            }
                        </div>
                    </div>
                }

                @if (editRule.RuleType != ProgramRuleType.Filler)
                {
                    <label class="form-label" id="rule-clip-groups-label">Clip-Gruppen (Restzeit-Auffüllung)</label>
                    <div id="rule-clip-groups" class="rule-multi-select">
                        @if (clipGroups.Count == 0)
                        {
                            <span class="form-text" id="rule-clip-groups-empty">Keine Clip-Gruppen vorhanden — im Tab „Clip-Gruppen" anlegen.</span>
                        }
                        @foreach (var g in clipGroups)
                        {
                            <label class="form-check rule-clip-group-option" for="rule-clip-group-@g.Id">
                                <input type="checkbox" class="form-check-input" id="rule-clip-group-@g.Id"
                                       checked="@editRule.SelectedClipGroupIds.Contains(g.Id)"
                                       @onchange="e => OnClipGroupToggled(g.Id, e.Value is bool b && b)" />
                                @g.Name@(g.IsSystem ? " (automatisch befüllt)" : "")
                            </label>
                        }
                    </div>
                    @if (editRule.DurationMinutes is not > 0)
                    {
                        <span class="form-text" id="rule-clip-groups-hint">Clip-Gruppen und Karenzzeit wirken nur bei gesetzter Länge (Minuten).</span>
                    }
                    else if (editRule.SelectedClipGroupIds.Count == 0)
                    {
                        <span class="form-text" id="rule-clip-groups-hint">Die Karenzzeit wirkt erst mit mindestens einer gewählten Clip-Gruppe.</span>
                    }
                    else
                    {
                        <div class="admin-settings-grid">
                            <div>
                                <label class="form-label" for="rule-grace-minutes">Karenzzeit (Minuten)</label>
                                <input id="rule-grace-minutes" type="number" min="1" class="form-control" @bind="editRule.GraceMinutes" />
                                <span class="form-text" id="rule-grace-minutes-hint">Restzeit vor dem Sendeplatz-Ende, ab der kein weiterer Titel mehr gestartet, sondern mit Clips der gewählten Gruppen aufgefüllt wird.</span>
                            </div>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(editError))
                {
                    <div class="alert alert-danger" id="rule-edit-error">@editError</div>
                }

                <div class="admin-actions">
                    <button id="rule-save" class="btn btn-primary" @onclick="SaveRuleAsync">Speichern</button>
                    <button class="btn btn-ghost" @onclick="CancelEdit">Abbrechen</button>
                </div>
            </div>
            </div>
        }

        </div>

        <!-- ============ Tab: Sendeplan ============ -->
        <div class="tab-pane @(activeTab == "sendeplan" ? "active" : "")" id="tab-sendeplan" role="tabpanel" aria-labelledby="tvsender-tab-sendeplan">

        <div class="admin-card admin-card-wide">
            <div class="admin-card-header">
                <div class="admin-card-header-left">
                    <h2>Sendeplan</h2>
                    <span class="admin-chip">@schedule.Count Einträge</span>
                </div>
                <div class="admin-actions" style="margin:0;">
                    <button id="tvsender-generate-now" class="btn btn-primary" @onclick="GenerateNowAsync" disabled="@generatePending">Jetzt generieren</button>
                    <button id="tvsender-cleanup-displaced" class="btn btn-outline-danger" @onclick="() => confirmCleanup = true">Verdrängte bereinigen</button>
                    <button id="tvsender-reset-schedule" class="btn btn-outline-danger" @onclick="() => confirmReset = true">Plan zurücksetzen</button>
                </div>
            </div>

            @if (schedule.Count == 0)
            {
                <div class="admin-empty-state">
                    <strong>Keine Sendeplätze vorhanden</strong>
                    <span>Der Sendeplan wird im Hintergrund aus den aktiven Regeln erzeugt.</span>
                </div>
            }
            else
            {
                @* Programm-Karten nach dem freigegebenen Prototyp (sendeplan-vorschau.html):
                   Poster 2:3, Badge (Genre/Live/Status), Zeit, Titel, Episoden-Info + Regel,
                   3-zeilige Beschreibung; laufender Slot mit LIVE-Badge + Fortschritt. *@
                <div class="program-grid" id="tvsender-schedule-cards">
                    @* N27: Tages-Header je Kalendertag (lokale Zeit, wie die angezeigten
                       Sendezeiten) und eine Trennlinie, sobald die erzeugende Programmregel
                       wechselt — Bloecke je Regel bleiben visuell abgegrenzt. *@
                    @foreach (var day in schedule.GroupBy(s => s.Start.ToLocalTime().Date))
                    {
                        <div class="tvsender-day-header" data-day="@day.Key.ToString("yyyy-MM-dd")">
                            @day.Key.ToString("dddd, dd.MM.yyyy")
                        </div>
                        long? previousRuleId = null;
                        var firstInDay = true;
                        @foreach (var slot in day)
                        {
                            if (!firstInDay && slot.ProgramRuleId != previousRuleId)
                            {
                                <div class="tvsender-rule-divider" data-rule-id="@slot.ProgramRuleId">
                                    <span class="tvsender-rule-divider-label">@RuleName(slot)</span>
                                </div>
                            }
                            firstInDay = false;
                            previousRuleId = slot.ProgramRuleId;
                            var card = SlotCard(slot);
                            var running = IsRunning(slot);
                        <div class="program-card tvsender-slot-row @(slot.Status == ProgramSlotStatus.Displaced ? "tvsender-slot-displaced" : "") @(running ? "slot-now" : "")" data-slot-id="@slot.Id">
                            <div class="program-poster">
                                <img src="@PosterUrl(card)" alt="" />
                            </div>
                            <div class="program-body">
                                <div class="program-badges">
                                    @if (running)
                                    {
                                        <span class="program-badge badge-live">Live</span>
                                    }
                                    @if (card.GenreName is { } genre)
                                    {
                                        <span class="program-badge badge-genre">@genre</span>
                                    }
                                    <span class="admin-chip @(slot.Status == ProgramSlotStatus.Displaced ? "admin-chip-warning" : "admin-chip-success")">@(slot.Status == ProgramSlotStatus.Displaced ? "Verdrängt" : "Geplant")</span>
                                </div>
                                <span class="program-time">@slot.Start.ToLocalTime().ToString("dd.MM. HH:mm")&nbsp;–&nbsp;@slot.End.ToLocalTime().ToString("HH:mm")</span>
                                <span class="program-title">@(card.ShowName ?? card.Title)</span>
                                @if (card.Subtitle is { } sub)
                                {
                                    <span class="program-sub">@sub</span>
                                }
                                <span class="program-sub">Regel: @RuleName(slot)</span>
                                <p class="program-desc">@(card.Description ?? ProgramGuideEntryText.NoDescriptionText)</p>
                                @if (running)
                                {
                                    <div class="progress-track" aria-hidden="true"><div class="progress-fill" style="width:@ProgressPercent(slot)%"></div></div>
                                }
                            </div>
                        </div>
                        }
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(scheduleStatus))
            {
                <div class="form-text" id="tvsender-schedule-status">@scheduleStatus</div>
            }
        </div>

        </div>

        <!-- ============ Tab: Einstellungen ============ -->
        <div class="tab-pane @(activeTab == "einstellungen" ? "active" : "")" id="tab-einstellungen" role="tabpanel" aria-labelledby="tvsender-tab-einstellungen">

        <div class="admin-card admin-card-wide">
            <div class="admin-card-header">
                <h2>Sender-Einstellungen</h2>
            </div>
            <div class="admin-settings-grid">
                <div class="admin-sub-card">
                    <h3 class="mb-2">Sender</h3>
                    <div class="mb-2">
                        <label class="form-label" for="tvsender-name">Name</label>
                        <input id="tvsender-name" class="form-control" @bind="channelName" />
                    </div>
                    <div>
                        <label class="form-label" for="tvsender-federal-state">Bundesland für Feiertage</label>
                        <select id="tvsender-federal-state" class="form-control" @bind="federalState">
                            <option value="">Nur bundesweit gültige Feiertage</option>
                            @foreach (var state in federalStates)
                            {
                                <option value="@state">@state</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="admin-sub-card">
                    <h3 class="mb-2">Planung</h3>
                    <div class="mb-2">
                        <label class="form-label" for="tvsender-horizon-hours">Planungshorizont (Stunden)</label>
                        <input id="tvsender-horizon-hours" type="number" min="1" class="form-control" @bind="horizonHours" />
                    </div>
                    <div>
                        <label class="form-label" for="tvsender-interval-minutes">Generierungsintervall (Minuten)</label>
                        <input id="tvsender-interval-minutes" type="number" min="1" class="form-control" @bind="intervalMinutes" />
                    </div>
                </div>
                <div class="admin-sub-card">
                    <h3 class="mb-2">Segmentierung</h3>
                    @if (ffmpegPath is null)
                    {
                        <div class="alert alert-warning" id="tvsender-ffmpeg-missing">
                            ffmpeg wurde nicht gefunden — der Live-Stream pausiert.
                            <button id="tvsender-download-tools-ffmpeg" class="btn btn-sm btn-primary"
                                    disabled="@downloadSnapshot.IsActive"
                                    @onclick="() => confirmFfmpegDownload = true">ffmpeg/ffprobe herunterladen</button>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="tvsender-segment-length-seconds">Segmentlänge (Sekunden)</label>
                        <input id="tvsender-segment-length-seconds" type="number" min="1" max="300" class="form-control" @bind="segmentLengthSeconds" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="tvsender-segment-directory">Segment-Verzeichnis (leer = Standard)</label>
                        <input id="tvsender-segment-directory" class="form-control" @bind="segmentDirectory" />
                    </div>
                    <div>
                        <label class="form-label" for="tvsender-segment-retention-minutes">Segment-Aufbewahrung (Minuten)</label>
                        <input id="tvsender-segment-retention-minutes" type="number" min="1" class="form-control" @bind="segmentRetentionMinutes" />
                    </div>
                </div>
                <div class="admin-sub-card">
                    <h3 class="mb-2">Standby-Clip (Überbrückung)</h3>
                    <p class="form-text">Wird gezeigt, bis der Live-Stream nach einem Server-Start wirklich läuft — ebenso bei Unterbrechungen. Auswählbar sind Videodateien ohne Film-/Serien-Zuordnung.</p>
                    <div class="mb-2">
                        <span class="admin-chip" id="tvsender-standby-current">@standbyCurrentLabel</span>
                        <button id="tvsender-standby-change" class="btn btn-sm btn-outline-light" @onclick="ToggleStandbyPickerAsync"
                                aria-expanded="@(showStandbyPicker ? "true" : "false")" aria-controls="tvsender-standby-picker">@(showStandbyPicker ? "Auswahl schließen" : "Ändern")</button>
                        @if (standbySelectionPending)
                        {
                            <span class="form-text" id="tvsender-standby-pending">Auswahl wird mit „Speichern" übernommen.</span>
                        }
                    </div>
                    @if (showStandbyPicker)
                    {
                        <div id="tvsender-standby-picker">
                            <div class="admin-settings-grid">
                                <div>
                                    <label class="form-label" for="tvsender-standby-source">Quelle</label>
                                    <select id="tvsender-standby-source" class="form-control" @bind="standbySourceId" @bind:after="ReloadStandbyCandidatesAsync">
                                        <option value="">Alle Quellen</option>
                                        @foreach (var s in mediaSources)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="tvsender-standby-search">Suche</label>
                                    <input id="tvsender-standby-search" class="form-control" @bind="standbySearch" @bind:event="oninput" @bind:after="OnStandbySearchChanged" placeholder="Clip suchen..." />
                                </div>
                            </div>
                            @if (standbyCandidatesLoading && standbyCandidates.Count == 0)
                            {
                                <div class="admin-empty-state" id="tvsender-standby-loading">
                                    <strong>Clips werden geladen…</strong>
                                </div>
                            }
                            else if (standbyCandidates.Count == 0)
                            {
                                <div class="admin-empty-state" id="tvsender-standby-empty">
                                    <strong>Keine zuordenbaren Clips gefunden</strong>
                                    <span>Angeboten werden nur Videodateien ohne Film-/Serien-Zuordnung — Suche oder Quellenfilter ggf. anpassen.</span>
                                </div>
                            }
                            else
                            {
                                <div class="admin-table-wrap">
                                    <table class="table table-dark table-striped align-middle">
                                        <thead><tr><th>Name</th><th>Quelle</th><th>Laufzeit</th><th></th></tr></thead>
                                        <tbody>
                                        @foreach (var c in standbyCandidates)
                                        {
                                            <tr class="standby-candidate-row" data-media-item-id="@c.MediaItemId">
                                                <td>@c.Name</td>
                                                <td>@c.SourceName</td>
                                                <td>@(c.Duration is { } d ? d.ToString(@"hh\:mm\:ss") : "keine Laufzeit")</td>
                                                <td class="actions-cell">
                                                    @if (standbyMediaItemId == c.MediaItemId)
                                                    {
                                                        <span class="admin-chip standby-candidate-current">Ausgewählt</span>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-primary standby-candidate-pick" @onclick="() => PickStandbyAsync(c.MediaItemId)">Auswählen</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (standbyCandidatesHasMore)
                            {
                                <p class="form-text" id="tvsender-standby-more-hint">Es gibt weitere Treffer — Suche oder Quelle eingrenzen oder weitere laden.</p>
                                <button id="tvsender-standby-more" class="btn btn-sm btn-outline-light" disabled="@standbyCandidatesLoading" @onclick="LoadMoreStandbyCandidatesAsync">@(standbyCandidatesLoading ? "Clips werden geladen…" : "Weitere laden")</button>
                            }
                            <div class="admin-actions">
                                <button id="tvsender-standby-clear" class="btn btn-sm btn-outline-light" @onclick="ClearStandbySelection">Standard-Clip verwenden</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="admin-actions">
                <button id="tvsender-save-settings" class="btn btn-primary" @onclick="SaveChannelSettingsAsync">Speichern</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(channelStatus))
            {
                <div class="form-text" id="tvsender-channel-status">@channelStatus</div>
            }
        </div>

        </div>

        <!-- ============ Tab: Laufzeitermittlung ============ -->
        <div class="tab-pane @(activeTab == "laufzeit" ? "active" : "")" id="tab-laufzeit" role="tabpanel" aria-labelledby="tvsender-tab-laufzeit">

        <div class="admin-card admin-card-wide" id="tvsender-probe-card">
            <div class="admin-card-header">
                <h2>Laufzeitermittlung</h2>
                @if (probeProgress is { } summary)
                {
                    <span class="admin-chip">@summary.ProbedCount von @summary.TotalCount ermittelt</span>
                }
            </div>

            @if (ffprobePath is null)
            {
                <div class="alert alert-warning" id="tvsender-ffprobe-missing">
                    ffprobe wurde nicht gefunden — die Laufzeitermittlung pausiert.
                    <button id="tvsender-download-tools-ffprobe" class="btn btn-sm btn-primary"
                            disabled="@downloadSnapshot.IsActive"
                            @onclick="() => confirmFfmpegDownload = true">ffmpeg/ffprobe herunterladen</button>
                </div>
            }

            @if (probeProgress is null)
            {
                <div class="admin-empty-state">
                    <strong>Fortschritt wird geladen…</strong>
                </div>
            }
            else if (probeProgress.TotalCount == 0)
            {
                <div class="admin-empty-state" id="tvsender-probe-empty">
                    <strong>Keine Videodateien gefunden</strong>
                    <span>Sobald Videodateien in den Medienquellen vorhanden sind, wird ihre Laufzeit hier ermittelt.</span>
                </div>
            }
            else
            {
                <p class="form-text" id="tvsender-probe-status">@ProbeStatusLabel(probeProgress)</p>

                <div class="probe-counts" id="tvsender-probe-counts">
                    <span class="admin-chip admin-chip-success" id="tvsender-probe-probed">@probeProgress.ProbedCount ermittelt</span>
                    <span class="admin-chip admin-chip-warning" id="tvsender-probe-pending">@probeProgress.PendingCount ausstehend
                        @if (probeProgress.PendingItems.Count > 0)
                        {
                            <button class="chip-detail-btn" id="tvsender-probe-pending-details" title="Betroffene Dateien anzeigen"
                                    @onclick="() => showPendingProbeDetails = !showPendingProbeDetails">▾ Details</button>
                        }
                    </span>
                    <span class="admin-chip admin-chip-danger" id="tvsender-probe-failed">@probeProgress.FailedCount fehlgeschlagen
                        @if (probeProgress.FailedItems.Count > 0)
                        {
                            <button class="chip-detail-btn" id="tvsender-probe-failed-details" title="Betroffene Dateien anzeigen"
                                    @onclick="() => showFailedProbeDetails = !showFailedProbeDetails">▾ Details</button>
                        }
                    </span>
                    @if (probeProgress.FailedCount > 0)
                    {
                        <button id="tvsender-probe-reset-all" class="btn btn-sm btn-outline-danger"
                                title="Alle fehlgeschlagenen Dateien beim nächsten Ermittlungslauf erneut prüfen"
                                @onclick="() => confirmProbeReset = true">Alle zurücksetzen</button>
                    }
                </div>

                <div class="progress mt-2" role="progressbar" aria-label="Fortschritt der Laufzeitermittlung"
                     aria-valuenow="@probeProgress.ProbedCount" aria-valuemin="0" aria-valuemax="@probeProgress.TotalCount">
                    <div class="progress-bar" style="width: @ProbePercent(probeProgress)%"></div>
                </div>

                <p class="form-text mt-2">
                    <span id="tvsender-probe-last-activity">Letzte Aktivität: @(probeProgress.LastActivityAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span>
                    · <span id="tvsender-probe-rate">Letzte Stunde: @probeProgress.ProbedLastHour Ermittlung(en)</span>
                </p>

                @if (probeProgress.PendingItems.Count > 0)
                {
                    <details class="probe-detail" id="tvsender-probe-pending-detail" open="@showPendingProbeDetails">
                        <summary>Ausstehende Dateien (@probeProgress.PendingCount) — Ermittlung läuft oder wartet</summary>
                        <div class="table-wrap-inner">
                            <div class="admin-table-wrap mt-2">
                                <table class="table table-dark table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Quelle</th>
                                            <th>Versuche</th>
                                            <th>Letzter Versuch</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in probeProgress.PendingItems)
                                        {
                                            <tr class="tvsender-probe-detail-row">
                                                <td>@item.Name</td>
                                                <td>@item.SourceName</td>
                                                <td>@item.Attempts</td>
                                                <td>@(item.LastAttemptAt?.ToLocalTime().ToString("dd.MM. HH:mm:ss") ?? "—")</td>
                                            </tr>
                                        }
                                        @if (probeProgress.PendingCount > probeProgress.PendingItems.Count)
                                        {
                                            <tr><td>… und @(probeProgress.PendingCount - probeProgress.PendingItems.Count) weitere</td><td colspan="3"></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                }

                @if (probeProgress.FailedItems.Count > 0)
                {
                    <details class="probe-detail" id="tvsender-probe-failed-detail" open="@showFailedProbeDetails">
                        <summary>Fehlgeschlagene Dateien (@probeProgress.FailedCount) — dauerhaft nicht prüfbar</summary>
                        <div class="table-wrap-inner">
                            <div class="admin-table-wrap mt-2">
                                <table class="table table-dark table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Quelle</th>
                                            <th>Versuche</th>
                                            <th>Letzter Versuch</th>
                                            <th>Aktionen</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in probeProgress.FailedItems)
                                        {
                                            <tr class="tvsender-probe-detail-row">
                                                <td>@item.Name</td>
                                                <td>@item.SourceName</td>
                                                <td>@item.Attempts</td>
                                                <td>@(item.LastAttemptAt?.ToLocalTime().ToString("dd.MM. HH:mm:ss") ?? "—")</td>
                                                <td class="actions-cell">
                                                    <button class="btn btn-sm btn-outline-light tvsender-probe-reset" @onclick="() => ResetProbeItemAsync(item)">Erneut ermitteln</button>
                                                </td>
                                            </tr>
                                        }
                                        @if (probeProgress.FailedCount > probeProgress.FailedItems.Count)
                                        {
                                            <tr><td colspan="5">… und @(probeProgress.FailedCount - probeProgress.FailedItems.Count) weitere — angezeigt werden nur die ersten @probeProgress.FailedItems.Count; „Alle zurücksetzen“ erfasst auch die nicht angezeigten Dateien.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                }

                @if (probeProgress.RecentItems.Count > 0)
                {
                    <div class="admin-card-header mt-2" style="margin-bottom:0.5rem;">
                        <h3>Letzte Ermittlungen</h3>
                    </div>
                    <div class="admin-table-wrap">
                        <table class="table table-dark table-striped align-middle" id="tvsender-probe-recent">
                            <thead>
                                <tr>
                                    <th>Zeitpunkt</th>
                                    <th>Datei</th>
                                    <th>Quelle</th>
                                    <th>Ergebnis</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in probeProgress.RecentItems)
                                {
                                    <tr class="tvsender-probe-row">
                                        <td>@item.ProbedAt.ToLocalTime().ToString("dd.MM. HH:mm:ss")</td>
                                        <td>@item.Name</td>
                                        <td>@item.SourceName</td>
                                        <td>@RecentResultLabel(item)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(probeStatus))
            {
                <div class="form-text" id="tvsender-probe-action-status">@probeStatus</div>
            }
        </div>

        </div>

        <!-- ============ Tab: Clip-Gruppen ============ -->
        <div class="tab-pane @(activeTab == "clipgruppen" ? "active" : "")" id="tab-clipgruppen" role="tabpanel" aria-labelledby="tvsender-tab-clipgruppen">

        <TVSenderAdminClipGroups UserId="@userId" Groups="@clipGroups" Counts="@clipCounts"
                                 MediaSources="@mediaSources" OnGroupsChanged="ReloadClipGroupsAsync" />

        </div>

        @if (confirmCleanup)
        {
            <div class="admin-dialog-overlay" @onclick="() => confirmCleanup = false">
                <div class="admin-dialog" @onclick:stopPropagation>
                    <header class="admin-card-header">
                        <h2>Verdrängte bereinigen</h2>
                    </header>
                    <p>Alle verdrängten Sendeplätze werden endgültig gelöscht. Der geplante Sendeplan bleibt unverändert bestehen.</p>
                    <div class="admin-actions">
                        <button id="schedule-cleanup-confirm" class="btn btn-danger" @onclick="CleanupDisplacedAsync">Bereinigen</button>
                        <button class="btn btn-ghost" @onclick="() => confirmCleanup = false">Abbrechen</button>
                    </div>
                </div>
            </div>
        }

        @if (confirmReset)
        {
            <div class="admin-dialog-overlay" @onclick="() => confirmReset = false">
                <div class="admin-dialog" @onclick:stopPropagation>
                    <header class="admin-card-header">
                        <h2>Sendeplan zurücksetzen</h2>
                    </header>
                    <p><strong>Achtung:</strong> Der gesamte Sendeplan — alle geplanten und verdrängten Sendeplätze sowie die Fortsetzungsstände aller Regeln — wird gelöscht. Der Plan wird beim nächsten Generierungslauf komplett neu aufgebaut.</p>
                    <div class="admin-actions">
                        <button id="schedule-reset-confirm" class="btn btn-danger" @onclick="ResetScheduleAsync">Zurücksetzen</button>
                        <button class="btn btn-ghost" @onclick="() => confirmReset = false">Abbrechen</button>
                    </div>
                </div>
            </div>
        }

        @if (confirmProbeReset)
        {
            <div class="admin-dialog-overlay" @onclick="() => confirmProbeReset = false">
                <div class="admin-dialog" @onclick:stopPropagation>
                    <header class="admin-card-header">
                        <h2>Fehlgeschlagene Dateien zurücksetzen</h2>
                    </header>
                    <p>Alle @(probeProgress?.FailedCount ?? 0) fehlgeschlagenen Dateien werden zurückgesetzt und beim nächsten Lauf der Laufzeitermittlung erneut geprüft.</p>
                    <div class="admin-actions">
                        <button id="probe-reset-all-confirm" class="btn btn-danger" @onclick="ResetAllFailedProbesAsync">Alle zurücksetzen</button>
                        <button class="btn btn-ghost" @onclick="() => confirmProbeReset = false">Abbrechen</button>
                    </div>
                </div>
            </div>
        }

        @if (deleteCandidate != null)
        {
            <div class="admin-dialog-overlay" @onclick="() => deleteCandidate = null">
                <div class="admin-dialog" @onclick:stopPropagation>
                    <header class="admin-card-header">
                        <h2>Programmregel löschen</h2>
                    </header>
                    <p>Soll die Programmregel „@deleteCandidate.Name" wirklich gelöscht werden?</p>
                    <div class="admin-actions">
                        <button id="rule-delete-confirm" class="btn btn-danger" @onclick="DeleteRuleAsync">Löschen</button>
                        <button class="btn btn-ghost" @onclick="() => deleteCandidate = null">Abbrechen</button>
                    </div>
                </div>
            </div>
        }

        @if (confirmFfmpegDownload)
        {
            <div class="admin-dialog-overlay" @onclick="() => confirmFfmpegDownload = false">
                <div class="admin-dialog" id="tvsender-download-dialog" @onclick:stopPropagation>
                    <header class="admin-card-header">
                        <h2>ffmpeg/ffprobe herunterladen</h2>
                    </header>
                    <p>Es wird ein fertiges ffmpeg-Paket für dieses System heruntergeladen. Die Programme <code>ffmpeg</code> und <code>ffprobe</code> werden im Ordner <code>tools/ffmpeg/</code> neben der Anwendung abgelegt. Eine dort vorhandene Version wird ersetzt; Ihre sonstigen Einstellungen bleiben unverändert.</p>
                    <p><strong>Lizenzhinweis:</strong> ffmpeg steht unter der GPL-Lizenz — es gelten die Lizenzbedingungen der jeweiligen ffmpeg-Distribution, insbesondere wenn Sie das Paket selbst weitergeben. Der Server nutzt ffmpeg als eigenes Hintergrundprogramm.</p>
                    <p class="form-text">Technisch: die Pakete sind statisch gebaut und mit <code>--enable-gpl</code> erstellt.</p>
                    <div class="admin-actions">
                        <button id="tvsender-download-confirm" class="btn btn-primary" @onclick="StartFfmpegDownloadAsync">Herunterladen</button>
                        <button class="btn btn-ghost" @onclick="() => confirmFfmpegDownload = false">Abbrechen</button>
                    </div>
                </div>
            </div>
        }
    </section>
}

@code {
    private bool isAdmin;
    private bool tvSenderEnabled = true;
    private string userId = string.Empty;
    private TVChannel? channel;
    private string channelName = string.Empty;
    private string? federalState;
    private int horizonHours = 48;
    private int intervalMinutes = 15;
    private int segmentLengthSeconds = 6;
    private string? segmentDirectory;
    private int segmentRetentionMinutes = 30;
    private const string StandbyDefaultLabel = "Standard-Clip (Gleich geht's los)";
    private const int StandbyCandidatePageSize = 100;
    private const int StandbySearchDebounceMilliseconds = 400;
    private long? standbyMediaItemId;
    private long? standbySavedMediaItemId;
    private string standbyCurrentLabel = StandbyDefaultLabel;
    private bool showStandbyPicker;
    private string? standbySearch;
    private long? standbySourceId;
    private List<ProgramClipGroupCandidate> standbyCandidates = new();
    private bool standbyCandidatesHasMore;
    private bool standbyCandidatesLoading;
    private CancellationTokenSource? standbySearchDebounceCts;
    private readonly string[] federalStates = ProgramSettingsService.HolidayFederalStates.ToArray();
    private string? channelStatus;
    private string? rulesStatus;
    private string? scheduleStatus;
    private bool generatePending;
    private bool confirmCleanup;
    private bool confirmReset;
    private bool confirmProbeReset;
    private bool confirmFfmpegDownload;
    private string? probeStatus;
    private string? downloadError;
    private bool downloadErrorDismissed;
    private bool downloadSuccessDismissed;
    private string? ffprobePath;
    private string? ffmpegPath;
    private FfmpegToolDownloadJobSnapshot downloadSnapshot = FfmpegToolDownloadJobSnapshot.Idle;
    private bool disposed;
    private List<ProgramRule> rules = new();
    private List<ProgramSlot> schedule = new();
    private IReadOnlyDictionary<long, ProgramRuleDiagnosis> ruleDiagnoses = new Dictionary<long, ProgramRuleDiagnosis>();
    private RuleEditModel? editRule;
    private ProgramRule? deleteCandidate;
    private string? editError;
    private List<ProgramClipGroup> clipGroups = new();
    private IReadOnlyDictionary<long, int> clipCounts = new Dictionary<long, int>();
    private List<DtoGenreOption> genreOptions = new();
    private List<DtoPlaylist> playlistOptions = new();
    private List<MediaSource> mediaSources = new();
    private MediaDurationProbeProgress? probeProgress;
    private CancellationTokenSource? refreshCts;
    private string activeTab = "regeln";
    private bool showPendingProbeDetails;
    private bool showFailedProbeDetails;

    private const int RecentProbeCount = 10;
    private static readonly TimeSpan ProbeRefreshInterval = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan DownloadRefreshInterval = TimeSpan.FromSeconds(1);

    private int DownloadPercent
        => downloadSnapshot.TotalBytes is > 0
            ? (int)Math.Clamp(100.0 * downloadSnapshot.BytesReceived / downloadSnapshot.TotalBytes.Value, 0, 100)
            : 0;

    // ARIA: a determinate bar reports the percent; without a known total the bar stays
    // indeterminate and carries no value attributes at all (aria-valuemax="0" with a
    // positive valuenow would be meaningless to screen readers). Null attribute values
    // are omitted from the rendered markup.
    private int? DownloadAriaValue => downloadSnapshot.TotalBytes > 0 ? DownloadPercent : null;
    private int? DownloadAriaMin => downloadSnapshot.TotalBytes > 0 ? 0 : null;
    private int? DownloadAriaMax => downloadSnapshot.TotalBytes > 0 ? 100 : null;

    // Die Standby-Auswahl wird — wie alle Einstellungen dieser Karte — erst mit
    // „Speichern" wirksam; weicht die angezeigte Wahl vom gespeicherten Stand ab,
    // macht der Hinweis das sichtbar (sichtbarer Zustand = wirksamer Zustand).
    private bool standbySelectionPending => standbyMediaItemId != standbySavedMediaItemId;

    private string DownloadStatusLabel
    {
        get
        {
            var bytes = downloadSnapshot.TotalBytes is > 0
                ? $"{FormatBytes(downloadSnapshot.BytesReceived)} von {FormatBytes(downloadSnapshot.TotalBytes.Value)} ({DownloadPercent} %)"
                : $"{FormatBytes(downloadSnapshot.BytesReceived)} heruntergeladen";
            return $"{downloadSnapshot.Message} — {bytes}";
        }
    }

    private IReadOnlyList<ProgramRuleMaterialType> AllowedMaterialTypes
        => editRule is null ? Array.Empty<ProgramRuleMaterialType>() : ProgramRuleService.GetAllowedMaterialTypes(editRule.RuleType);

    private IReadOnlyCollection<string>? AllowedSearchMediaTypes
        => editRule is null ? null : AllowedMaterialTypes
            .Where(t => t is ProgramRuleMaterialType.TVShow or ProgramRuleMaterialType.Movie or ProgramRuleMaterialType.MovieCollection)
            .Select(t => t.ToString())
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = auth.User.Identity?.IsAuthenticated == true && auth.User.HasClaim("IsAdmin", "True");
        if (!isAdmin)
            return;

        tvSenderEnabled = await ProgramSettings.GetTvSenderEnabledAsync();
        if (!tvSenderEnabled)
            return;

        await Client.EnsureAuthorizationTokenSilentlyAsync(auth.User);
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        channel = await ProgramRuleService.GetOrCreateChannelAsync();
        channelName = channel.Name;
        federalState = await ProgramSettings.GetHolidayFederalStateAsync();
        horizonHours = (int)(await ProgramSettings.GetProgramScheduleHorizonAsync()).TotalHours;
        intervalMinutes = (int)(await ProgramSettings.GetProgramScheduleIntervalAsync()).TotalMinutes;
        segmentLengthSeconds = (int)(await ProgramSettings.GetLiveStreamSegmentLengthAsync()).TotalSeconds;
        segmentDirectory = await ProgramSettings.GetLiveStreamSegmentDirectoryAsync();
        segmentRetentionMinutes = (int)(await ProgramSettings.GetLiveStreamSegmentRetentionAsync()).TotalMinutes;
        standbyMediaItemId = await ProgramSettings.GetLiveStreamStandbyMediaItemIdAsync();
        standbySavedMediaItemId = standbyMediaItemId;
        standbyCurrentLabel = standbyMediaItemId is { } standbyId
            ? await LoadStandbyLabelAsync(standbyId)
            : StandbyDefaultLabel;
        mediaSources = await DbContext.MediaSources.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        await ReloadGenreOptionsAsync();
        playlistOptions = (await Client.RequestPlaylistsAsync())
            .Concat(await Client.RequestPublicPlaylistsAsync())
            .GroupBy(p => p.Id)
            .Select(g => g.First())
            .OrderBy(p => p.Name)
            .ToList();
        await ReloadRulesAsync();
        await ReloadScheduleAsync();
        await ReloadClipGroupsAsync();
        await LoadProbeProgressAsync();
        RefreshToolPaths();
        downloadSnapshot = ToolDownloadService.GetSnapshot();
        // Ein bereits abgeschlossenes Ergebnis wird genau einmal angezeigt: der erste Aufruf,
        // der den Endstand vorfindet, quittiert ihn im Service — die lokale Kopie rendert ihn
        // für diese Instanz noch einmal, der nächste Seitenaufruf sieht dann Idle.
        ToolDownloadService.AcknowledgeTerminalState(downloadSnapshot.Id);

        refreshCts = new CancellationTokenSource();
        _ = ProbeProgressLoopAsync(refreshCts.Token);
        if (downloadSnapshot.IsActive)
            _ = DownloadProgressLoopAsync(refreshCts.Token);
    }

    // Panes stay rendered and are only shown/hidden by CSS, so form state, scroll positions
    // and the running refresh loop survive a tab switch without any reload.
    private void SelectTab(string tab) => activeTab = tab;

    private async Task LoadProbeProgressAsync(CancellationToken cancellationToken = default)
    {
        probeProgress = await ProbeService.GetProgressAsync(userId, RecentProbeCount, cancellationToken: cancellationToken);
    }

    // Keeps the progress card live so "running" vs. "stalled" is visible without a manual reload;
    // a single failed refresh must not kill the loop.
    private async Task ProbeProgressLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(ProbeRefreshInterval, TimeProvider);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (disposed)
                    return;

                try
                {
                    // DbContext-Zugriff muss auf dem Dispatcher laufen — ein Tick vom
                    // Threadpool würde den geteilten scoped Context mit Nutzeraktionen
                    // kollidieren lassen (Muster wie PollBackupStatusAsync in Backups.razor).
                    await InvokeAsync(async () =>
                    {
                        if (disposed)
                            return;
                        await LoadProbeProgressAsync(cancellationToken);
                        // Die Locators sind billige File.Exists-Abfragen — der ohnehin
                        // laufende Tick frischt die „fehlt"-Hinweise mit auf, damit auch
                        // ein passiver Beobachter eine Fremd-Installation ohne Reload sieht.
                        RefreshToolPaths();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch (Exception)
                {
                    // Transient failure — the next tick retries with the same data still shown.
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Makes "advancing vs. stalled" directly readable: pending items with recent activity mean
    // the probe is working; pending items without any activity in the last hour mean it is stuck
    // (e.g. ffprobe missing) or waiting.
    private static string ProbeStatusLabel(MediaDurationProbeProgress progress)
    {
        if (progress.PendingCount == 0 && progress.FailedCount == 0)
            return "Alle Videodateien sind ermittelt.";
        if (progress.PendingCount == 0)
            return $"Ermittlung abgeschlossen — {progress.FailedCount} Datei(en) dauerhaft nicht prüfbar.";
        if (progress.ProbedLastHour > 0)
            return $"Ermittlung läuft — {progress.ProbedLastHour} Datei(en) in der letzten Stunde.";
        return $"{progress.PendingCount} Datei(en) ausstehend, aber keine Aktivität in der letzten Stunde — die Ermittlung hängt möglicherweise (ffprobe verfügbar?).";
    }

    private static int ProbePercent(MediaDurationProbeProgress progress)
        => progress.TotalCount == 0 ? 0 : (int)(100.0 * progress.ProbedCount / progress.TotalCount);

