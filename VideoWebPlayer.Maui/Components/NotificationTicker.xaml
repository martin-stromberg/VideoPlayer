<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoWebPlayer.Maui.Components.NotificationTicker"
             x:Name="ThisControl"
             HeightRequest="47">
    
    <Border StrokeThickness="0" 
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="0" />
        </Border.StrokeShape>
        
        <Grid x:Name="ClipContainer" 
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            
            <!-- AbsoluteLayout für dynamische scrolling Labels -->
            <AbsoluteLayout x:Name="TickerContainer"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           IsVisible="{Binding HasMessage, Source={x:Reference ThisControl}}" />
            
            <!-- Placeholder when no message -->
            <Label Text="💾 Downloads bereit"
                   FontSize="14"
                   TextColor="#666666"
                   FontFamily="OpenSans"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Opacity="0.5"
                   IsVisible="{Binding HasMessage, Source={x:Reference ThisControl}, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>
    </Border>
    
</ContentView>
