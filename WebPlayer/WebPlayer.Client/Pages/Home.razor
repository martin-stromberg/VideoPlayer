@page "/"
@using Ljbc1994.Blazor.IntersectionObserver.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities;
@using System.Text.Json
@using System.Net.Http
@using System.Security.Claims
@using WebPlayer.Client.Services
@using WebPlayer.Data
@using WebPlayerApi.Models
@using Ljbc1994.Blazor.IntersectionObserver.Components
@attribute [Authorize]
@rendermode InteractiveWebAssembly

@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthProvider
@inject IAPIClient apiClient;
@inject IMediaDirectoryAccessApi accessApi;

<PageTitle>Mediathek</PageTitle>

@code {
    private string jsVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString();
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage)){
    <p>@ErrorMessage</p>
}

@if (CurrentSource is null)
{
    <p><em>Lade Daten...</em></p>
}
else
{
    <h3>Kategorie: @CurrentSource.Name
        <AuthorizeView Roles="admin">
            @if (!hasReloaded)
            {
                <button style="margin-left:5px" alt="Quelle aktualisieren" class="btn btn-primary" @onclick="CallReloadApi">🔄</button>
            }
        </AuthorizeView>
    </h3>

    <div class="grid-container">
        @foreach (var item in items)
        {
            <div class="grid-item">
                <div class="card">
                    <a class="nav-link" href="Details?id=@item.Id" Match="NavLinkMatch.All">
                        @if (!string.IsNullOrEmpty(item.PictureBase64))
                        {
                            <img src="data:image/png;base64,@item.PictureBase64" alt="Poster von @item.Title" style="width: 138px; height: 207px; object-fit: contain;" width="138" height="207" />
                        }
                        else
                        {
                            <img alt="Poster von @item.Title" src="img/default_movie_poster.png?v=@jsVersion" width="138" height="207"  style="background-color: black;" />
                        }
                        <h5>@item.Title</h5>
                    </a>
                </div>
            </div>
        }

        @if (!hasMoreItems)
        {
            <!-- sentinel wird nicht mehr angezeigt -->
        }
        else
        {
            <div @ref="sentinel" class="loading-indicator">
                <p>Lade weitere Inhalte…</p>
            </div>
        }

    </div>
}


@code {
    private MediaSource CurrentSource { get; set; }

    private List<MediaItemDto> items = new();
    private bool isLoading = false;
    private ElementReference sentinel;
    private bool reloadList = false;
    private IDisposable? locationChangedHandler;
    private DotNetObjectReference<Home>? dotNetRef;
    private bool activateObserverAfterRender = false;
    private bool hasMoreItems = true;
    private string DefaultSourceId = "";
    private string ErrorMessage = "";
    private bool isAdmin = false;
    private bool hasReloaded = false;
    private List<string> roles;

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        dotNetRef?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        LoadSourceFromQuery();
        _ = InvokeAsync(StateHasChanged); // 🔥 wichtig!
    }

    private async void LoadSourceFromQuery()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var newSourceId = query["source"];        

        if (!string.IsNullOrWhiteSpace(newSourceId) && (CurrentSource is null || CurrentSource.Id != newSourceId))
        {
            var newSource = await apiClient.GetSourceAsync(newSourceId);
            CurrentSource = newSource;

            items.Clear();
            hasMoreItems = true;
            activateObserverAfterRender = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);
            await OnIntersect(); // direkt laden
        }
    }
    private bool _navigated = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);            
            // Noch kein Zugriff auf sentinel hier!

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var sources = await apiClient.GetSourcesAsync();
                DefaultSourceId = string.Empty;
                foreach (var source in sources)
                {
                    var users = await accessApi.GetAccessUsersAsync(source.Id);
                    var access = users.FirstOrDefault(u => u.UserName == authState.User.Identity.Name) is not null;
                    if (string.IsNullOrWhiteSpace(DefaultSourceId) && access)
                    {
                        DefaultSourceId = source.Id;
                    }
                }
            }
        }

        if (activateObserverAfterRender && sentinel.Context != null)
        {
            activateObserverAfterRender = false;
            hasMoreItems = true;
            await JS.InvokeVoidAsync("intersectionObserver.observeElement", sentinel, dotNetRef);
        }

        if (query.Count == 0 && !string.IsNullOrWhiteSpace(DefaultSourceId) && !_navigated)
        {
            _navigated = true;
            NavManager.NavigateTo($"/?source={DefaultSourceId}");
        }
        if (firstRender) StateHasChanged(); // Seite neu rendern
        Console.WriteLine($"[Render] hasMoreItems = {hasMoreItems}, items.Count = {items.Count}");
    }

    [JSInvokable]
    public async Task OnIntersect()
    {
        if (!isLoading)
            await LoadNextPage();
    }

    private void SetError(Exception ex){
        ErrorMessage = ex.Message;
        StateHasChanged();
    }

    private async Task LoadNextPage()
    {
        if (CurrentSource is null) return;
        isLoading = true;
        try
        {
            const int count = 20;
            var isVisible = true;
            while (isVisible)
            {                
                var responseItems = await apiClient.GetMediaItems(CurrentSource.Id, items.Count, count);
                items.AddRange(responseItems);
                hasMoreItems = responseItems.Any();
                StateHasChanged();

                isVisible = await JS.InvokeAsync<bool>("intersectionObserver.isElementInViewport", sentinel);
            }
        }
        catch(Exception ex)
        {
            SetError(ex);            
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CallReloadApi()
    {
        try
        {
            hasReloaded = true;
            StateHasChanged();

            if (!await apiClient.ForceReloadSourceAsync(CurrentSource.Id))
                hasReloaded = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
        }
    }

}