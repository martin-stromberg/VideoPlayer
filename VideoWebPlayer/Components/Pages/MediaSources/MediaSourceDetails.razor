@page "/mediasource/{Id:long}"
@using ApiModels = VideoWebPlayer.Controllers.Models
@using VideoWebPlayer.ViewModels
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MediaSourceDetailsViewModel Vm
@rendermode InteractiveServer
@implements IAsyncDisposable

<script>
    window.saveScrollPosition = function (selector) {
        var el = document.querySelector(selector);
        if (el) {
            sessionStorage.setItem("scrollPos_" + selector, el.scrollLeft);
        }
    };

    window.restoreScrollPosition = function (selector) {
        var el = document.querySelector(selector);
        var pos = sessionStorage.getItem("scrollPos_" + selector);
        if (el && pos) {
            el.scrollLeft = parseInt(pos, 10);
        }
    };

    window.setSelectedMediaItem = function(mediaItemid) {
        sessionStorage.setItem("selectedMediaItem", mediaItemid);
    }

    window.getSelectedMediaItem = function() {
        var id = sessionStorage.getItem("selectedMediaItem");
        return id ? id : "";
    }
</script>

@code {
    [Parameter]
    public long Id { get; set; }

    private ElementReference BottomMarker;
    private DotNetObjectReference<MediaSourceDetails>? _dotNetObjectReference;
    private long? _initializedSourceId;
    private bool _needsInitialPageLoad;
    private int _initialLoadVersion;

    [JSInvokable]
    public async Task OnBottomVisible()
    {
        if (Vm.IsAuthenticated == true)
            await LoadNextPageAsync(Id);
    }

    private async Task LoadNextPageAsync(long sourceId)
    {
        if (Vm.IsLoading)
            return;

        var newEntries = await Vm.LoadNextPageAsync(sourceId);

        if (!long.TryParse(await JS.InvokeAsync<string>("getSelectedMediaItem"), out var selectedId))
            selectedId = 0;

        if (Vm.ActiveSourceId == sourceId && selectedId != 0 && newEntries.Count > 0 && !newEntries.Any(e => e.Id == selectedId))
        {
            await LoadNextPageAsync(sourceId);
            return;
        }

        if (Vm.ActiveSourceId == sourceId)
            await JS.InvokeVoidAsync("setSelectedMediaItem", "0");

        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initializedSourceId == Id)
            return;

        _initializedSourceId = Id;
        _needsInitialPageLoad = true;
        _initialLoadVersion++;
        await Vm.InitializeAsync(Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsInitialPageLoad && Vm.IsAuthenticated == true && Vm.MediaSource is not null && Vm.ActiveSourceId == Id)
        {
            try
            {
                var sourceId = Id;
                var initialLoadVersion = _initialLoadVersion;

                while (Vm.IsLoading && IsInitialLoadCurrent(sourceId, initialLoadVersion))
                    await Task.Delay(10);

                if (!IsInitialLoadCurrent(sourceId, initialLoadVersion))
                    return;

                _needsInitialPageLoad = false;

                if (!IsInitialLoadCurrent(sourceId, initialLoadVersion, requirePendingLoad: false))
                    return;

                await LoadNextPageAsync(sourceId);

                if (!IsInitialLoadCurrent(sourceId, initialLoadVersion, requirePendingLoad: false))
                    return;

                _dotNetObjectReference ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("observeBottom", BottomMarker, _dotNetObjectReference);
            }
            catch(Exception ex)
            {
                Console.WriteLine($"Fehler beim Initialisieren des JavaScript-Observers: {ex.Message}");
            }
        }

        // Scrollposition der Medienliste wiederherstellen
        await JS.InvokeVoidAsync("restoreScrollPosition", ".media-grid");
    }

    private bool IsInitialLoadCurrent(long sourceId, int initialLoadVersion, bool requirePendingLoad = true)
        => (!requirePendingLoad || _needsInitialPageLoad)
           && _initialLoadVersion == initialLoadVersion
           && Id == sourceId
           && Vm.ActiveSourceId == sourceId;

    private string GetPosterUrl(ApiModels.MediaEntryDto entry)
        => entry.PictureId.HasValue
            ? $"/api/pictures/{entry.PictureId}?access_token={Vm.AuthorizationToken}"
            : "/images/placeholder.png";

    private async Task OnMovieSelected(ApiModels.MediaEntryDto movie)
    {
        // Scrollposition speichern
        await JS.InvokeVoidAsync("setSelectedMediaItem", movie.Id.ToString());
        await JS.InvokeVoidAsync("saveScrollPosition", ".media-grid");
        if (!string.IsNullOrEmpty(movie.Url))
            Navigation.NavigateTo(movie.Url);
    }

    private async Task SearchEntries()
    {
        Vm.ResetEntries();
        await LoadNextPageAsync(Id);
        _dotNetObjectReference ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("observeBottom", BottomMarker, _dotNetObjectReference);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchEntries();
        }
    }

    private async Task OnGenreSelected(long? genreId)
    {
        Vm.SetGenre(genreId);
        Vm.ResetEntries();
        await LoadNextPageAsync(Id);
        _dotNetObjectReference ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("observeBottom", BottomMarker, _dotNetObjectReference);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disconnectMediaSourceBottomObserver");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        _dotNetObjectReference?.Dispose();
        _dotNetObjectReference = null;
    }
}

@if (Vm.IsLoading)
{
    <p>Lade Daten...</p>
}
else if (Vm.IsAuthenticated != true)
{
    <PageTitle>Zugriff verweigert</PageTitle>
    <div class="alert alert-warning">Bitte melden Sie sich an, um die Inhalte zu sehen.</div>
}
else if (Vm.MediaSource == null)
{
    <PageTitle>Unbekannte Quelle</PageTitle>
    <div class="alert alert-danger">Quelle nicht gefunden.</div>
}
else
{
    <PageTitle>@Vm.MediaSource.Name</PageTitle>    

    <section class="media-section">
        <span class="section-kicker">Quelle</span>
        <h1>@Vm.MediaSource.Name</h1>
    </section>

    <div class="search-bar">
        <input type="text"
               class="form-control"
               placeholder="Suche..."
               @bind="Vm.SearchText"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown" />
        <button class="btn btn-primary" @onclick="SearchEntries">Suchen</button>
    </div>

    <div class="genre-scrollbar">
        <button class="genre-btn @(Vm.SelectedGenreId == null ? "selected" : "")"
                @onclick="() => OnGenreSelected(null)">
            Alle
        </button>
        @foreach (var genre in Vm.SourceGenres.Genres)
        {
            <button class="genre-btn @(Vm.SelectedGenreId == genre.Id ? "selected" : "")"
                    @onclick="() => OnGenreSelected(genre.Id)">
                @if (!string.IsNullOrWhiteSpace(genre.IconUrl))
                {
                    <img class="genre-icon" src="@genre.IconUrl" alt="" />
                }
                @genre.Name
            </button>
        }
    </div>

    <div class="media-grid">
        @foreach (var entry in Vm.Entries)
        {
            <a class="media-box-link" href="@entry.Url">
                <div class="media-box" @onclick="async () => await OnMovieSelected(entry)" title="@entry.Title">
                    @if (entry.ItemCount > 1)
                    {
                        <span class="collection-indicator" title="Enthält mehrere Filme">
                            ⧉
                        </span>
                    }
                    <img class="media-poster"
                         src="@GetPosterUrl(entry)"
                         alt="@entry.Title"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                    <span class="media-quick-play" aria-hidden="true">&#9654;</span>
                    @if (entry.WatchedAt.HasValue)
                    {
                        <img class="watched-indicator"
                             src="/images/gesehen64x64.png"
                             alt=""
                             title="Gesehen"
                             data-testid="watched-indicator" />
                    }
                    <div class="media-card-overlay">
                        <span class="media-title-text">@entry.Title</span>
                    </div>
                </div>
            </a>
        }
        <div @ref="BottomMarker"></div>
    </div>
}
