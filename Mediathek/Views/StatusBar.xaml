<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mediathek.ViewModels.Global;assembly=MediathekMaui"
             x:Class="Mediathek.Views.StatusBar"
             x:DataType="vm:GlobalStatusViewModel">
    <VerticalStackLayout>
        <Label Grid.Row="2" Text="{Binding StatusMessage}" VerticalOptions="End"/>
    </VerticalStackLayout>
</ContentView>
