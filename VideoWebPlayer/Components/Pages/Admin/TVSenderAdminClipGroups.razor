@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@inject IProgramClipGroupService ClipGroupService

<div class="admin-card admin-card-wide">
    <div class="admin-card-header">
        <div class="admin-card-header-left">
            <h2>Clip-Gruppen</h2>
            <span class="admin-chip">@Groups.Count Einträge</span>
        </div>
        <button id="clipgroup-new" class="btn btn-sm btn-primary" @onclick="StartGroupCreate">Neue Gruppe</button>
    </div>
    @if (Groups.Count == 0)
    {
        <div class="admin-empty-state">
            <strong>Keine Clip-Gruppen vorhanden</strong>
            <span>Platzhalter-Clips lassen sich hier in benannte Gruppen einteilen.</span>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="table table-dark table-striped align-middle">
                <thead><tr><th>Name</th><th>Clips</th><th></th></tr></thead>
                <tbody>
                @foreach (var g in Groups)
                {
                    <tr class="clipgroup-row" data-group-id="@g.Id">
                        <td>@g.Name@(g.IsSystem ? " (System — automatisch befüllt)" : "")</td>
                        <td>@(Counts.GetValueOrDefault(g.Id))</td>
                        <td class="actions-cell">
                            <button class="btn btn-sm btn-primary clipgroup-manage" @onclick="() => SelectGroupAsync(g)">@(g.IsSystem ? "Ansehen" : "Clips verwalten")</button>
                            @if (!g.IsSystem)
                            {
                                <button class="btn btn-sm btn-outline-light clipgroup-rename" @onclick="() => StartGroupRename(g)">Umbenennen</button>
                                <button class="btn btn-sm btn-danger clipgroup-delete" @onclick="() => deleteGroupCandidate = g">Löschen</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(clipGroupStatus))
    {
        <div class="form-text" id="tvsender-clipgroups-status">@clipGroupStatus</div>
    }
</div>

@if (selectedGroup is not null)
{
    <div class="admin-card admin-card-wide" id="clipgroup-members-card">
        <div class="admin-card-header">
            <div class="admin-card-header-left">
                <h2>Clips in „@selectedGroup.Name"</h2>
                <span class="admin-chip">@groupMembers.Count Einträge</span>
            </div>
            <button class="btn btn-sm btn-outline-light" @onclick="() => selectedGroup = null">Schließen</button>
        </div>
        @if (selectedGroup.IsSystem)
        {
            <p class="form-text" id="clipgroup-system-hint">Die reservierte Gruppe „Trailer" wird zur Planungszeit automatisch mit Trailern anstehender Filme befüllt — es gibt keine gespeicherte Mitgliederliste und sie kann nicht manuell verwaltet werden.</p>
        }
        else
        {
            <p class="form-text" id="clipgroup-noduration-hint">Clips ohne ermittelte Laufzeit (Markierung „keine Laufzeit") lassen sich zuordnen, werden bei der Restzeit-Auffüllung aber nicht berücksichtigt — die Laufzeitermittlung läuft im Hintergrund, Fortschritt und Wiederholung im Tab „Laufzeitermittlung".</p>
            <div class="admin-table-wrap">
                <table class="table table-dark table-striped align-middle">
                    <thead><tr><th>Name</th><th>Quelle</th><th>Laufzeit</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var m in groupMembers)
                    {
                        <tr class="clipgroup-member-row" data-media-item-id="@m.MediaItemId">
                            <td>@m.Name</td>
                            <td>@m.SourceName</td>
                            <td>@(m.Duration is { } d ? d.ToString(@"hh\:mm\:ss") : "keine Laufzeit")</td>
                            <td class="actions-cell"><button class="btn btn-sm btn-danger clipgroup-member-remove" @onclick="() => RemoveMemberAsync(m.MediaItemId)">Entfernen</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <h3 class="mt-3">Clips hinzufügen</h3>
            <div class="admin-settings-grid">
                <div>
                    <label class="form-label" for="clip-candidate-search">Suche</label>
                    <input id="clip-candidate-search" class="form-control" @bind="clipCandidateSearch" @bind:event="oninput" />
                </div>
                <div>
                    <label class="form-label" for="clip-candidate-source">Quelle</label>
                    <select id="clip-candidate-source" class="form-control" @bind="clipCandidateSourceId">
                        <option value="">Alle Quellen</option>
                        @foreach (var s in MediaSources)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>
            <button id="clip-candidate-refresh" class="btn btn-sm btn-outline-light" @onclick="ReloadCandidatesAsync">Suchen</button>
            @if (clipCandidates.Count == 0)
            {
                <div class="admin-empty-state" id="clip-candidate-empty">
                    <strong>Keine zuordenbaren Clips gefunden</strong>
                    <span>Angeboten werden nur Videodateien ohne Film-/Serien-Zuordnung — Suche oder Quellenfilter ggf. anpassen.</span>
                </div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="table table-dark table-striped align-middle">
                        <thead><tr><th>Name</th><th>Quelle</th><th>Laufzeit</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in clipCandidates)
                        {
                            <tr class="clip-candidate-row" data-media-item-id="@c.MediaItemId">
                                <td>@c.Name</td>
                                <td>@c.SourceName</td>
                                <td>@(c.Duration is { } d ? d.ToString(@"hh\:mm\:ss") : "keine Laufzeit")</td>
                                @if (IsGroupMember(c.MediaItemId))
                                {
                                    <td class="actions-cell"><span class="admin-chip clip-candidate-member">Bereits zugeordnet</span></td>
                                }
                                else
                                {
                                    <td class="actions-cell"><button class="btn btn-sm btn-primary clip-candidate-add" @onclick="() => AddCandidateAsync(c.MediaItemId)">Hinzufügen</button></td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (clipCandidatesHasMore)
            {
                <p class="form-text" id="clip-candidate-more-hint">Es gibt weitere Treffer — Suche oder Quelle eingrenzen oder weitere laden.</p>
                <button id="clip-candidate-more" class="btn btn-sm btn-outline-light" @onclick="LoadMoreCandidatesAsync">Weitere laden</button>
            }
        }
    </div>
}

@if (groupEdit != null)
{
    <div class="admin-dialog-overlay" @onclick="() => groupEdit = null">
        <div class="admin-dialog" id="clipgroup-editor" @onclick:stopPropagation>
            <header class="admin-card-header">
                <h2>@(groupEdit.Id == 0 ? "Neue Clip-Gruppe" : $"Clip-Gruppe „{groupEdit.Name}“ umbenennen")</h2>
            </header>
            <label class="form-label" for="clipgroup-name">Name</label>
            <input id="clipgroup-name" class="form-control" @bind="groupEdit.Name" />
            @if (!string.IsNullOrWhiteSpace(groupEditError))
            {
                <div class="alert alert-danger" id="clipgroup-edit-error">@groupEditError</div>
            }
            <div class="admin-actions">
                <button id="clipgroup-save" class="btn btn-primary" @onclick="SaveGroupAsync">Speichern</button>
                <button class="btn btn-ghost" @onclick="() => groupEdit = null">Abbrechen</button>
            </div>
        </div>
    </div>
}

@if (deleteGroupCandidate != null)
{
    <div class="admin-dialog-overlay" @onclick="() => deleteGroupCandidate = null">
        <div class="admin-dialog" @onclick:stopPropagation>
            <header class="admin-card-header">
                <h2>Clip-Gruppe löschen</h2>
            </header>
            <p>Soll die Clip-Gruppe „@deleteGroupCandidate.Name" wirklich gelöscht werden? Ihre Zuordnungen zu Regeln werden ebenfalls entfernt.</p>
            <div class="admin-actions">
                <button id="clipgroup-delete-confirm" class="btn btn-danger" @onclick="DeleteGroupAsync">Löschen</button>
                <button class="btn btn-ghost" @onclick="() => deleteGroupCandidate = null">Abbrechen</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The clip groups known to the page — also feed the rule editor's group selection.</summary>
    [Parameter] public List<ProgramClipGroup> Groups { get; set; } = [];

    /// <summary>Member count per group id (loaded once per reload in the page, not per row).</summary>
    [Parameter] public IReadOnlyDictionary<long, int> Counts { get; set; } = new Dictionary<long, int>();

    /// <summary>All media sources, for the candidate source filter.</summary>
    [Parameter] public List<MediaSource> MediaSources { get; set; } = [];

    /// <summary>Id of the current admin user (server-side enforcement runs against it).</summary>
    [Parameter] public string UserId { get; set; } = string.Empty;

    /// <summary>Raised after every membership/group mutation so the page reloads groups and counts.</summary>
    [Parameter] public EventCallback OnGroupsChanged { get; set; }

    private const int ClipCandidatePageSize = 100;

    private ProgramClipGroup? selectedGroup;
    private List<ProgramClipGroupClip> groupMembers = new();
    private List<ProgramClipGroupCandidate> clipCandidates = new();
    private bool clipCandidatesHasMore;
    private string? clipCandidateSearch;
    private long? clipCandidateSourceId;
    private ClipGroupEditModel? groupEdit;
    private string? groupEditError;
    private ProgramClipGroup? deleteGroupCandidate;
    private string? clipGroupStatus;

    private void StartGroupCreate()
    {
        groupEditError = null;
        groupEdit = new ClipGroupEditModel();
    }

    private void StartGroupRename(ProgramClipGroup group)
    {
        groupEditError = null;
        groupEdit = new ClipGroupEditModel { Id = group.Id, Name = group.Name };
    }

    private async Task SaveGroupAsync()
    {
        if (groupEdit is null)
            return;
        groupEditError = null;
        try
        {
            if (groupEdit.Id == 0)
                await ClipGroupService.CreateGroupAsync(UserId, groupEdit.Name);
            else
                await ClipGroupService.RenameGroupAsync(UserId, groupEdit.Id, groupEdit.Name);
            groupEdit = null;
            clipGroupStatus = "Clip-Gruppe wurde gespeichert.";
            await OnGroupsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            groupEditError = ex.Message;
        }
    }

    private async Task DeleteGroupAsync()
    {
        if (deleteGroupCandidate is null)
            return;
        try
        {
            await ClipGroupService.DeleteGroupAsync(UserId, deleteGroupCandidate.Id);
            if (selectedGroup?.Id == deleteGroupCandidate.Id)
                selectedGroup = null;
            deleteGroupCandidate = null;
            clipGroupStatus = "Clip-Gruppe wurde gelöscht.";
            await OnGroupsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            clipGroupStatus = ex.Message;
            deleteGroupCandidate = null;
        }
    }

    private async Task SelectGroupAsync(ProgramClipGroup group)
    {
        selectedGroup = group;
        clipCandidateSearch = null;
        clipCandidateSourceId = null;
        await ReloadGroupMembersAsync();
        // Die Kandidaten-Auswahl wird nur für verwaltbare Gruppen gerendert — für die
        // System-Gruppe „Trailer" wird die teure Kandidaten-Abfrage nicht ausgeführt.
        if (group.IsSystem)
        {
            clipCandidates = [];
            clipCandidatesHasMore = false;
        }
        else
        {
            await ReloadCandidatesAsync();
        }
    }

    private async Task ReloadGroupMembersAsync()
    {
        if (selectedGroup is not null)
            groupMembers = await ClipGroupService.GetGroupClipsAsync(UserId, selectedGroup.Id);
    }

    private bool IsGroupMember(long mediaItemId)
        => groupMembers.Any(m => m.MediaItemId == mediaItemId);

    private async Task ReloadCandidatesAsync()
    {
        clipCandidates = [];
        clipCandidatesHasMore = false;
        if (selectedGroup is null || selectedGroup.IsSystem)
            return;
        await LoadMoreCandidatesAsync();
    }

    // Pages the candidate list: one extra row beyond the page size proves further hits exist —
    // the "Weitere laden" button then extends the list in place.
    private async Task LoadMoreCandidatesAsync()
    {
        if (selectedGroup is null || selectedGroup.IsSystem)
            return;
        var page = await ClipGroupService.GetClipCandidatesAsync(
            UserId, clipCandidateSearch, clipCandidateSourceId, clipCandidates.Count, ClipCandidatePageSize + 1);
        clipCandidatesHasMore = page.Count > ClipCandidatePageSize;
        clipCandidates.AddRange(page.Take(ClipCandidatePageSize));
    }

    private async Task AddCandidateAsync(long mediaItemId)
    {
        if (selectedGroup is null)
            return;
        clipGroupStatus = null;
        try
        {
            await ClipGroupService.AddClipsToGroupAsync(UserId, selectedGroup.Id, [mediaItemId]);
            await ReloadGroupMembersAsync();
            await OnGroupsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            clipGroupStatus = ex.Message;
        }
    }

    private async Task RemoveMemberAsync(long mediaItemId)
    {
        if (selectedGroup is null)
            return;
        clipGroupStatus = null;
        try
        {
            await ClipGroupService.RemoveClipFromGroupAsync(UserId, selectedGroup.Id, mediaItemId);
            await ReloadGroupMembersAsync();
            await OnGroupsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            clipGroupStatus = ex.Message;
        }
    }

    private sealed class ClipGroupEditModel
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
