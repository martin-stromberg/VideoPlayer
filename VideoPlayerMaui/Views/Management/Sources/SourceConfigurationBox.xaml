<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Management.Sources"
             x:Class="VideoPlayer.Views.Management.Sources.SourceConfigurationBox"
             x:DataType="vm:SourceSettingsViewModel">
    <Frame Margin="5" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Text="{Binding Title}"/>
        </Grid>
    </Frame>
</ContentView>
