<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VideoWebPlayer.Maui.ViewModels"
             x:Class="VideoWebPlayer.Maui.SourceOverviewPage"
             x:DataType="viewmodels:SourceOverviewViewModel"
             BackgroundColor="#000000">
    <Grid BackgroundColor="#181820" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="47" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Image Grid.Row="0" Grid.Column="0" Source="background_header_left.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="1" Source="background_header_middle.png" Aspect="Fill" />
        <Image Grid.Row="0" Grid.Column="2" Source="background_header_right.png" Aspect="Fill" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SourceName}" FontSize="28" FontAttributes="Bold" TextColor="#FFDDAA" Padding="20,20,20,15" FontFamily="OpenSansSemibold">
            <Label.Shadow>
                <Shadow Brush="#000000" Offset="5,5" Radius="6" />
            </Label.Shadow>
        </Label>

        <!-- Content -->
        <Image Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Source="background_content_left.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Source="background_content_middle.png" Aspect="Fill" />
        <Image Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Source="background_content_right.png" Aspect="Fill" />

        <!-- Genres Bar -->
        <BoxView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" BackgroundColor="#23232a" HeightRequest="70" />

        <CollectionView Grid.Row="1" Grid.Column="1" 
                        ItemsSource="{Binding Genres}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedGenre}"
                        Margin="10,15">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:GenreViewModel">
                    <Border BackgroundColor="#FFB84D"
                            StrokeThickness="0"
                            Padding="20,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Name}"
                               FontSize="14"
                               TextColor="#000000"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!-- Items with Infinite Scroll -->
        <ScrollView Grid.Row="2" Grid.Column="1"
                    Margin="10"
                    Scrolled="OnScrolled">
            <CollectionView x:Name="ItemsCollectionView"
                            ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="15" VerticalItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MediaItemViewModel">
                        <Border StrokeThickness="0" BackgroundColor="Transparent">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3" />
                            </Border.Shadow>
                            <Grid RowDefinitions="*,Auto">
                                <Border Grid.Row="0" 
                                        BackgroundColor="{Binding BackgroundColor}"
                                        StrokeThickness="0"
                                        HeightRequest="150"
                                        WidthRequest="150">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8,8,0,0" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ImageSource}" Aspect="AspectFit" />
                                </Border>
                                <Label Grid.Row="1" 
                                       Text="{Binding Title}" 
                                       FontSize="12" 
                                       TextColor="#FFDDAA" 
                                       Padding="5" 
                                       LineBreakMode="TailTruncation" 
                                       MaxLines="2" 
                                       BackgroundColor="#23232a"
                                       WidthRequest="150" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2" Grid.Column="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#FFB84D"
                           WidthRequest="50"
                           HeightRequest="50"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Footer -->
        <Image Grid.Row="3" Grid.Column="0" Source="background_footer_left.png" Aspect="Fill" />
        <Image Grid.Row="3" Grid.Column="1" Source="background_footer_middle.png" Aspect="Fill" />
        <Image Grid.Row="3" Grid.Column="2" Source="background_footer_right.png" Aspect="Fill" />
    </Grid>
</ContentPage>
