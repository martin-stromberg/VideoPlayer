<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.MediaLists.MediaListItem;assembly=VideoPlayerMaui"
             xmlns:view="clr-namespace:VideoPlayer.Views.MediaLists"
             x:Class="VideoPlayer.Views.MediaLists.MediaListItemView"
             x:DataType="vm:MediaListItemViewModel">
    <Grid>
        <Frame Margin="5" WidthRequest="200" HeightRequest="200" IsVisible="{Binding IsBoxMode}">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="ListItemTapped"/>
            </Frame.GestureRecognizers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image 
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2" 
                Source="{Binding Picture}"/>
                <Label
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="{Binding Title}"
                VerticalOptions="End" 
                HorizontalOptions="Center" />
                <Frame
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="Transparent" 
                Margin="0" 
                Padding="0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ListItemPlaybackTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="▶️" TextColor="Red" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Frame>
            </Grid>
        </Frame>
        <Frame Margin="5" HeightRequest="100" IsVisible="{Binding IsLaneMode}" HorizontalOptions="FillAndExpand">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="ListItemTapped"/>
            </Frame.GestureRecognizers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image 
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="1" 
                    Source="{Binding Picture}"/>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Text="{Binding Title}"
                    VerticalOptions="Start" 
                    HorizontalOptions="Start" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Text="{Binding Path}"
                    VerticalOptions="Start" 
                    HorizontalOptions="Start" />
                <Frame
                    Grid.Row="0"
                    Grid.Column="3"
                    BackgroundColor="Transparent" 
                    Margin="0" 
                    Padding="0">        
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ListItemPlaybackTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="▶️" TextColor="Red" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Frame>
                <ImageButton Grid.Column="2" WidthRequest="20" HeightRequest="20" Source="process.png" Command="{Binding ProcessItem}"/>

            </Grid>
        </Frame>
    </Grid>
</ContentView>
