<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyVideoPlayer.Views.SourceConfigurationView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Text="Name" VerticalOptions="Center" HorizontalOptions="Center" />
        <Entry Grid.Column="1" Grid.Row="0" Text="{Binding Name}"/>

        <Label Grid.Column="0" Grid.Row="1" Text="Verbindungsart" VerticalOptions="Center" HorizontalOptions="Center" />
        <Picker Grid.Column="1" Grid.Row="1" ItemsSource="{Binding TypeNames}" SelectedItem="{Binding Type}"/>

        <Label Grid.Column="0" Grid.Row="2" Text="Host" VerticalOptions="Center" HorizontalOptions="Center" />
        <Entry Grid.Column="1" Grid.Row="2" Text="{Binding Host}"/>

        <Label Grid.Column="0" Grid.Row="3" Text="Benutzername" VerticalOptions="Center" HorizontalOptions="Center" />
        <Entry Grid.Column="1" Grid.Row="3" Text="{Binding Username}"/>

        <Label Grid.Column="0" Grid.Row="4" Text="Passwort" VerticalOptions="Center" HorizontalOptions="Center" />
        <Entry Grid.Column="1" Grid.Row="4" Text="{Binding Password}" IsPassword="True"/>

        <Label Grid.Column="0" Grid.Row="5" Text="Pfad" VerticalOptions="Center" HorizontalOptions="Center" />
        <Entry Grid.Column="1" Grid.Row="5" Text="{Binding RootPath}"/>

        <Button Grid.Column="0" Grid.Row="7" Text="Abbrechen" Command="{Binding Cancel}"/>
        <Button Grid.Column="1" Grid.Row="7" Text="Speichern" Command="{Binding Save}"/>
    </Grid>
</ContentView>
