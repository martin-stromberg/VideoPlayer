<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyVideoPlayer.ViewModels"
             x:Class="MyVideoPlayer.Views.ControlPanelView">
    <VerticalStackLayout x:DataType="vm:ControlPanelViewModel">
        <Button Text="Quellen" Command="{Binding NavigateToSources}" Margin="10"/>
        <Button Text="Quellen neu einlesen" Command="{Binding CleanScan}" Margin="10" />
        <Button Text="Protokoll anzeigen" Command="{Binding ShowLog}" Margin="10"/>
        <Button Text="Daten exportieren" Command="{Binding ExportData}" Margin="10"/>
    </VerticalStackLayout>
</ContentView>
