<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mediathek.ViewModels.MediaLists;assembly=MediathekMaui"
             xmlns:view="clr-namespace:MediaPlayer.Views.MediaLists"
             x:Class="MediaPlayer.Views.MediaLists.TVShowsPage"
             x:DataType="vm:BaseMediaListViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" 
                     IconImageSource="add_folder.png"
                     Order="Primary"
                     Command="{Binding AddCollection}" 
                     CommandParameter="addcollection" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <FlexLayout
        AlignContent="Start"
        AlignItems="Start"
        AlignSelf="Start"
        BindableLayout.ItemsSource="{Binding Items}"
        Direction="Row"
        JustifyContent="Start"
        Wrap="Wrap">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <view:MediaListItemView/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
    </ScrollView>
</ContentPage>