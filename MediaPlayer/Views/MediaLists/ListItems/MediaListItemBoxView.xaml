<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mediathek.ViewModels.MediaLists.MediaListItem;assembly=MediathekMaui"             
             x:Class="MediaPlayer.Views.MediaLists.ListItems.MediaListItemBoxView"
             x:DataType="vm:MediaListItemViewModel">
    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Image 
        Grid.Row="0"
        Grid.RowSpan="3"
        Grid.Column="0"
        Grid.ColumnSpan="2" 
        Source="{Binding Picture}">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="ListItemTapped"/>
            </Image.GestureRecognizers>
        </Image>
        <VerticalStackLayout
        Grid.Row="3"
        Grid.RowSpan="4"
        Grid.Column="0"
        Grid.ColumnSpan="2">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="ListItemDetailTapped"/>
            </VerticalStackLayout.GestureRecognizers>
            <Label
            Text="{Binding Title}"                    
            HorizontalOptions="Start" />
            <Label 
            Text="{Binding Subtitle}"
            HorizontalOptions="StartAndExpand"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>
