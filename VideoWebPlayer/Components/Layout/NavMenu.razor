@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VideoWebPlayer.Client
@using VideoWebPlayer.Client.Models
@using VideoWebPlayer.Data
@using VideoWebPlayer.Services
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject VideoWebPlayerClient Client
@inject ILoginIpBlockService IpBlockService          
@inject IJSRuntime JS                               
@rendermode InteractiveServer

@implements IDisposable

@inject NavigationManager NavigationManager

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (mediaSources.Any())
                {
                    <div class="nav-item px-3">
                        <span class="nav-link disabled">Quellen</span>
                    </div>
                    @foreach (var source in mediaSources)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"/mediasource/{source.Id}")">
                                <span class="bi bi-folder-video"></span> @source.Name
                            </NavLink>
                        </div>
                    }
                }

                @if (context.User.HasClaim("IsAdmin", "True"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin/program-settings">
                            <span class="bi bi-gear"></span> Programmeinstellungen
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView>
            @if (context.User.HasClaim("IsAdmin", "True"))
            {
                <div class="nav-item px-3">
                    <span class="nav-link disabled">Verwaltung</span>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/mediasources">
                        <span class="bi bi-folder-video"></span> Quellen
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/genres">
                        <span class="bi oi-list-rich" aria-hidden="true"></span> Genres
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/backups">
                        <span class="bi bi-archive"></span> Backups
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/updates">
                        <span class="bi bi-arrow-clockwise"></span> Updates
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link position-relative" href="/admin/security">
                        <span class="bi bi-shield-lock"></span> Sicherheit
                        @if (newBlockedCount > 0)
                        {
                            <span class="security-badge">@newBlockedCount</span>
                        }
                    </NavLink>
                </div>
            }
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private List<DtoMediaSource> mediaSources = new();

    // Badge-Status
    private int newBlockedCount;
    private DateTime? lastSecurityVisitUtc;
    private bool badgeInitialized;
    private const string LastVisitKey = "security.lastVisitUtc";

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        mediaSources = (await Client.RequestSourcesAsync()).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Admin-Check über AuthStateProvider
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.HasClaim("IsAdmin", "True"))
                await LoadSecurityBadgeAsync();
        }
    }

    private async Task LoadSecurityBadgeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", LastVisitKey);
            if (DateTime.TryParse(stored, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
                lastSecurityVisitUtc = dt.ToUniversalTime();

            var blocked = IpBlockService.GetBlockedIps(); // liefert Liste
            newBlockedCount = (lastSecurityVisitUtc.HasValue)
                ? blocked.Count(b => b.BlockedAtUtc > lastSecurityVisitUtc.Value)
                : blocked.Count();

            badgeInitialized = true;
            StateHasChanged();
        }
        catch
        {
            // Ignorieren – Badge fällt dann einfach weg
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        if (currentUrl.Equals("admin/security", StringComparison.OrdinalIgnoreCase))
        {
            _ = MarkSecurityVisitedAsync();
        }
        StateHasChanged();
    }

    private async Task MarkSecurityVisitedAsync()
    {
        lastSecurityVisitUtc = DateTime.UtcNow;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LastVisitKey, lastSecurityVisitUtc.Value.ToString("o"));
        }
        catch { }
        newBlockedCount = 0;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
