<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoPlayer.ViewModels.Management.Sources"
             x:Class="VideoPlayer.Views.Management.Sources.SourceFTPConfigurationBox"
             x:DataType="vm:SourceSettingsViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Text="Host:" />
        <Entry Grid.Column="1" Grid.Row="0" Text="{Binding Host}"/>

        <Label Grid.Column="0" Grid.Row="1" Text="Benutzer:" />
        <Entry Grid.Column="1" Grid.Row="1" Text="{Binding Username}"/>

        <Label Grid.Column="0" Grid.Row="2" Text="Passwort:" />
        <Entry Grid.Column="1" Grid.Row="2" Text="{Binding Password}" IsPassword="true"/>

        <Label Grid.Column="0" Grid.Row="3" Text="Pfad:" />
        <Entry Grid.Column="1" Grid.Row="3" Text="{Binding Path}"/>

        <Button Grid.Column="1" Grid.Row="5" Text="Speichern" Command="{Binding Save}"/>
    </Grid>
</ContentView>
