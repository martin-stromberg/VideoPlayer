@page "/Details"
@using Ljbc1994.Blazor.IntersectionObserver.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities;
@using System.Text.Json
@using System.Net.Http
@using WebPlayer.Client.Services
@using WebPlayerApi.Models
@using Ljbc1994.Blazor.IntersectionObserver.Components
@attribute [Authorize]
@rendermode InteractiveWebAssembly

@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject IAPIClient apiClient;

@code {
    private string jsVersion => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString();
}

@if (CurrentItem is null) {
    <PageTitle>Mediathek</PageTitle>
    <p>Lade Daten...</p>
}
else {
    <PageTitle>@CurrentItem.Title</PageTitle>

    <div class="media-item-details">
        <div class="main-item">
            @if (!string.IsNullOrEmpty(CurrentItem.PictureBase64))
            {
                <img src="@GetImageSrc(CurrentItem.PictureBase64)" alt="Poster von @CurrentItem.Title" class="main-image" />
            }
            <div class="main-title">@CurrentItem.Title</div>
        </div>

        <div class="children-list">
            @if (CurrentItem.Children is not null)
                @foreach (var child in CurrentItem.Children)
                {
                    <div class="child-item">
                        <a class="child-link" href="@GetPlayUrl(child.Id)">
                            @if (!string.IsNullOrEmpty(child.PictureBase64))
                            {
                                <img src="@GetImageSrc(child.PictureBase64)" alt="Poster von @child.Title" class="child-image" style="width: 69px; height: 103px; object-fit: contain;" width="69" height="103" />
                            }
                            else
                            {
                                <img alt="Poster von @child.Title" src="img/default_movie_poster.png?v=@jsVersion" width="69" height="103" class="child-image" style="background-color: black;" />
                            }
                            <div class="child-info">
                                <div class="child-title">@child.Title</div>
                                @if (child.ReleaseDate != DateTime.MinValue)
                                {
                                    <div class="child-date">@child.ReleaseDate.ToShortDateString()</div>
                                }
                                <div class="child-plot">@child.Plot</div>
                            </div>
                        </a>
                        <a class="download-button" href="@GetDownloadUrl(child.Id, CurrentItem.Id)">💾</a>
                    </div>
                }
        </div>
    </div>
}



@code {
    private HttpClient? Http;
    public string? id { get; set; }
    private MediaItemDetailsDto CurrentItem { get; set; }
    private bool isLoading { get; set; } = false;

    private string GetImageSrc(string base64)
    {
        return $"data:image/jpeg;base64,{base64}";
    }
    private string GetPlayUrl(string childId)
    {
        return $"/Play?id={Uri.EscapeDataString(childId)}";
    }
    private string GetDownloadUrl(string childId, string parentId) =>
        $"{apiClient.BaseAddress}api/MediaItems/download/{Uri.EscapeDataString(childId)}";

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            LoadSourceFromQuery();
        return base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        LoadSourceFromQuery();
        _ = InvokeAsync(StateHasChanged); // 🔥 wichtig!
    }

    private async void LoadSourceFromQuery()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var newId = query["id"];

        if (newId != id)
        {
            id = newId;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);
            await OnIntersect(); // direkt laden
        }
    }

    [JSInvokable]
    public async Task OnIntersect()
    {
        if (!isLoading)
            await LoadNextPage();
    }

    private async Task LoadNextPage()
    {
        if (string.IsNullOrEmpty(id)) return;
        isLoading = true;
        try
        {
            var item = await apiClient.GetMediaItemAsync(id);
            if (item is not null)
            {
                CurrentItem = item;
                StateHasChanged();
            }
        }
        finally
        {
            isLoading = false;
        }
    }


}