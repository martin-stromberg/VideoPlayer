<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VideoWebPlayer.Maui.Components.MediaBannerPlayer"
             x:Name="ThisControl">
    
    <Border HeightRequest="200" 
            StrokeThickness="0" 
            BackgroundColor="{Binding DisplayBannerBackgroundColor}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>
        
        <Grid>
            <!-- Banner Image (verborgen wenn Video läuft) -->
            <Image x:Name="BannerImage"
                   Source="{Binding DisplayBannerSource}" 
                   Aspect="AspectFit" />
            
            <!-- Video Player (verborgen bis Play gedrückt) -->
            <mct:MediaElement x:Name="VideoPlayer"
                              IsVisible="False"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="True"
                              StateChanged="OnMediaStateChanged"
                              MediaFailed="OnMediaFailed" />
            
            <!-- Play Button (verborgen wenn Video läuft) -->
            <Border x:Name="PlayButton"
                    BackgroundColor="#FFB84D"
                    WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Opacity="0.9"
                    IsVisible="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="40" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="4,4"
                            Radius="8"
                            Opacity="0.5" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlayTapped" />
                </Border.GestureRecognizers>
                <Label Text="▶"
                       FontSize="40"
                       TextColor="#000000"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="5,0,0,0" />
            </Border>
            
            <!-- Fehlermeldung (unten im Banner) -->
            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   BackgroundColor="#D32F2F"
                   TextColor="White"
                   Padding="10"
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   VerticalOptions="End"
                   HorizontalOptions="Fill" />
        </Grid>
    </Border>
    
</ContentView>
