@using VideoWebPlayer.Data

@code {
    [Parameter]
    public List<FavoriteEntry> Favorites { get; set; } = new();

    [Parameter]
    public ApplicationDbContext DbContext { get; set; } = default!;

    private Dictionary<long, string> favTitles = new();
    private Dictionary<long, string> favImages = new();
    private Dictionary<long, string> favLinks = new();

    protected override async Task OnParametersSetAsync()
    {
        favTitles.Clear();
        favImages.Clear();
        favLinks.Clear();

        foreach (var fav in Favorites)
        {
            if (fav.MovieCollectionId != null)
            {
                var collection = await DbContext.MovieCollections.FindAsync(fav.MovieCollectionId);
                if (collection != null)
                {
                    favTitles[fav.Id] = collection.Name;
                    favImages[fav.Id] = collection.PosterPictureId.HasValue ? $"/api/pictures/{collection.PosterPictureId}" : "/images/placeholder.png";
                    favLinks[fav.Id] = $"/moviecollection/{collection.Id}";
                }
            }
            else if (fav.TVShowId != null)
            {
                var show = await DbContext.TVShows.FindAsync(fav.TVShowId);
                if (show != null)
                {
                    favTitles[fav.Id] = show.Name;
                    favImages[fav.Id] = show.PosterPictureId.HasValue ? $"/api/pictures/{show.PosterPictureId}" 
                        : show.BannerPictureId.HasValue ? $"/api/pictures/{show.BannerPictureId}"
                        : show.FanartPictureId.HasValue ? $"/api/pictures/{show.FanartPictureId}"
                        : "/images/placeholder.png";
                    favLinks[fav.Id] = $"/tvshow/{show.Id}";
                }
            }
            else if (fav.TVShowSeasonId != null)
            {
                var season = await DbContext.TVShowSeasons.FindAsync(fav.TVShowSeasonId);
                if (season != null)
                {
                    var show = await DbContext.TVShows.FindAsync(season.TVShowId);
                    favTitles[fav.Id] = $"{show.Name}-{season.Name}";
                    favImages[fav.Id] = season.PosterPictureId.HasValue ? $"/api/pictures/{season.PosterPictureId}" 
                        : season.FanartPictureId.HasValue ? $"/api/pictures/{season.FanartPictureId}"
                        : season.BannerPictureId.HasValue ? $"/api/pictures/{season.BannerPictureId}"
                        : show.PosterPictureId.HasValue ? $"/api/pictures/{show.PosterPictureId}"
                        : show.BannerPictureId.HasValue ? $"/api/pictures/{show.BannerPictureId}"
                        : show.FanartPictureId.HasValue ? $"/api/pictures/{show.FanartPictureId}"
                        : "/images/placeholder.png";
                    favLinks[fav.Id] = $"/tvshow/{season.TVShowId}?season={season.Id}";
                }
            }
            else if (fav.TVShowEpisodeId != null)
            {
                var episode = await DbContext.TVShowEpisodes.FindAsync(fav.TVShowEpisodeId);
                if (episode != null)
                {
                    var season = await DbContext.TVShowSeasons.FindAsync(episode.TVShowSeasonId);
                    var show = await DbContext.TVShows.FindAsync(season.TVShowId);
                    favTitles[fav.Id] = episode.Name;
                    favImages[fav.Id] = episode.PosterPictureId.HasValue ? $"/api/pictures/{episode.PosterPictureId}" 
                        : episode.FanartPictureId.HasValue ? $"/api/pictures/{episode.FanartPictureId}"
                        : episode.BannerPictureId.HasValue ? $"/api/pictures/{episode.BannerPictureId}"
                        : season.PosterPictureId.HasValue ? $"/api/pictures/{season.PosterPictureId}"
                        : season.FanartPictureId.HasValue ? $"/api/pictures/{season.FanartPictureId}"
                        : season.BannerPictureId.HasValue ? $"/api/pictures/{season.BannerPictureId}"
                        : show.PosterPictureId.HasValue ? $"/api/pictures/{show.PosterPictureId}"
                        : show.BannerPictureId.HasValue ? $"/api/pictures/{show.BannerPictureId}"
                        : show.FanartPictureId.HasValue ? $"/api/pictures/{show.FanartPictureId}"
                        : "/images/placeholder.png";
                    favLinks[fav.Id] = $"/tvshow/{season.TVShowId}?season={season.Id}&episode={episode.Id}"; 
                }
            }
            else if (fav.MovieId != null)
            {
                var movie = await DbContext.Movies.FindAsync(fav.MovieId);
                if (movie != null)
                {
                    favTitles[fav.Id] = movie.Name;
                    favImages[fav.Id] = movie.PosterPictureId.HasValue ? $"/api/pictures/{movie.PosterPictureId}" : "/images/placeholder.png";
                    favLinks[fav.Id] = $"/moviecollection/{movie.MovieCollectionId}?movie={movie.Id}";
                }
            }
        }
    }
}

@if (Favorites.Any())
{
    <h2>Favoriten</h2>
    <div class="recent-entries-list">
        @foreach (var fav in Favorites)
        {
            if (favTitles.ContainsKey(fav.Id))
            {
                <a class="media-box-link" href="@favLinks[fav.Id]">
                    <div class="recent-entry-box">
                        <img class="recent-entry-img" src="@favImages[fav.Id]" alt="@favTitles[fav.Id]" />
                        <div class="recent-entry-title">@favTitles[fav.Id]</div>
                    </div>
                </a>
            }
        }
    </div>
}